---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VvPageHeader from '../../components/global/VvPageHeader.astro';
import VvNewsListe from '../../components/global/VvNewsListe.astro';
import VvPagination from '../../components/global/VvPagination.astro';
import { getNews } from '../../lib/cms';

// Seite 1 der Beitragsliste. Ältere Beiträge sind über die Blätter-Navigation
// unter /neuigkeiten/seite/{n}/ erreichbar — vorher waren sie nur noch über
// Direktlinks auffindbar.
const PRO_SEITE = 30;
const alle = await getNews();
const seiten = Math.max(1, Math.ceil(alle.length / PRO_SEITE));
const news = alle.slice(0, PRO_SEITE);
---
<BaseLayout
  title="Neuigkeiten & Bekanntmachungen — Verwaltungsverband Wildenstein"
  description="Aktuelle Neuigkeiten, amtliche Bekanntmachungen, Sperrungen und Ausschreibungen des Verwaltungsverbands Wildenstein."
>
  <VvPageHeader
    title="Neuigkeiten & Bekanntmachungen"
    intro="Aktuelles aus dem Verwaltungsverband und den Gemeinden Grünhainichen und Börnichen/Erzgeb."
  />

  <div class="vv-newsindex">
    <div class="vv-container">
      <VvNewsListe news={news} />
      <VvPagination aktuell={1} gesamt={seiten} basis="/neuigkeiten" />
    </div>
  </div>
</BaseLayout>

<style>
  .vv-newsindex { padding-block: var(--vv-space-7) var(--vv-space-9); background: var(--vv-bg-alt); }
  .vv-newsindex .vv-container { max-width: 980px; }
</style>
