---
/**
 * Catch-all für alle Inhaltsseiten aus WordPress.
 *
 * Jede veröffentlichte WP-Seite wird beim Build an ihrem ORIGINAL-Pfad
 * generiert (URL-Parität mit vv-wildenstein.com → keine kaputten Links
 * beim Day-X-Umzug). Redaktion pflegt weiter im WP-Backend; jeder
 * Rebuild (Webhook/Zeitplan) übernimmt Änderungen automatisch.
 */
import '../styles/prose.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import VvPageHeader from '../components/global/VvPageHeader.astro';
import VvLightbox from '../components/global/VvLightbox.astro';
import VvHubGrid from '../components/global/VvHubGrid.astro';
import VvGremienListe from '../components/global/VvGremienListe.astro';
import VvGewerbeListe from '../components/global/VvGewerbeListe.astro';
import VvAemterListe from '../components/global/VvAemterListe.astro';
import VvRathauskarte from '../components/global/VvRathauskarte.astro';
import VvKontaktkarte from '../components/global/VvKontaktkarte.astro';
import VvSprungmenu from '../components/global/VvSprungmenu.astro';
import VvZeitenkarte from '../components/global/VvZeitenkarte.astro';
import {
  fetchWordPressPages,
  fetchWordPressCptPages,
  baueSprungmarken,
  fetchHubSources,
  type WPPageItem,
  type HubTile,
  fetchGremien,
  loeseBeitragslisten,
  beitragslisteFuerKuerzel,
  type HubSources,
} from '../lib/cms-wordpress';

export async function getStaticPaths() {
  // Hinweis: getStaticPaths läuft in Astro in einem ISOLIERTEN Scope —
  // Helfer müssen hier drin definiert sein (Frontmatter-Scope ist unsichtbar).

  /** Tourismus-Kategorie-Seiten → passende tourismus_kat-Terms. */
  const TOURISM_CAT_MAP: Record<string, string[]> = {
    gastronomie: ['gastronomie'],
    museum: ['museum'],
    unterkuenfte: ['unterkuenfte'],
    aktivitaeten: ['wandern', 'radfahren', 'baden', 'sehenswertes'],
  };

  /** Kacheln einer Hub-Seite aus den echten Daten auflösen. */
  function resolveHubTiles(
    pg: WPPageItem,
    childrenByParent: Map<number, WPPageItem[]>,
    hub: HubSources,
    byId: Map<number, WPPageItem>,
  ): HubTile[] {
    const p = pg.path;
    // Tourismus-Übersicht = alle Einträge; Kategorie-Seiten = gefiltert
    if (p === '/tourismus_uebersicht') return hub.tourismus;
    if (p.startsWith('/tourismus_uebersicht/')) {
      const cat = p.split('/').pop() ?? '';
      const kats = TOURISM_CAT_MAP[cat];
      // Ohne Kategorie-Zuordnung (z. B. „Sehenswürdigkeiten") unten weiter
      // zum Grid-Fallback, statt die Seite leer zu lassen.
      if (kats) return hub.tourismus.filter((t) => t.kats?.some((k) => kats.includes(k)));
    }
    // CPT-Index-Hubs
    if (p === '/verwaltung') return hub.amter;
    if (p === '/wirtschaft') return hub.profile;
    // Sektions-Hubs → echte WP-Kind-Seiten als Kacheln (nach Titel dedupliziert)
    const kids = childrenByParent.get(pg.id) ?? [];
    const seen = new Set<string>();
    const kidTiles = kids
      .filter((k) => {
        const key = k.title.toLowerCase();
        if (seen.has(key)) return false;
        seen.add(key);
        return true;
      })
      .map((k) => ({ title: k.title, href: k.path, kontakt: k.kontakt, image: k.image }));
    if (kidTiles.length > 0) return kidTiles;
    // Kein Mapping und keine Kind-Seiten → das nehmen, was im entfernten Grid
    // stand (Vereine, Dienstleister, Kirchen … je nach Seite). Kacheln ohne
    // eigenen Link (Impreza verlinkte dort nur die Taxonomie) über die
    // WP-ID auf die generierte Detailseite auflösen.
    const ausGrid = (pg.gridTiles ?? [])
      .map((t) => {
        if (t.href) return t;
        const ziel = t.sourceId ? byId.get(t.sourceId) : undefined;
        return ziel ? { ...t, href: ziel.path, image: t.image ?? ziel.image } : null;
      })
      .filter((t): t is HubTile => t !== null);
    if (ausGrid.length > 0) return ausGrid.map(reichereAn);

    /* Letzter Rückgriff: Seiten, die im Redaktionssystem leer sind, deren
       Kürzel aber einer Gewerbekategorie entspricht. Genau so arbeitete die
       alte Seite — ihr Menü zeigte für „Einkaufen" nicht auf die (leere)
       Seite, sondern auf das Kategorie-Archiv /profilkategorie/einkaufen/.
       Betrifft /leben-freizeit/einkaufen (20 Betriebe) und
       /leben-freizeit/kindergarten (5 Einrichtungen). */
    const kuerzelKat = pg.path.split('/').pop() ?? '';
    return hub.profile.filter((t) => t.kats?.includes(kuerzelKat));
  }

  function pickHubIcon(path: string): string {
    if (path.startsWith('/verwaltung')) return 'building';
    if (path.startsWith('/tourismus')) return 'mountain';
    if (path.startsWith('/leben-freizeit')) return 'users';
    if (path.startsWith('/wirtschaft')) return 'building';
    if (path.startsWith('/projekte')) return 'file-text';
    return 'arrow-up-right';
  }

  // Seiten + Custom Post Types (Ämter, Tourismus, Vereine, Profile) + Hub-Quellen
  const [pages, cpts, hub] = await Promise.all([
    fetchWordPressPages(),
    fetchWordPressCptPages(),
    fetchHubSources(),
  ]);
  // Kind-Seiten je Eltern-ID (nur echte WP-Seiten haben eine Hierarchie)
  const childrenByParent = new Map<number, WPPageItem[]>();
  for (const pg of pages) {
    if (!pg.parentId) continue;
    const list = childrenByParent.get(pg.parentId) ?? [];
    list.push(pg);
    childrenByParent.set(pg.parentId, list);
  }
  // Landkarte WP-ID → generierte Seite (löst Grid-Kacheln ohne eigenen Link auf)
  const byId = new Map<number, WPPageItem>();
  for (const pg of [...pages, ...cpts]) byId.set(pg.id, pg);

  /* Kacheln aus einem entfernten Portalgitter tragen nur Titel und Ziel. Die
     Anschrift steht aber in der Zielseite — die alte Seite zeigte sie in
     jeder Kachel mit. Ohne das bestand /leben-freizeit/freibad aus dem Wort
     „Freibad" und sonst nichts. */
  const nachPfad = new Map<string, WPPageItem>();
  for (const pg of [...pages, ...cpts]) nachPfad.set(pg.path, pg);

  function reichereAn(t: HubTile): HubTile {
    if (t.kontakt && t.image) return t;
    const ziel = nachPfad.get(t.href.replace(/\/$/, ''));
    if (!ziel) return t;
    return { ...t, kontakt: t.kontakt ?? ziel.kontakt, image: t.image ?? ziel.image };
  }
  // Reservierte Pfade (eigene Routen) nicht überschreiben; Duplikate (Seite
  // vs. CPT mit gleichem Pfad) überspringen → sonst bricht der Build hart ab.
  // Eigene Routen: Amtsblatt-Archiv und Downloads holen ihre Daten aus den
  // vvw/v1-Endpoints (der Download-Manager ist über wp/v2 nicht erreichbar).
  const RESERVED = new Set(['neuigkeiten', 'veranstaltungen', 'amtsblatt', 'downloads', '404']);

  /* Nur Text zaehlt hier noch nicht — ob eine Seite leer ist, entscheidet sich
     erst, wenn feststeht, ob sie Kacheln bekommt. Deshalb unten in zwei
     Durchgaengen. */
  function textLeer(pg: WPPageItem): boolean {
    const text = pg.contentHtml.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
    return text.length < 40 && !pg.kontakt && !pg.gallery?.length;
  }

  const seen = new Set<string>();
  const routes = [];
  for (const page of [...pages, ...cpts]) {
    const slug = page.path.replace(/^\//, '').replace(/\/$/, '');
    if (!slug || RESERVED.has(slug.split('/')[0]) || seen.has(slug)) continue;
    seen.add(slug);
    /* Native Kacheln, wo ein Impreza-Portalgitter entfernt wurde — oder wo das
       Seitenkürzel einer Gewerbekategorie entspricht. Letzteres rettet Seiten,
       die im Redaktionssystem leer sind: /leben-freizeit/einkaufen und
       /leben-freizeit/kindergarten hatten nie ein Gitter, die alte Seite
       verwies für sie auf das Kategorie-Archiv. */
    const kuerzel = page.path.split('/').pop() ?? '';
    const passtZurKategorie = hub.profile.some((t) => t.kats?.includes(kuerzel));
    /* Leere Elternseiten zeigen ihre Unterseiten — /informationen stand sonst
       als Sackgasse da, obwohl drei Unterseiten daran haengen. */
    const leerMitKindern = textLeer(page) && (childrenByParent.get(page.id)?.length ?? 0) > 0;
    const hubTiles =
      page.hadHubGrid || passtZurKategorie || leerMitKindern
        ? resolveHubTiles(page, childrenByParent, hub, byId)
        : [];
    routes.push({
      params: { slug },
      props: { page, hubTiles, hubIcon: pickHubIcon(page.path) },
    });
  }

  /* Zweiter Durchgang: Jetzt steht fest, welche Seiten wirklich nichts zeigen.
     Kacheln, die dorthin verweisen, sind Sackgassen und fliegen raus — auf
     /leben-freizeit fuehrte „Wohnen" ins Nichts, auf /profile eine
     Kirchgemeinde ohne jede Angabe. */
  const leerePfade = new Set(
    routes
      .filter((r) => r.props.hubTiles.length === 0 && textLeer(r.props.page))
      .map((r) => r.props.page.path),
  );
  for (const r of routes) {
    r.props.hubTiles = r.props.hubTiles.filter(
      (t: HubTile) => !leerePfade.has(t.href.replace(/\/$/, '')),
    );
  }
  return routes;
}

const { page, hubTiles, hubIcon: tileIcon } = Astro.props;

// Manche alten Seiten waren reine Impreza-Portalgitter oder Redirect-Stubs —
// nach dem Aufräumen bleibt kein Inhalt. Statt einer leeren Seite ein
// freundlicher Hinweis mit Weg zurück in die Sektion.
/* Beitragslisten-Kurzcodes aufloesen, bevor der Inhalt irgendwo verwendet
   wird — sonst stuende [dt_blog_posts_small category=„…"] als Text auf der
   Seite. Betrifft /stellenausschreibungen, /vergabeausschreibungen und
   /ortsteil-gruenhainichen. */
let inhaltHtml = await loeseBeitragslisten(page.contentHtml);

/* Ist danach immer noch nichts da, das Kürzel aber der Name einer
   Beitragskategorie: deren Beiträge zeigen. Rettet /stellenanzeigen, das im
   Redaktionssystem leer ist — auch auf der alten Seite stand dort nur die
   Überschrift, obwohl die Kategorie Beiträge hat. */
if (
  hubTiles.length === 0 &&
  inhaltHtml.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim().length < 40
) {
  const ausKategorie = await beitragslisteFuerKuerzel(page.path.split('/').pop() ?? '');
  if (ausKategorie) inhaltHtml = ausKategorie;
}

const contentText = inhaltHtml.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();

// Themen-Menü für lange Seiten: Überschriften bekommen Sprungmarken, die
// Liste steht über dem Text. Lohnt sich erst ab einer gewissen Länge —
// bei drei Absätzen wäre es nur Beiwerk.
const { html: inhaltMitMarken, marken } = baueSprungmarken(inhaltHtml);
const zeigeSprungmenu = marken.length >= 4 && contentText.length > 2500;

// Auf der Verwaltungsseite steht neben der Ämterliste der Rathaus-Kasten:
// Öffnungszeiten und Hinweise standen bisher als Fließtext UNTER allen
// 14 Ämtern, wo sie niemand sucht.
/* Die Verbandsversammlungs-Seite zeigte 38 Bild-Kacheln mit leerer Bildfläche,
   deren Verweise ausnahmslos ins Leere liefen (/personen/… wird hier nicht
   gebaut), und alle vier Abschnitte der Seite waren zu einem Haufen
   verschmolzen. Die Namen kommen jetzt als Liste aus den echten Daten; was im
   Gitter sonst noch stand — die Bekanntmachungen —, bleibt als Kacheln. */
const istVersammlung = page.path === '/verband/verbandsversammlung';
const gremien = istVersammlung ? await fetchGremien() : [];
const restKacheln = istVersammlung
  ? hubTiles.filter((t) => !t.href.startsWith('/personen/'))
  : hubTiles;

/* Seiten mit einer Bildergalerie bekommen ein Foto in den Seitenkopf statt
   des blauen Bandes mit Höhenlinien. Auf /heiraten wirkte die Seite sonst so
   behördlich wie eine Gebührensatzung — die Fotos sind dort der eigentliche
   Inhalt. Genommen wird das erste QUERFORMAT der Galerie: ein Hochformat
   waere in einem breiten Band fast nur Ausschnitt.
   Das Bild kommt aus dem Inhalt, nicht aus dem Quelltext — tauscht die
   Redaktion die Fotos, wandert der Seitenkopf mit. */
const kopfBild = (() => {
  const kandidaten = [...inhaltHtml.matchAll(/<img\b[^>]*class="[^"]*vv-gal-img[^"]*"[^>]*>/gi)]
    .map((m) => {
      const tag = m[0];
      return {
        src: tag.match(/\bsrc="([^"]+)"/i)?.[1] ?? '',
        breite: Number(tag.match(/\bwidth="(\d+)"/i)?.[1] ?? 0),
        hoehe: Number(tag.match(/\bheight="(\d+)"/i)?.[1] ?? 0),
      };
    })
    .filter((k) => k.src && k.breite > k.hoehe);
  if (kandidaten.length === 0) return undefined;
  /* Das breiteste Motiv gewinnt: In einem flachen Band wird es am wenigsten
     beschnitten. Auf /heiraten trifft das die Kutsche auf der Wiese (1,83:1)
     statt des Trausaals (1,33:1) — der stand als erstes Galeriebild ohnehin
     gleich darunter noch einmal. */
  return kandidaten.sort((a, b) => b.breite / b.hoehe - a.breite / a.hoehe)[0].src;
})();

const istWirtschaft = page.path === '/wirtschaft';
const istVerwaltung = page.path === '/verwaltung';
const zeigeRathaus = istVerwaltung && contentText.length > 40;
const isEmpty =
  hubTiles.length === 0 && contentText.length < 40 && !page.kontakt && !page.gallery?.length;

/* Bleibt nach dem Entfernen der Impreza-Portalgitter nur noch die Reihe der
   Abschnitts-Überschriften übrig, hat der Textteil nichts mehr zu sagen — die
   Überschriften stehen dann doppelt, einmal verwaist am Seitenende und einmal
   über der Liste, die an die Stelle des Gitters getreten ist. Genau so sah es
   auf /verband/verbandsversammlung aus: vier h6 ohne einen Satz dazwischen. */
const textOhneUeberschriften = inhaltHtml
  .replace(/<h[1-6]\b[^>]*>[\s\S]*?<\/h[1-6]>/gi, '')
  .replace(/<[^>]*>/g, ' ')
  .replace(/\s+/g, ' ')
  .trim();
const nurUeberschriften =
  (hubTiles.length > 0 || gremien.length > 0) &&
  contentText.length > 0 &&
  textOhneUeberschriften.length < 40;
/* Kurzbeschreibung fuer Suchmaschinen und Vorschauen. Bisher stand hier nur
   der Seitentitel — bei 170 Seiten waren das unter 20 Zeichen, also nichts
   Brauchbares. Jetzt der Anfang des Inhalts, sonst die Anschrift aus den
   Kontaktdaten, sonst ein Satz aus dem Titel. */
const beschreibung = (() => {
  const ausText = contentText.replace(/\s+/g, ' ').trim();
  if (ausText.length >= 60) {
    const kurz = ausText.slice(0, 155);
    return (kurz.length < ausText.length ? kurz.replace(/\s+\S*$/, '') + ' …' : kurz);
  }
  const k = page.kontakt;
  const ort = [k?.strasse_hausnummer, k?.plz_ort].filter(Boolean).join(', ');
  if (ort) return `${page.title} — ${ort}. Verwaltungsverband Wildenstein.`;
  return `${page.title} beim Verwaltungsverband Wildenstein — Grünhainichen und Börnichen/Erzgeb.`;
})();

const parentPath = page.breadcrumb.length ? page.breadcrumb[page.breadcrumb.length - 1].path : '/';
const parentTitle = page.breadcrumb.length ? page.breadcrumb[page.breadcrumb.length - 1].title : 'Startseite';
---
<BaseLayout title={`${page.title} — Verwaltungsverband Wildenstein`} description={beschreibung}>
  <VvPageHeader title={page.title} breadcrumb={page.breadcrumb} bild={kopfBild} />
  <div class="vv-pagebody">
    <div class="vv-container">
      {page.image && (
        <img
            class:list={['vv-pagebody__lead', { 'is-breit': page.imageBreit }]}
            src={page.image}
            alt=""
            loading="lazy"
            decoding="async"
          />
      )}
      <div class:list={['vv-layout', { 'has-seitenleiste': zeigeSprungmenu || zeigeRathaus }]}>
        {zeigeRathaus ? (
          <aside class="vv-seitenleiste">
            <VvRathauskarte html={inhaltHtml} />
          </aside>
        ) : zeigeSprungmenu ? (
          <aside class="vv-seitenleiste">
            {/* Das Themen-Menü steht zuunterst, weil es beim Scrollen andockt:
                Ein angedocktes Element bleibt an seiner Stelle im Fluss und
                schiebt sich optisch über alles, was darunter folgt — die
                Sprechzeiten wurden dadurch verdeckt. Als letztes Element kann
                das nicht mehr passieren. */}
            {page.kontakt && <VvKontaktkarte kontakt={page.kontakt} ohneBloecke />}
            {page.kontakt && <VvZeitenkarte kontakt={page.kontakt} />}
            <VvSprungmenu marken={marken} />
          </aside>
        ) : (
          page.kontakt && <VvKontaktkarte kontakt={page.kontakt} />
        )}

        <div class="vv-layout__inhalt">
          {istVersammlung && gremien.length > 0 && <VvGremienListe gremien={gremien} />}
          {restKacheln.length > 0 && (
            istVerwaltung
              ? <VvAemterListe tiles={restKacheln} />
              : istWirtschaft
                ? <VvGewerbeListe tiles={restKacheln} />
                : <VvHubGrid tiles={restKacheln} icon={tileIcon} titel={istVersammlung ? 'Bekanntmachungen' : undefined} />
          )}
          {isEmpty ? (
            <div class="vv-emptyhub">
              <p>Für diese Seite liegen derzeit keine eigenen Inhalte vor.</p>
              <a class="vv-emptyhub__link" href={parentPath}>← Zurück zu {parentTitle}</a>
            </div>
          ) : zeigeRathaus || nurUeberschriften ? null : (
            <article class:list={['vv-prose', { 'is-bildseite': kopfBild }]} set:html={zeigeSprungmenu ? inhaltMitMarken : inhaltHtml} />
          )}
        </div>
      </div>
      {page.gallery && page.gallery.length > 0 && (
        <section class="vv-gallery" aria-label="Bildergalerie">
          {page.gallery.map((img) => (
            <figure class="vv-gal-item">
              <img class="vv-gal-img" src={img.full} alt={img.alt} loading="lazy" decoding="async" />
            </figure>
          ))}
        </section>
      )}
    </div>
  </div>
  <VvLightbox />
</BaseLayout>

<style>
  /* Lange Seiten bekommen eine Seitenleiste: Kontakt und Themen-Menü stehen
     links und laufen beim Scrollen mit, der Text nutzt die restliche Breite.
     Vorher standen beide Kästen obenauf und der Text lief darunter über die
     volle Spaltenbreite — unruhig zu lesen und das Menü war nach dem ersten
     Scrollen weg. */
  .vv-layout { display: grid; gap: var(--vv-space-6); }
  .vv-layout__inhalt { min-width: 0; }   /* verhindert Überlaufen breiter Tabellen */

  @media (min-width: 1000px) {
    /* Text links, Seitenleiste rechts — der Blick beginnt beim Inhalt. */
    .vv-layout.has-seitenleiste {
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: var(--vv-space-7);
      /* KEIN align-items: start — das schrumpfte die Seitenleiste auf ihre
         Inhaltshöhe. Ein angedocktes Element klebt aber nur innerhalb seines
         Elternelements: Bei 1.200px Leiste und 27.000px Text hörte das Menü
         nach einem Zwanzigstel der Seite auf mitzulaufen. Die Leiste muss so
         hoch sein wie die Textspalte, damit das Menü durchgehend klebt. */
    }
    .vv-layout.has-seitenleiste .vv-layout__inhalt { order: 1; }
    .vv-seitenleiste {
      order: 2;
      display: grid;
      gap: var(--vv-space-4);
      align-content: start;
    }
    .vv-seitenleiste > :global(.vv-kontakt),
    .vv-seitenleiste > :global(.vv-zeiten) { margin: 0; }

    /* Der Rathaus-Kasten läuft mit: Die Ämterliste ist knapp 2.800px lang,
       ohne Andocken wären die Öffnungszeiten nach dem dritten Amt weg. */
    .vv-seitenleiste > :global(.vv-rathaus) {
      position: sticky;
      top: 84px;
      max-height: calc(100vh - 108px);
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
    }

    /* Nur das Themen-Menü läuft mit. Kontakt und Sprechzeiten scrollen weg —
       so muss man nicht INNERHALB der Leiste scrollen, was verwirrend war.
       Die Höhenbegrenzung greift erst, wenn das Menü wirklich höher ist als
       das Fenster (z. B. bei 39 Themen auf der Veranstaltungsseite). */
    .vv-seitenleiste > :global(.vv-sprung) {
      position: sticky;
      top: 84px;
      margin: 0;
      max-height: calc(100vh - 108px);
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
    }
  }
  /* Schmale Schirme: alles untereinander, Kontakt zuerst */
  @media (max-width: 999px) {
    .vv-seitenleiste { display: grid; gap: var(--vv-space-4); }
    .vv-seitenleiste > :global(.vv-kontakt),
    .vv-seitenleiste > :global(.vv-sprung) { margin: 0; }
  }
  /* Angesprungene Überschrift nicht unter dem festen Kopf verstecken */
  .vv-prose :global(h2[id]) { scroll-margin-top: 90px; }
  .vv-pagebody {
    padding-block: var(--vv-space-7) var(--vv-space-9);
    background: var(--vv-white);
  }
  /* Einheitliche Spurbreite auf allen Unterseiten — vorher waren Seiten mit
     Seitenleiste 1240px breit und alle anderen 980px, was beim Blättern
     zwischen den Seiten sichtbar sprang. */
  .vv-pagebody .vv-container { max-width: 1240px; }
  /* Der Fließtext bleibt trotzdem lesbar: lange Zeilen ermüden, deshalb wird
     die Textspalte begrenzt — dieselbe Breite, die sie neben der Seitenleiste
     hat. */
  .vv-layout:not(.has-seitenleiste) .vv-prose,
  .vv-layout:not(.has-seitenleiste) .vv-emptyhub { max-width: 830px; }
  /* Auch der Kontaktkasten: ohne Seitenleiste zöge er sich sonst über die
     vollen 1240px und wirkte wie ein Banner. */
  .vv-layout:not(.has-seitenleiste) > :global(.vv-kontakt) { max-width: 830px; }
  .vv-pagebody__lead {
    width: 100%;
    max-height: 380px;
    object-fit: cover;
    border-radius: var(--vv-radius-lg);
    margin: 0 0 var(--vv-space-5);
  }
  /* Breite Banner (Firmenlogos) nicht ueber die volle Breite ziehen und
     beschneiden — klein und mittig, wie ein Briefkopf. */
  .vv-pagebody__lead.is-breit {
    display: block;
    width: auto;
    max-width: min(100%, 460px);
    max-height: 140px;
    object-fit: contain;
    margin: 0 auto var(--vv-space-6);
    border-radius: 0;
  }
  /* Zusatzbilder („Erweiterte Einstellungen" im Backend) als Raster */
  .vv-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(200px, 100%), 1fr));
