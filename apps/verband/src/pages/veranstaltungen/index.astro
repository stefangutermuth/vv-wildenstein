---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VvPageHeader from '../../components/global/VvPageHeader.astro';
import VvIcon from '../../components/primitives/VvIcon.astro';
import { getEvents } from '../../lib/cms';

const events = await getEvents();

// Feste Zeitzone — sonst zeigt der UTC-CI-Build bei Mitternachts-/Ganztages-
// Events den Vortag im Datums-Badge. vw-events liefert offset-behaftete Zeiten.
const TZ = 'Europe/Berlin';
const fmtDay = new Intl.DateTimeFormat('de-DE', { day: '2-digit', timeZone: TZ });
const fmtMonth = new Intl.DateTimeFormat('de-DE', { month: 'short', timeZone: TZ });
const fmtFull = new Intl.DateTimeFormat('de-DE', { weekday: 'long', day: '2-digit', month: 'long', year: 'numeric', timeZone: TZ });
---
<BaseLayout
  title="Veranstaltungen — Verwaltungsverband Wildenstein"
  description="Veranstaltungen und Termine in den Gemeinden Grünhainichen und Börnichen/Erzgeb."
>
  <VvPageHeader
    title="Veranstaltungen"
    intro="Feste, Kultur und Termine aus den Gemeinden des Verwaltungsverbands — gepflegt von den Vereinen und der Verwaltung."
  />

  <div class="vv-events">
    <div class="vv-container">
      {events.length === 0 && <p class="vv-events__empty">Aktuell sind keine kommenden Veranstaltungen eingetragen.</p>}
      <ul class="vv-events__list">
        {events.map((e) => (
          <li>
            <a href={e.href} class="vv-events__item" target={e.href.startsWith('http') ? '_blank' : undefined} rel={e.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
              <span class="vv-events__date" aria-hidden="true">
                <strong>{fmtDay.format(e.startDate)}</strong>
                <span>{fmtMonth.format(e.startDate)}</span>
              </span>
              <span class="vv-events__body">
                <span class="vv-events__title">{e.title}</span>
                <span class="vv-events__meta">
                  <VvIcon name="calendar" size={13} /> {fmtFull.format(e.startDate)}
                  {e.location && <><span class="vv-events__dot">·</span><VvIcon name="map-pin" size={13} /> {e.location}</>}
                </span>
                {e.teaser && <span class="vv-events__teaser">{e.teaser}</span>}
              </span>
              <VvIcon name="arrow-right" size={17} class="vv-events__arrow" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</BaseLayout>

<style>
  .vv-events { padding-block: var(--vv-space-7) var(--vv-space-9); background: var(--vv-bg-alt); }
  .vv-events .vv-container { max-width: 980px; }
  .vv-events__empty { color: var(--vv-text-muted); font-style: italic; }
  .vv-events__list { display: flex; flex-direction: column; gap: var(--vv-space-3); }

  .vv-events__item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--vv-space-5);
    align-items: center;
    padding: var(--vv-space-4) var(--vv-space-5);
    background: var(--vv-white);
    border: 1px solid var(--vv-border-soft);
    border-radius: var(--vv-radius-md);
    box-shadow: var(--vv-shadow-sm);
    color: inherit;
    transition: transform var(--vv-dur-fast), box-shadow var(--vv-dur-fast), border-color var(--vv-dur-fast);
  }
  .vv-events__item:hover { transform: translateY(-2px); border-color: var(--vv-sky-400); box-shadow: var(--vv-shadow-md); }

  .vv-events__date {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    width: 64px; height: 64px; flex-shrink: 0;
    background: var(--vv-navy-800); color: var(--vv-white);
    border-radius: var(--vv-radius-md);
    line-height: 1.05;
  }
  .vv-events__date strong { font-size: var(--vv-fs-xl); font-weight: 700; }
  .vv-events__date span { font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--vv-sky-200); }

  .vv-events__body { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .vv-events__title { font-weight: 700; color: var(--vv-navy-800); font-size: var(--vv-fs-md); line-height: 1.3; }
  .vv-events__meta {
    display: inline-flex; align-items: center; flex-wrap: wrap; gap: 6px;
    font-size: var(--vv-fs-sm); color: var(--vv-gray-700);
  }
  .vv-events__meta :global(svg) { color: var(--vv-green-600); flex-shrink: 0; }
  .vv-events__dot { color: var(--vv-gray-400); margin-inline: 2px; }
  .vv-events__teaser { font-size: var(--vv-fs-sm); color: var(--vv-gray-700); line-height: 1.5; }

  .vv-events__item :global(.vv-events__arrow) { color: var(--vv-gray-400); transition: transform var(--vv-dur-fast), color var(--vv-dur-fast); }
  .vv-events__item:hover :global(.vv-events__arrow) { color: var(--vv-green-600); transform: translateX(3px); }
</style>
