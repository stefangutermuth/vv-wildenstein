---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VvPageHeader from '../../components/global/VvPageHeader.astro';
import VvCptUebersicht from '../../components/global/VvCptUebersicht.astro';
import { fetchWordPressCptPages } from '../../lib/cms-wordpress';

// Basispfad des Inhaltstyps: lieferte vorher einen Server-Fehler, weil es
// nur Detailseiten gab. Jetzt eine vollständige Übersicht.
const alle = await fetchWordPressCptPages();
/* Eintraege ohne jede Angabe ueberspringen: Sie fuehren auf eine Seite, die
   nur „Für diese Seite liegen derzeit keine eigenen Inhalte vor" zeigt. */
const eintraege = alle
  .filter((p) => p.path.startsWith('/tourismus/'))
  .filter(
    (p) =>
      p.kontakt ||
      p.gallery?.length ||
      p.image ||
      p.contentHtml.replace(/<[^>]*>/g, ' ').trim().length >= 40,
  );
---
<BaseLayout
  title="Tourismus in der Region — Verwaltungsverband Wildenstein"
  description="Unterkünfte, Gastronomie, Museen und Ausflugsziele im Verwaltungsverband Wildenstein."
>
  <VvPageHeader title="Tourismus in der Region" intro="Unterkünfte, Gastronomie, Museen und Ausflugsziele im Verwaltungsverband Wildenstein." />
  <div class="vv-cptidx">
    <div class="vv-container">
      <p class="vv-cptidx__anzahl">{eintraege.length} Einträge</p>
      <VvCptUebersicht eintraege={eintraege} alphabetisch={true} />
    </div>
  </div>
</BaseLayout>

<style>
  .vv-cptidx { padding-block: var(--vv-space-7) var(--vv-space-9); background: var(--vv-bg-alt); }
  .vv-cptidx .vv-container { max-width: 900px; }
  .vv-cptidx__anzahl {
    margin: 0 0 var(--vv-space-5);
    color: var(--vv-text-muted);
    font-size: var(--vv-fs-sm);
  }
</style>
