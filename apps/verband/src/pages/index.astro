---
import BaseLayout from '../layouts/BaseLayout.astro';
import VvHero from '../components/hero/VvHero.astro';
import VvSection from '../components/sections/VvSection.astro';
import VvButton from '../components/primitives/VvButton.astro';
import VvIcon from '../components/primitives/VvIcon.astro';
import { getNews } from '../lib/cms';

const newsAll = await getNews();
const sperrungen = newsAll.filter((n) => n.category === 'sperrung').slice(0, 3);
const news = newsAll.filter((n) => n.category !== 'sperrung');
const featured = news.find((n) => n.featured) ?? news[0];
const newsRest = news.filter((n) => n.slug !== featured?.slug).slice(0, 4);

const categoryLabel: Record<string, string> = {
  bekanntmachung: 'Bekanntmachung',
  veranstaltung:  'Veranstaltung',
  sperrung:       'Sperrung',
  ausschreibung:  'Ausschreibung',
};
const severityLabel: Record<string, string> = {
  info:  'Hinweis',
  warn:  'Einschränkung',
  alert: 'Vollsperrung',
};
const fmtDate = new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' });
const fmtUntil = new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: 'long' });

// Hero: Glas-Boxen (obere Reihe) — Ziele = echte WP-Seitenpfade
const heroBoxes = [
  { icon: 'megaphone',      label: 'Neuigkeiten',    sub: 'Bekanntmachungen',       href: '/neuigkeiten' },
  { icon: 'alert-triangle', label: 'Sperrungen',     sub: 'Verkehr aktuell',        href: '/sperrungen' },
  { icon: 'vote',           label: 'Wahlen',         sub: 'Termine & Informationen', href: '/wahlen' },
  { icon: 'waves',          label: 'Freibad',        sub: 'Saison & Öffnungszeiten', href: '/leben-freizeit/freibad', live: true },
  { icon: 'mountain',       label: 'EURORANDO 2026', sub: 'Wanderfest im September', href: '/veranstaltungen' },
];

// Hero: Glas-Chips (untere Reihe = die „Buttons", bleiben inhaltlich)
const heroChips = [
  { icon: 'building',  label: 'Ämter',            sub: 'Verwaltung & Kontakt',   href: '/verwaltung' },
  { icon: 'calendar',  label: 'Veranstaltungen',  sub: 'Termine der Region',     href: '/veranstaltungen' },
  { icon: 'gift',      label: 'Verbandsgutschein', sub: 'einlösen & verschenken', href: '/gutschein' },
  { icon: 'file-text', label: 'Downloads',        sub: 'Anträge & Formulare',    href: '/downloads' },
  { icon: 'map-pin',   label: 'Mängel-Melder',    sub: 'Schaden melden',         href: 'https://melder.vv-wildenstein.com', external: true },
];

// Ämter-Übersicht (Kern der Verbandsseite) — echte CPT-Pfade aus WordPress
const aemter = [
  { label: 'Sekretariat', href: '/amter/sekretariat' },
  { label: 'Hauptamt', href: '/amter/hauptamt' },
  { label: 'Bauamt / Liegenschaften', href: '/amter/bauamt-liegenschaften' },
  { label: 'Einwohnermeldeamt / Passwesen', href: '/amter/einwohnermeldeamt-passwesen' },
  { label: 'Standesamt', href: '/amter/standesamt' },
  { label: 'Ordnungsamt / Prävention', href: '/amter/ordnungsamt-kommunale-praevention' },
  { label: 'Finanzverwaltung', href: '/amter/finanzverwaltung' },
  { label: 'Fördermittelstelle', href: '/amter/foerdermittelstelle' },
  { label: 'Gewerbeamt', href: '/amter/gewerbeamt' },
  { label: 'Soziales', href: '/amter/soziales' },
  { label: 'Personalamt / FFW', href: '/amter/personalamt-ffw' },
  { label: 'Kultur / Tourismus', href: '/amter/kultur-tourismus' },
];

// Highlight-Kacheln (wie im Original — hohe Bild-Kacheln auf Topo-Muster)
const highlights = [
  { label: 'Grundschul-Neubau — Einzug am 01.11.2022', href: '/grundschul-neubau', image: '/images/highlights/grundschul.jpg' },
  { label: 'Mängel-Melder', href: 'https://melder.vv-wildenstein.com', image: '/images/highlights/maengelmelder.jpg', external: true },
  { label: 'Heiraten',      href: '/heiraten', image: '/images/highlights/heiraten.jpg' },
  { label: 'Amtsblatt',     href: '/amtsblatt', image: '/images/highlights/amtsblatt.jpg' },
];
---
<BaseLayout>
  <VvHero
    image="/images/hero/verband-hero.jpg"
    imageAlt="Landschaft im Verbandsgebiet Wildenstein"
    boxes={heroBoxes}
    chips={heroChips}
  />

  {/* === Aktuelles + Sperrungen ======================================= */}
  <VvSection id="aktuelles" tone="alt" eyebrow="Aktuelles" title="Neuigkeiten & Bekanntmachungen">
    <div class="vv-news">
      <div class="vv-news__main">
        {featured && (
          <a href={featured.href} class="vv-news__feature vv-reveal">
            <span class="vv-news__feature-media" data-cat={featured.category}>
              {featured.image
                ? <img src={featured.image} alt={featured.title} loading="lazy" decoding="async" />
                : <span class="vv-news__fallback" aria-hidden="true"></span>}
              <span class="vv-news__badge">{categoryLabel[featured.category]}</span>
            </span>
            <span class="vv-news__feature-body">
              <time class="vv-news__date">{fmtDate.format(featured.date)}</time>
              <h3 class="vv-news__feature-title">{featured.title}</h3>
              <p class="vv-news__feature-excerpt">{featured.excerpt}</p>
              <span class="vv-news__more">Weiterlesen <VvIcon name="arrow-right" size={15} /></span>
            </span>
          </a>
        )}

        {newsRest.length > 0 && (
          <ul class="vv-news__list vv-reveal">
            {newsRest.map((n) => (
              <li>
                <a href={n.href} class="vv-news__item">
                  <span class="vv-news__item-media" data-cat={n.category}>
                    {n.image
                      ? <img src={n.image} alt={n.title} loading="lazy" decoding="async" />
                      : <span class="vv-news__fallback" aria-hidden="true"></span>}
                  </span>
                  <span class="vv-news__item-body">
                    <span class="vv-news__item-meta">
                      <span class="vv-news__cat">{categoryLabel[n.category]}</span>
                      <time>{fmtDate.format(n.date)}</time>
                    </span>
                    <span class="vv-news__item-title">{n.title}</span>
                  </span>
                  <VvIcon name="arrow-right" size={16} class="vv-news__item-arrow" />
                </a>
              </li>
            ))}
          </ul>
        )}

        <VvButton href="/neuigkeiten" variant="light" size="sm" icon="arrow-right">Alle Neuigkeiten</VvButton>
      </div>

      <aside class="vv-news__aside vv-reveal">
        <header class="vv-news__aside-head">
          <span class="vv-eyebrow vv-news__aside-eyebrow"><VvIcon name="alert-triangle" size={13} /> Verkehr & Sperrungen</span>
          <h3>Aktuell unterwegs</h3>
        </header>
        {sperrungen.length > 0 ? (
          <ul class="vv-alert-list">
            {sperrungen.map((s) => (
              <li class={`vv-alert vv-alert--${s.severity ?? 'info'}`}>
                <a href={s.href}>
                  <span class="vv-alert__dot" aria-hidden="true"></span>
                  <span class="vv-alert__body">
                    <span class="vv-alert__tag">{severityLabel[s.severity ?? 'info']}</span>
                    <span class="vv-alert__title">{s.title}</span>
                    {s.affectedStreet && (
                      <span class="vv-alert__meta"><VvIcon name="map-pin" size={12} /> {s.affectedStreet}</span>
                    )}
                    {s.validUntil && (
                      <span class="vv-alert__until"><VvIcon name="clock" size={12} /> gültig bis {fmtUntil.format(s.validUntil)}</span>
                    )}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="vv-alert-empty">Aktuell keine Sperrungen gemeldet.</p>
        )}
        <a href="/sperrungen" class="vv-news__aside-more">Alle Verkehrsmeldungen <VvIcon name="arrow-right" size={13} /></a>

        <div class="vv-news__contactbox">
          <h4>Schnell erreichbar</h4>
          <a href="tel:+4937294170-0"><VvIcon name="phone" size={16} /> 037294 / 170-0</a>
          <a href="mailto:info@wildenstein.ws"><VvIcon name="mail" size={16} /> info@wildenstein.ws</a>
        </div>
      </aside>
    </div>
  </VvSection>

  {/* === Verwaltung / Ämter =========================================== */}
  <VvSection
    id="aemter"
    eyebrow="Verwaltung"
    title="Ämter & Ansprechpartner"
    intro="Die Fachbereiche des Verwaltungsverbands — von Bürgerbüro und Bauamt bis Standesamt und Fördermittelstelle."
  >
    <ul class="vv-aemter">
      {aemter.map((a) => (
        <li class="vv-reveal">
          <a href={a.href} class="vv-aemter__tile">
            <span class="vv-aemter__label">{a.label}</span>
            <VvIcon name="arrow-right" size={16} />
          </a>
        </li>
      ))}
    </ul>
  </VvSection>

  {/* === Highlight-Kacheln (wie im Original) ============================ */}
  <section class="vv-highlights" aria-label="Schnellzugriff">
    <div class="vv-container">
      <ul class="vv-highlights__grid">
        {highlights.map((h) => (
          <li class="vv-reveal">
            <a
              href={h.href}
              class="vv-highlights__card"
              target={h.external ? '_blank' : undefined}
              rel={h.external ? 'noopener noreferrer' : undefined}
            >
              <img src={h.image} alt={h.label} loading="lazy" decoding="async" />
              <span class="vv-highlights__veil" aria-hidden="true"></span>
              <span class="vv-highlights__label">
                <span>{h.label}</span>
                <VvIcon name={h.external ? 'arrow-up-right' : 'arrow-right'} size={18} class="vv-highlights__arrow" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* === Der Verband (dunkles Band) =================================== */}
  <section class="vv-about">
    <div class="vv-container vv-about__inner">
      <div class="vv-about__text vv-reveal">
        <p class="vv-eyebrow">Der Verwaltungsverband</p>
        <h2>Zwei Gemeinden, eine Verwaltung.</h2>
        <p class="vv-about__lead">
          Der Verwaltungsverband Wildenstein nimmt als Körperschaft des öffentlichen
          Rechts die Verwaltungsaufgaben der Mitgliedsgemeinden <strong>Grünhainichen</strong>
          und <strong>Börnichen/Erzgeb.</strong> gemeinsam wahr — bürgernah, effizient und
          aus einer Hand.
        </p>
        <div class="vv-about__cta">
          <VvButton href="/verband" variant="light" icon="arrow-right">Über den Verband</VvButton>
          <VvButton href="/verband/verbandsversammlung" variant="ghost" icon="users">Verbandsversammlung</VvButton>
        </div>
      </div>
      <ul class="vv-about__stats vv-reveal">
        <li><strong>2</strong><span>Mitgliedsgemeinden</span></li>
        <li><strong>13</strong><span>Fachbereiche & Ämter</span></li>
        <li><strong>1</strong><span>gemeinsame Verwaltung</span></li>
      </ul>
    </div>
  </section>

  {/* === Mitgliedsgemeinden =========================================== */}
  <VvSection eyebrow="Mitgliedsgemeinden" title="Die Gemeinden im Verband" align="center">
    <div class="vv-communes">
      <a href="https://www.gruenhainichen.com" target="_blank" rel="noopener noreferrer" class="vv-commune vv-reveal">
        <span class="vv-commune__name">Gemeinde Grünhainichen</span>
        <span class="vv-commune__sub">mit Borstendorf &amp; Waldkirchen/Erzgeb.</span>
        <span class="vv-commune__link">Zur Gemeinde-Website <VvIcon name="arrow-up-right" size={15} /></span>
      </a>
      <a href="https://www.boernichen.de" target="_blank" rel="noopener noreferrer" class="vv-commune vv-reveal">
        <span class="vv-commune__name">Gemeinde Börnichen/Erzgeb.</span>
        <span class="vv-commune__sub">Staatlich anerkannter Erholungsort</span>
        <span class="vv-commune__link">Zur Gemeinde-Website <VvIcon name="arrow-up-right" size={15} /></span>
      </a>
    </div>
  </VvSection>
</BaseLayout>

<script>
  // Parallax für die Höhenlinien-Ebenen (Highlights + Aktuelles).
  const els = document.querySelectorAll<HTMLElement>('.vv-highlights, #aktuelles');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (els.length && !reduce) {
    let ticking = false;
    const update = () => {
      const vh = window.innerHeight;
      els.forEach((el) => {
        const r = el.getBoundingClientRect();
        const progress = (r.top + r.height / 2 - vh / 2) / vh; // ~ -1 … 1
        const py = Math.max(-130, Math.min(130, progress * -130));
        el.style.setProperty('--vv-py', py.toFixed(1) + 'px');
      });
      ticking = false;
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }
</script>

<style>
  /* === Aktuelles ============================================= */
  .vv-news { display: grid; grid-template-columns: 1fr; gap: var(--vv-space-7); }
  @media (min-width: 1024px) { .vv-news { grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: var(--vv-space-8); } }
  .vv-news__main { display: flex; flex-direction: column; gap: var(--vv-space-5); align-items: flex-start; min-width: 0; }

  .vv-news__feature {
    display: grid; grid-template-columns: 1fr; width: 100%;
    background: var(--vv-white); border: 1px solid var(--vv-border-soft);
    border-radius: var(--vv-radius-lg); overflow: hidden; color: inherit;
    transition: transform var(--vv-dur-base), box-shadow var(--vv-dur-base), border-color var(--vv-dur-base);
  }
  @media (min-width: 680px) { .vv-news__feature { grid-template-columns: 1.05fr 1fr; } }
  .vv-news__feature:hover { transform: translateY(-3px); border-color: var(--vv-sky-400); box-shadow: var(--vv-shadow-md); }
  .vv-news__feature-media { position: relative; aspect-ratio: 4 / 3; background: var(--vv-gray-100); overflow: hidden; }
  .vv-news__feature-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--vv-ease-out); }
  .vv-news__feature:hover .vv-news__feature-media img { transform: scale(1.04); }
  .vv-news__badge {
    position: absolute; top: 12px; left: 12px;
    background: var(--vv-white); color: var(--vv-navy-800);
    font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em;
    padding: 5px 10px; border-radius: var(--vv-radius-pill); box-shadow: var(--vv-shadow-sm);
  }
  .vv-news__feature-body { display: flex; flex-direction: column; gap: var(--vv-space-3); padding: var(--vv-space-6); }
  .vv-news__date { font-size: var(--vv-fs-sm); color: var(--vv-green-800); font-weight: 500; }
  .vv-news__feature-title { font-size: var(--vv-fs-xl); line-height: 1.2; color: var(--vv-navy-800); margin: 0; }
  .vv-news__feature-excerpt { font-size: var(--vv-fs-base); line-height: 1.6; color: var(--vv-gray-700); flex: 1; margin: 0; }
  .vv-news__more { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; font-size: var(--vv-fs-sm); color: var(--vv-navy-700); }
  .vv-news__more :global(svg) { transition: transform var(--vv-dur-fast); }
  .vv-news__feature:hover .vv-news__more :global(svg) { transform: translateX(3px); }

  .vv-news__fallback { position: absolute; inset: 0; background: linear-gradient(150deg, var(--vv-navy-700), var(--vv-navy-900)); }
  [data-cat="veranstaltung"] .vv-news__fallback { background: linear-gradient(150deg, var(--vv-green-600), var(--vv-green-800)); }
  [data-cat="ausschreibung"] .vv-news__fallback { background: linear-gradient(150deg, var(--vv-sky-500), var(--vv-navy-700)); }

  .vv-news__list { display: flex; flex-direction: column; gap: var(--vv-space-3); width: 100%; }
  .vv-news__item {
    display: grid; grid-template-columns: 84px 1fr auto; gap: var(--vv-space-4);
    align-items: center; padding: var(--vv-space-3) var(--vv-space-4); color: inherit;
    background: var(--vv-white); border: 1px solid var(--vv-border-soft);
    border-radius: var(--vv-radius-md); box-shadow: var(--vv-shadow-sm);
    transition: transform var(--vv-dur-fast), box-shadow var(--vv-dur-fast), border-color var(--vv-dur-fast);
  }
  .vv-news__item:hover { transform: translateY(-2px); border-color: var(--vv-sky-400); box-shadow: var(--vv-shadow-md); }
  .vv-news__item-media { position: relative; aspect-ratio: 1 / 1; border-radius: var(--vv-radius-sm); overflow: hidden; background: var(--vv-gray-100); }
  .vv-news__item-media img { width: 100%; height: 100%; object-fit: cover; }
  .vv-news__item-body { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .vv-news__item-meta { display: inline-flex; gap: var(--vv-space-3); align-items: center; font-size: 10px; text-transform: uppercase; letter-spacing: 0.14em; color: var(--vv-text-muted); font-weight: 700; }
  .vv-news__cat { color: var(--vv-green-800); }
  .vv-news__item-title { font-weight: 600; color: var(--vv-navy-800); line-height: 1.3; }
  .vv-news__item :global(.vv-news__item-arrow) { color: var(--vv-gray-400); transition: transform var(--vv-dur-fast), color var(--vv-dur-fast); }
  .vv-news__item:hover :global(.vv-news__item-arrow) { color: var(--vv-green-600); transform: translateX(3px); }

  /* Sperrungen-Aside */
  .vv-news__aside {
    display: flex; flex-direction: column; gap: var(--vv-space-4);
    padding: var(--vv-space-6); background: var(--vv-white);
    border: 1px solid var(--vv-border-soft); border-top: 4px solid var(--vv-alert-600);
    border-radius: var(--vv-radius-md); align-self: start;
  }
  .vv-news__aside-head { display: flex; flex-direction: column; gap: 6px; padding-bottom: var(--vv-space-3); border-bottom: 1px solid var(--vv-border-soft); }
  .vv-news__aside-eyebrow { color: var(--vv-alert-600) !important; display: inline-flex !important; align-items: center; gap: 6px; }
  .vv-news__aside-head h3 { font-size: var(--vv-fs-lg); color: var(--vv-navy-800); margin: 0; }

  .vv-alert-list { display: flex; flex-direction: column; gap: var(--vv-space-3); }
  .vv-alert { background: var(--vv-bg-alt); border-radius: var(--vv-radius-sm); transition: background var(--vv-dur-fast); }
  .vv-alert:hover { background: var(--vv-sky-50); }
  .vv-alert a { display: grid; grid-template-columns: auto 1fr; gap: var(--vv-space-3); align-items: start; padding: var(--vv-space-4); color: inherit; }
  .vv-alert__dot { width: 10px; height: 10px; border-radius: 50%; margin-top: 6px; box-shadow: 0 0 0 4px rgba(255,255,255,0.7); }
  .vv-alert--info  .vv-alert__dot { background: var(--vv-info-600); }
  .vv-alert--warn  .vv-alert__dot { background: var(--vv-warn-600); }
  .vv-alert--alert .vv-alert__dot { background: var(--vv-alert-600); animation: vv-pulse 2.4s ease-in-out infinite; }
  @keyframes vv-pulse { 0%,100% { box-shadow: 0 0 0 4px rgba(255,255,255,0.7); } 50% { box-shadow: 0 0 0 4px rgba(179,38,30,0.25); } }
  .vv-alert__body { display: flex; flex-direction: column; gap: 4px; }
  .vv-alert__tag { font-size: 10px; text-transform: uppercase; letter-spacing: 0.16em; color: var(--vv-text-muted); font-weight: 700; }
  .vv-alert--alert .vv-alert__tag { color: var(--vv-alert-600); }
  .vv-alert__title { font-weight: 600; color: var(--vv-navy-800); line-height: 1.25; }
  .vv-alert__meta, .vv-alert__until { display: inline-flex; align-items: center; gap: 6px; font-size: var(--vv-fs-sm); color: var(--vv-gray-700); }
  .vv-alert__until { color: var(--vv-green-800); font-weight: 600; font-size: 12px; }
  .vv-alert-empty { font-size: var(--vv-fs-sm); color: var(--vv-gray-700); font-style: italic; }

  .vv-news__aside-more { display: inline-flex; align-items: center; gap: 6px; color: var(--vv-alert-600); font-size: 11px; text-transform: uppercase; letter-spacing: 0.16em; font-weight: 700; align-self: flex-start; transition: gap var(--vv-dur-fast); }
  .vv-news__aside-more:hover { gap: 12px; }

  .vv-news__contactbox { border-top: 1px solid var(--vv-border-soft); padding-top: var(--vv-space-4); display: flex; flex-direction: column; gap: 8px; }
  .vv-news__contactbox h4 { font-size: 11px; text-transform: uppercase; letter-spacing: 0.16em; color: var(--vv-green-800); margin-bottom: 2px; }
  .vv-news__contactbox a { display: inline-flex; align-items: center; gap: 8px; color: var(--vv-navy-700); font-weight: 500; font-size: var(--vv-fs-sm); }
  .vv-news__contactbox a:hover { color: var(--vv-navy-900); }

  /* === Ämter ================================================= */
  .vv-aemter { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr)); gap: var(--vv-space-3); }
  .vv-aemter__tile {
    display: flex; align-items: center; justify-content: space-between; gap: var(--vv-space-3);
    padding: var(--vv-space-4) var(--vv-space-5);
    background: var(--vv-white); border: 1px solid var(--vv-border); border-left: 3px solid var(--vv-green-600);
    border-radius: var(--vv-radius-sm); color: var(--vv-navy-800); font-weight: 500;
    transition: transform var(--vv-dur-fast), box-shadow var(--vv-dur-fast), border-color var(--vv-dur-fast), background var(--vv-dur-fast);
  }
  .vv-aemter__tile:hover { transform: translateY(-2px); background: var(--vv-sky-50); border-left-color: var(--vv-navy-800); box-shadow: var(--vv-shadow-sm); }
  .vv-aemter__tile :global(svg) { color: var(--vv-gray-400); transition: transform var(--vv-dur-fast), color var(--vv-dur-fast); flex-shrink: 0; }
  .vv-aemter__tile:hover :global(svg) { color: var(--vv-green-600); transform: translateX(3px); }

  /* === Höhenlinien-Hintergrund mit Parallax (Highlights + Aktuelles) ===
     Eine ::before-Ebene trägt das Topo-SVG, wird beim Scrollen über
     --vv-py verschoben (Parallax) und ist bewusst transparenter gehalten. */
  .vv-highlights,
  :global(#aktuelles) {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  .vv-highlights > *,
  :global(#aktuelles > *) { position: relative; z-index: 1; }
  /* Topo-Ebene (parallaxt) */
  .vv-highlights::before,
