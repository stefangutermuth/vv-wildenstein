  'search': '<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>',
  'menu': '<path d="M3 6h18M3 12h18M3 18h18"/>',
  'x': '<path d="M18 6 6 18M6 6l12 12"/>',
  'chevron-down': '<path d="m6 9 6 6 6-6"/>',
  'vote': '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m8 12 2.5 2.5L16 9"/>',
  'waves': '<path d="M2 8q2 -3 4 0t4 0t4 0t4 0"/><path d="M2 13q2 -3 4 0t4 0t4 0t4 0"/><path d="M2 18q2 -3 4 0t4 0t4 0t4 0"/>',
