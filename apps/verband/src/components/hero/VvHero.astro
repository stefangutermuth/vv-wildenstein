---
import VvIcon from '../primitives/VvIcon.astro';

interface QuickItem {
  icon: string;
  label: string;
  sub?: string;
  href: string;
  external?: boolean;
  live?: boolean; // Freibad: Live-Status (geöffnet/geschlossen)
}
interface Props {
  image: string;
  imageAlt?: string;
  credit?: string;
  boxes: QuickItem[];
  chips: QuickItem[];
}
const { image, imageAlt = '', credit, boxes, chips } = Astro.props;

// Freibad-Öffnungsstatus. WICHTIG: dieselbe Logik steckt im <script> unten
// (clientseitig für die echte Uhrzeit) — bei Änderungen BEIDE anpassen.
function freibadStatus(d: Date) {
  const y = d.getFullYear();
  const inSeason = d >= new Date(y, 4, 15, 0, 0) && d <= new Date(y, 8, 8, 23, 59); // 15.5.–8.9.
  const h = d.getHours();
  const open = inSeason && h >= 9 && h < 20; // täglich 9–20 Uhr
  const text = open ? 'Geöffnet' : !inSeason ? 'Winterpause' : h < 9 ? 'Öffnet 9 Uhr' : 'Geschlossen';
  return { state: open ? 'open' : 'closed', text };
}
const freibad = freibadStatus(new Date());
---
<section class="vv-hero vv-hero--stack">
  <div class="vv-hero__media">
    <img src={image} alt={imageAlt} fetchpriority="high" decoding="async" />
    <div class="vv-hero__scrim"></div>
    {credit && <span class="vv-hero__credit">Foto: {credit}</span>}
  </div>

  <div class="vv-hero__region">
    <img src="/images/logos/erzgebirge.jpg" alt="Tourismusregion Erzgebirge" width="86" height="56" loading="lazy" decoding="async" />
  </div>

  <div class="vv-container vv-hero__inner">
    <div class="vv-hero__copy">
      <p class="vv-hero__eyebrow">Willkommen im</p>
      <h1 class="vv-hero__title">Verwaltungsverband Wildenstein</h1>
      <p class="vv-hero__lead">
        Die gemeinsame Verwaltung der Gemeinden <strong>Grünhainichen</strong> und
        <strong>Börnichen/Erzgeb.</strong> — Bürgerservice, Bekanntmachungen und
        Ansprechpartner an einem Ort.
      </p>
    </div>

    {/* Glas-Boxen (Inhalte folgen — aktuell Platzhalter) */}
    <ul class="vv-hero__gboxes">
      {boxes.map((s) => (
        <li>
          <a href={s.href} class="vv-gbox" target={s.external ? '_blank' : undefined} rel={s.external ? 'noopener noreferrer' : undefined}>
            <span class="vv-gbox__top">
              <span class="vv-gbox__icon"><VvIcon name={s.icon} size={22} /></span>
              {s.live && (
                <span class="vv-gbox__live" data-freibad-status data-state={freibad.state}>
                  <span class="vv-gbox__live-dot"></span>
                  <span data-text>{freibad.text}</span>
                </span>
              )}
            </span>
            <span class="vv-gbox__label">{s.label}</span>
            {s.sub && <span class="vv-gbox__sub">{s.sub}</span>}
            <VvIcon name={s.external ? 'arrow-up-right' : 'arrow-right'} size={15} class="vv-gbox__arrow" />
          </a>
        </li>
      ))}
    </ul>

    {/* Glas-Chips (die „Buttons") */}
    <ul class="vv-hero__chips">
      {chips.map((s) => (
        <li>
          <a href={s.href} class="vv-chip" target={s.external ? '_blank' : undefined} rel={s.external ? 'noopener noreferrer' : undefined}>
            <span class="vv-chip__icon"><VvIcon name={s.icon} size={18} /></span>
            <span class="vv-chip__body">
              <span class="vv-chip__label">{s.label}</span>
              {s.sub && <span class="vv-chip__sub">{s.sub}</span>}
            </span>
            <VvIcon name={s.external ? 'arrow-up-right' : 'arrow-right'} size={14} class="vv-chip__arrow" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  // Live-Status Freibad — im Browser berechnet (immer aktuell, nicht nur zum Build).
  // Anpassbar: Saison + Öffnungszeiten. Muss zur Logik im Frontmatter passen.
  (function () {
    const els = document.querySelectorAll('[data-freibad-status]');
    if (!els.length) return;
    const now = new Date();
    const y = now.getFullYear();
    const inSeason = now >= new Date(y, 4, 15, 0, 0) && now <= new Date(y, 8, 8, 23, 59);
    const h = now.getHours();
    const open = inSeason && h >= 9 && h < 20;
    const text = open ? 'Geöffnet' : !inSeason ? 'Winterpause' : h < 9 ? 'Öffnet 9 Uhr' : 'Geschlossen';
    els.forEach((el) => {
      el.setAttribute('data-state', open ? 'open' : 'closed');
      const t = el.querySelector('[data-text]');
      if (t) t.textContent = text;
    });
  })();
</script>

<style>
  /* === Hero-Shell =========================================== */
  .vv-hero {
    position: relative;
    isolation: isolate;
    color: var(--vv-white);
    display: flex;
    align-items: center;
    min-height: clamp(400px, 56vh, 540px);
    overflow: hidden;
  }
  .vv-hero__media { position: absolute; inset: 0; z-index: -2; }
  .vv-hero__media img { width: 100%; height: 100%; object-fit: cover; }
  .vv-hero__scrim {
    position: absolute; inset: 0; z-index: 1;
    background:
      linear-gradient(92deg,
        rgba(5, 10, 38, 0.82) 0%, rgba(5, 10, 38, 0.74) 32%, rgba(5, 10, 38, 0.56) 46%,
        rgba(5, 10, 38, 0.30) 60%, rgba(5, 10, 38, 0.09) 73%, rgba(5, 10, 38, 0) 85%),
      linear-gradient(180deg,
        rgba(7, 14, 46, 0.20) 0%, rgba(7, 14, 46, 0) 34%, rgba(7, 14, 46, 0) 60%, rgba(7, 14, 46, 0.38) 100%);
  }
  .vv-hero__credit {
    position: absolute; right: 10px; bottom: 8px;
    font-size: 11px; color: rgba(255, 255, 255, 0.75); letter-spacing: 0.02em;
  }
  /* Regions-Logo (Erzgebirge) — weißes Badge oben rechts */
  .vv-hero__region {
    position: absolute;
    top: var(--vv-space-6);
    right: var(--vv-space-6);
    z-index: 2;
    display: none;
    background: #fff;
    border-radius: var(--vv-radius-md);
    padding: 9px 13px;
    box-shadow: var(--vv-shadow-md);
  }
  @media (min-width: 960px) { .vv-hero__region { display: block; } }
  .vv-hero__region img { display: block; height: 56px; width: auto; }
  .vv-hero__inner { padding-block: var(--vv-space-8); }
  .vv-hero__copy { max-width: 820px; }
  .vv-hero__eyebrow {
    display: inline-block; font-size: var(--vv-fs-sm); font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.16em; color: var(--vv-sky-200);
    margin-bottom: var(--vv-space-3); text-shadow: 0 1px 12px rgba(10, 18, 64, 0.6);
  }
  .vv-hero__title {
    color: var(--vv-white); font-size: var(--vv-fs-hero); font-weight: 700;
    line-height: 1.08; letter-spacing: -0.02em; text-shadow: 0 2px 24px rgba(10, 18, 64, 0.45);
    hyphens: auto; overflow-wrap: break-word; /* langes Wort mit Trennstrich statt mittendrin */
  }
  .vv-hero__lead {
    margin-top: var(--vv-space-4); font-size: var(--vv-fs-md); line-height: 1.6;
    color: rgba(255, 255, 255, 0.95); max-width: 60ch;
    text-shadow: 0 1px 12px rgba(7, 14, 46, 0.8), 0 1px 2px rgba(7, 14, 46, 0.5);
  }
  .vv-hero__lead strong { color: var(--vv-white); font-weight: 600; }

  /* === Glas-Boxen (vertikal, Icon oben) ===================== */
  .vv-hero__gboxes {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--vv-space-3); margin-top: var(--vv-space-8);
  }
  @media (min-width: 780px) { .vv-hero__gboxes { grid-template-columns: repeat(5, 1fr); } }
  .vv-gbox {
    position: relative; display: flex; flex-direction: column; gap: 3px; height: 100%;
    padding: var(--vv-space-4) var(--vv-space-4) var(--vv-space-5);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.62), rgba(255, 255, 255, 0.44));
    border: 1px solid rgba(255, 255, 255, 0.6);
    -webkit-backdrop-filter: blur(22px) saturate(1.5); backdrop-filter: blur(22px) saturate(1.5);
    border-radius: var(--vv-radius-lg); color: var(--vv-navy-800);
    box-shadow: 0 18px 40px -16px rgba(11, 22, 82, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.85);
    transition: transform var(--vv-dur-fast), background var(--vv-dur-fast), border-color var(--vv-dur-fast), box-shadow var(--vv-dur-fast);
  }
  .vv-gbox:hover { transform: translateY(-4px); background: linear-gradient(180deg, rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0.72)); border-color: var(--vv-sky-400); box-shadow: 0 24px 46px -18px rgba(11, 22, 82, 0.5); }
  .vv-gbox__top { display: flex; align-items: center; flex-wrap: wrap; gap: var(--vv-space-3); margin-bottom: 6px; padding-right: 26px; }
  .vv-gbox__icon { display: grid; place-items: center; width: 42px; height: 42px; border-radius: var(--vv-radius-md); background: var(--vv-sky-50); color: var(--vv-navy-700); flex-shrink: 0; }
  .vv-gbox__label { font-weight: 700; font-size: var(--vv-fs-md); line-height: 1.2; color: var(--vv-navy-800); }
  .vv-gbox__sub { font-size: var(--vv-fs-sm); color: var(--vv-gray-700); font-weight: 500; }

  /* Live-Status-Badge (Freibad) */
  .vv-gbox__live {
    display: inline-flex; align-items: center; gap: 6px;
    width: fit-content;
    padding: 3px 10px 3px 8px;
    border-radius: var(--vv-radius-pill);
    font-size: 11px; font-weight: 700; letter-spacing: 0.02em;
    border: 1px solid transparent;
  }
  .vv-gbox__live[data-state="open"] {
    background: rgba(18, 138, 63, 0.14); color: var(--vv-green-800); border-color: rgba(18, 138, 63, 0.4);
  }
  .vv-gbox__live[data-state="closed"] {
    background: var(--vv-gray-100); color: var(--vv-gray-500); border-color: var(--vv-gray-300);
  }
  .vv-gbox__live-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; background: var(--vv-gray-400); }
  .vv-gbox__live[data-state="open"] .vv-gbox__live-dot {
    background: var(--vv-green-600); animation: vv-live-pulse 2s ease-in-out infinite;
  }
  @keyframes vv-live-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(18, 138, 63, 0.5); }
    70%      { box-shadow: 0 0 0 6px rgba(18, 138, 63, 0); }
  }
  @media (prefers-reduced-motion: reduce) { .vv-gbox__live-dot { animation: none !important; } }

  .vv-gbox :global(.vv-gbox__arrow) { position: absolute; top: var(--vv-space-4); right: var(--vv-space-4); color: var(--vv-gray-400); transition: transform var(--vv-dur-fast), color var(--vv-dur-fast); }
  .vv-gbox:hover :global(.vv-gbox__arrow) { color: var(--vv-green-600); transform: translateX(3px); }

  /* === Glas-Chips (horizontal, Icon links) ================== */
  .vv-hero--stack .vv-hero__chips { margin-top: var(--vv-space-3); }
  .vv-hero__chips {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: var(--vv-space-3); margin-top: var(--vv-space-6);
  }
  @media (min-width: 1080px) { .vv-hero__chips { grid-template-columns: repeat(5, 1fr); } }
  .vv-chip {
    display: flex; align-items: center; gap: var(--vv-space-3);
    padding: 0.55em 0.9em 0.55em 0.6em;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.64), rgba(255, 255, 255, 0.48));
    border: 1px solid rgba(255, 255, 255, 0.6);
    -webkit-backdrop-filter: blur(18px) saturate(1.5); backdrop-filter: blur(18px) saturate(1.5);
    border-radius: var(--vv-radius-pill); color: var(--vv-navy-800);
    box-shadow: 0 10px 26px -12px rgba(11, 22, 82, 0.38), inset 0 1px 0 rgba(255, 255, 255, 0.8);
    transition: transform var(--vv-dur-fast), background var(--vv-dur-fast), border-color var(--vv-dur-fast), box-shadow var(--vv-dur-fast);
  }
  .vv-chip:hover { transform: translateY(-2px); background: linear-gradient(180deg, rgba(255, 255, 255, 0.88), rgba(255, 255, 255, 0.76)); border-color: var(--vv-sky-400); box-shadow: 0 16px 32px -14px rgba(11, 22, 82, 0.45); }
  .vv-chip__icon { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--vv-sky-50); color: var(--vv-navy-700); flex-shrink: 0; }
  .vv-chip__body { display: flex; flex-direction: column; line-height: 1.15; min-width: 0; }
  .vv-chip__label { font-weight: 700; font-size: var(--vv-fs-sm); }
  .vv-chip__sub { font-size: 11px; color: var(--vv-gray-700); font-weight: 500; }
  .vv-chip :global(.vv-chip__arrow) { margin-left: auto; color: var(--vv-gray-400); flex-shrink: 0; transition: transform var(--vv-dur-fast), color var(--vv-dur-fast); }
  .vv-chip:hover :global(.vv-chip__arrow) { color: var(--vv-green-600); transform: translateX(3px); }
</style>
