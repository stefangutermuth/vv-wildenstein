---
/**
 * Themen-Menü für lange Seiten (vor allem die Ämter).
 *
 * Das Einwohnermeldeamt führt 31 Leistungen von „Auskunftssperre" bis
 * „Wohnungsgeberbestätigung" auf einer Seite — ohne Einstieg muss man durch
 * 48.000 Zeichen scrollen. Das Menü listet die Themen und springt direkt hin.
 * Bei vielen Einträgen wird es zweispaltig, damit es nicht die halbe Seite füllt.
 */
import VvIcon from '../primitives/VvIcon.astro';
import type { Sprungmarke } from '../../lib/cms-wordpress';

interface Props {
  marken: Sprungmarke[];
  titel?: string;
}
const { marken, titel = 'Themen auf dieser Seite' } = Astro.props;
const zweispaltig = marken.length > 8;
---
{marken.length >= 3 && (
  <nav class="vv-sprung" aria-labelledby="vv-sprung-titel" data-sprungmenu>
    <h2 class="vv-sprung__titel" id="vv-sprung-titel">
      <VvIcon name="file-text" size={18} />
      {titel}
      <span class="vv-sprung__anzahl">{marken.length}</span>
    </h2>
    <ul class:list={['vv-sprung__list', { 'is-mehrspaltig': zweispaltig }]}>
      {marken.map((m) => (
        <li>
          <a href={`#${m.id}`}>{m.titel}</a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .vv-sprung {
    background: var(--vv-bg);
    border: 1px solid var(--vv-border-soft);
    border-radius: var(--vv-radius-lg);
    padding: var(--vv-space-5);
    margin: 0 0 var(--vv-space-6);
  }
  .vv-sprung__titel {
    display: flex;
    align-items: center;
    gap: var(--vv-space-2);
    margin: 0 0 var(--vv-space-4);
    font-size: var(--vv-fs-base);
    color: var(--vv-navy-800);
  }
  .vv-sprung__titel :global(svg) { color: var(--vv-sky-500); flex: none; }
  .vv-sprung__anzahl {
    margin-left: auto;
    font-size: var(--vv-fs-sm);
    font-weight: 500;
    color: var(--vv-text-muted);
    background: var(--vv-bg-alt);
    border-radius: 999px;
    padding: 2px 10px;
  }
  .vv-sprung__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
  }
  .vv-sprung__list.is-mehrspaltig {
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    column-gap: var(--vv-space-4);
  }
  /* In der schmalen Seitenleiste bleibt es einspaltig. Bei 16 Themen wäre die
     Liste 700 px hoch — sie bekommt deshalb einen eigenen Scrollbereich,
     damit Kontakt UND Menü zusammen ins Bild passen. */
  :global(.vv-seitenleiste) .vv-sprung__list.is-mehrspaltig {
    grid-template-columns: 1fr;
  }
  :global(.vv-seitenleiste) .vv-sprung { padding: var(--vv-space-4); }
  /* Keine eigene Höhenbegrenzung mehr: Die Liste erzwang damit einen
     Scrollbalken, obwohl das Menü ins Fenster gepasst hätte. Begrenzt wird
     jetzt der ganze Kasten (in [...slug].astro), und zwar erst dann, wenn er
     wirklich höher ist als das Fenster. */
  :global(.vv-seitenleiste) .vv-sprung__list { padding-right: 2px; }
  .vv-sprung__list a {
    display: block;
    padding: 7px 10px 7px 18px;
    border-radius: var(--vv-radius-sm);
    color: var(--vv-link);
    text-decoration: none;
    font-size: var(--vv-fs-sm);
    line-height: 1.4;
    position: relative;
  }
  .vv-sprung__list a::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 50%;
    width: 5px;
    height: 5px;
    margin-top: -2px;
    border-radius: 50%;
    background: var(--vv-sky-500);
    opacity: 0.55;
  }
  .vv-sprung__list a:hover {
    background: var(--vv-bg-alt);
    text-decoration: underline;
  }
  /* Das gerade gelesene Thema hervorheben — ohne die Markierung weiß man in
     einer 16-Punkte-Liste nicht, wo man sich befindet. */
  .vv-sprung__list a[aria-current='true'] {
    background: var(--vv-navy-800);
    color: #fff;
    font-weight: 600;
  }
  .vv-sprung__list a[aria-current='true']::before { background: #fff; opacity: 1; }

  @media print {
    .vv-sprung { display: none; }
  }
</style>

<script>
  // Markiert im Themen-Menü den Abschnitt, in dem man gerade liest.
  //
  // Vorher lief das über einen IntersectionObserver mit schmalem Band unter
  // der Kopfzeile. Wer zügig scrollt, springt über dieses Band hinweg — dann
  // blieb die Markierung stehen oder erschien gar nicht. Jetzt wird bei jedem
  // Scrollen bestimmt, welche Überschrift zuletzt passiert wurde; das trifft
  // immer zu, unabhängig von der Scroll-Geschwindigkeit.
  //
  // Ohne JavaScript funktionieren die Sprunglinks unverändert, es fehlt
  // lediglich die Hervorhebung.
  (() => {
    const menu = document.querySelector('[data-sprungmenu]');
    if (!menu) return;

    const eintraege = [];
    for (const a of menu.querySelectorAll('a[href^="#"]')) {
      const id = decodeURIComponent(a.getAttribute('href').slice(1));
      const ziel = document.getElementById(id);
      if (ziel) eintraege.push({ a, ziel });
    }
    if (!eintraege.length) return;

    const liste = menu.querySelector('ul');
    let aktiv = null;

    function markiere() {
      // Bezugslinie knapp unter der Kopfzeile
      const linie = 100;
      let treffer = eintraege[0];
      for (const e of eintraege) {
        if (e.ziel.getBoundingClientRect().top <= linie) treffer = e;
        else break;
      }
      // Ganz oben auf der Seite noch nichts hervorheben
      if (window.scrollY < 40 && eintraege[0].ziel.getBoundingClientRect().top > linie) {
        treffer = null;
      }
      if (treffer === aktiv) return;
      if (aktiv) aktiv.a.removeAttribute('aria-current');
      aktiv = treffer;
      if (!aktiv) return;
      aktiv.a.setAttribute('aria-current', 'true');
      // Bei langen Listen den markierten Eintrag in den sichtbaren Bereich holen
      if (liste && menu.scrollHeight > menu.clientHeight + 4) {
        aktiv.a.scrollIntoView({ block: 'nearest' });
      }
    }

    let geplant = false;
    const anstossen = () => {
      if (geplant) return;
      geplant = true;
      requestAnimationFrame(() => { geplant = false; markiere(); });
    };

    window.addEventListener('scroll', anstossen, { passive: true });
    window.addEventListener('resize', anstossen, { passive: true });
    markiere();
  })();
</script>
