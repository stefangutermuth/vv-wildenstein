---
interface Props {
  size?: number;
  class?: string;
}
const { size = 46, class: className } = Astro.props;
---
<img
  src="/images/logos/wappen-vv.svg"
  alt="Wappen des Verwaltungsverbands Wildenstein"
  width={size}
  height={size}
  class={className}
  style={`width:auto;height:${size}px`}
  decoding="async"
/>
