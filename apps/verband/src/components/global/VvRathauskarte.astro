---
/**
 * Rathaus-Kasten für die Verwaltungsseite.
 *
 * Die Öffnungszeiten des Rathauses standen bisher als Fließtext UNTER allen
 * 14 Ämtern — dort sucht sie niemand. Jetzt stehen sie als Spalte daneben.
 *
 * Das Zerlegen der im Backend mit Leerzeichen ausgerichteten Zeilen macht
 * lib/oeffnungszeiten.ts — dieselbe Stelle versorgt auch den Seitenfuß.
 */
import { zerlegeOeffnungszeiten } from '../../lib/oeffnungszeiten';

interface Props {
  html: string;
}
const { html } = Astro.props;

const { ueberschrift, zeiten, absaetze, roh } = zerlegeOeffnungszeiten(html);
const hatZeiten = zeiten.length > 0;
---
<aside class="vv-rathaus" aria-label={ueberschrift || 'Rathaus'}>
  <h2 class="vv-rathaus__titel">{ueberschrift || 'Öffnungszeiten Rathaus'}</h2>

  {hatZeiten ? (
    <dl class="vv-rathaus__zeiten">
      {zeiten.map((z) => (
        <div>
          <dt>{z.tage}</dt>
          <dd>{z.zeit}</dd>
        </div>
      ))}
    </dl>
  ) : (
    <p class="vv-rathaus__text">{roh}</p>
  )}

  {hatZeiten && absaetze.map((a) => <p class="vv-rathaus__hinweis">{a}</p>)}
</aside>

<style>
  .vv-rathaus {
    background: var(--vv-bg);
    border: 1px solid var(--vv-border-soft);
    border-radius: var(--vv-radius-lg);
    padding: var(--vv-space-5);
  }
  .vv-rathaus__titel {
    margin: 0 0 var(--vv-space-4);
    font-size: var(--vv-fs-base);
    color: var(--vv-navy-800);
    line-height: 1.3;
  }
  .vv-rathaus__zeiten { margin: 0; display: grid; gap: var(--vv-space-2); }
  .vv-rathaus__zeiten > div {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--vv-space-3);
    align-items: baseline;
    padding-bottom: var(--vv-space-2);
    border-bottom: 1px solid var(--vv-border-soft);
  }
  .vv-rathaus__zeiten > div:last-child { border-bottom: 0; padding-bottom: 0; }
  .vv-rathaus__zeiten dt {
    margin: 0;
    font-weight: 600;
    color: var(--vv-text);
    font-size: var(--vv-fs-sm);
  }
  .vv-rathaus__zeiten dd {
    margin: 0;
    color: var(--vv-navy-800);
    font-size: var(--vv-fs-sm);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .vv-rathaus__hinweis,
  .vv-rathaus__text {
    margin: var(--vv-space-3) 0 0;
    font-size: var(--vv-fs-sm);
    line-height: 1.5;
    color: var(--vv-text-muted);
  }
  .vv-rathaus__text { white-space: pre-line; }
</style>
