---
import VvWappen from './VvWappen.astro';
import VvIcon from '../primitives/VvIcon.astro';
import { fetchRathausZeiten } from '../../lib/cms-wordpress';
import { kuerzeTage } from '../../lib/oeffnungszeiten';

/**
 * Die Sprechzeiten kommen aus dem Redaktionssystem (Seite "Verwaltung"),
 * nicht aus dem Quelltext — hier getippt waren sie zuletzt an drei Stellen
 * veraltet. Ist die Liste leer (Abruf fehlgeschlagen), verweist der Fuß auf
 * /verwaltung statt eine falsche Zeit zu zeigen.
 */
const sprechzeiten = (await fetchRathausZeiten()).map((z) => ({
  tage: kuerzeTage(z.tage),
  zeit: z.zeit,
}));

const columns = [
  {
    title: 'Verband',
    links: [
      { label: 'Der Verwaltungsverband', href: '/verband' },
      { label: 'Verbandsversammlung', href: '/verband/verbandsversammlung' },
      { label: 'Rechtssachen / Satzungen', href: '/verband/rechtssachen-satzungen' },
      { label: 'Amtsblatt', href: '/amtsblatt' },
    ],
  },
  {
    title: 'Verwaltung',
    links: [
      { label: 'Öffnungszeiten & Ämter', href: '/verwaltung' },
      { label: 'Heiraten', href: '/heiraten' },
      { label: 'Kindertagesstätten / Hort', href: '/kindertagesstaetten' },
    ],
  },
  {
    title: 'Service',
    links: [
      { label: 'Neuigkeiten', href: '/neuigkeiten' },
      { label: 'Sperrungen', href: '/sperrungen' },
      { label: 'Downloads & Formulare', href: '/downloads' },
      { label: 'Mängel-Melder', href: 'https://melder.vv-wildenstein.com', external: true },
    ],
  },
];
---
<footer class="vv-footer">
  <div class="vv-container vv-footer__top">
    <div class="vv-footer__brand">
      <div class="vv-footer__brand-head">
        <span class="vv-footer__logo-chip"><VvWappen size={44} /></span>
        <div>
          <strong>Verwaltungsverband Wildenstein</strong>
          <span>Grünhainichen &amp; Börnichen/Erzgeb.</span>
        </div>
      </div>
      <address class="vv-footer__contact">
        <p>
          <VvIcon name="map-pin" size={16} />
          <span>Chemnitzer Straße 41<br />09579 Grünhainichen</span>
        </p>
        <p>
          <VvIcon name="phone" size={16} />
          <a href="tel:+4937294170-0">037294 / 170-0</a>
        </p>
        <p>
          <VvIcon name="mail" size={16} />
          <a href="mailto:info@wildenstein.ws">info@wildenstein.ws</a>
        </p>
      </address>

      <div class="vv-footer__hours">
        <VvIcon name="clock" size={16} />
        <div class="vv-footer__hours-body">
          <strong>Sprechzeiten</strong>
          {sprechzeiten.length > 0 ? (
            <dl class="vv-footer__times">
              {sprechzeiten.map((z) => (
                <div>
                  <dt>{z.tage}</dt>
                  <dd>{z.zeit}</dd>
                </div>
              ))}
            </dl>
          ) : (
            <a href="/verwaltung">Sprechzeiten und Ämter ansehen</a>
          )}
        </div>
      </div>
    </div>

    <div class="vv-footer__cols">
      {columns.map((col) => (
        <nav class="vv-footer__col" aria-label={col.title}>
          <h3>{col.title}</h3>
          <ul>
            {col.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  target={l.external ? '_blank' : undefined}
                  rel={l.external ? 'noopener noreferrer' : undefined}
                >{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
  </div>
</footer>

<style>
  .vv-footer { background: var(--vv-navy-900); color: var(--vv-sky-200); margin-top: auto; }
  .vv-footer__top {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--vv-space-7);
    padding-block: var(--vv-space-8);
  }
  @media (min-width: 900px) {
    .vv-footer__top { grid-template-columns: 1.1fr 1.4fr; gap: var(--vv-space-8); }
  }

  .vv-footer__brand-head { display: flex; align-items: center; gap: var(--vv-space-3); }
  .vv-footer__logo-chip {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 8px 12px; background: var(--vv-white);
    border-radius: var(--vv-radius-md); flex-shrink: 0;
  }
  .vv-footer__brand-head strong { display: block; color: var(--vv-white); font-size: var(--vv-fs-md); }
  .vv-footer__brand-head span { color: var(--vv-sky-400); font-size: var(--vv-fs-sm); }

  /* Symbol und Text sind Geschwister im selben Flex-Kasten. Vorher steckte
     das Symbol IM Link — dort greift die Ausrichtung des Absatzes nicht, und
     Telefon und E-Mail brachen unter ihr Symbol um. */
  .vv-footer__contact { font-style: normal; margin-top: var(--vv-space-5); display: flex; flex-direction: column; gap: var(--vv-space-3); }
  .vv-footer__contact p { display: flex; align-items: flex-start; gap: 10px; font-size: var(--vv-fs-sm); line-height: 1.5; }
  .vv-footer__contact a { color: var(--vv-sky-200); transition: color var(--vv-dur-fast); }
  .vv-footer__contact a:hover { color: var(--vv-white); }
  .vv-footer__contact :global(svg) { color: var(--vv-green-400); flex-shrink: 0; margin-top: 3px; }

  .vv-footer__hours { display: flex; align-items: flex-start; gap: 10px; margin-top: var(--vv-space-5); }
  .vv-footer__hours :global(svg) { color: var(--vv-green-400); margin-top: 3px; flex-shrink: 0; }
  .vv-footer__hours-body { min-width: 0; }
  .vv-footer__hours strong { display: block; color: var(--vv-white); font-size: var(--vv-fs-sm); margin-bottom: 6px; }
  .vv-footer__hours a { color: var(--vv-sky-200); font-size: var(--vv-fs-sm); text-decoration: underline; text-underline-offset: 3px; }
  .vv-footer__hours a:hover { color: var(--vv-white); }

  /* Tage links, Zeiten rechtsbündig darunter — auch bei zwei Spannen am Tag
     bleiben die Uhrzeiten so untereinander lesbar. */
  /* Ein Raster für die ganze Liste, nicht eins pro Zeile — sonst beginnt jede
     Uhrzeit an einer anderen Stelle, je nachdem wie breit die Tage davor sind.
     display:contents hebt die Zeilen-Container ins gemeinsame Raster. */
  .vv-footer__times { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: 4px var(--vv-space-3); align-items: baseline; }
  .vv-footer__times > div { display: contents; }
  .vv-footer__times dt { margin: 0; font-size: var(--vv-fs-sm); color: var(--vv-sky-400); white-space: nowrap; }
  .vv-footer__times dd { margin: 0; font-size: var(--vv-fs-sm); font-variant-numeric: tabular-nums; white-space: nowrap; }

  .vv-footer__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--vv-space-6);
  }
  .vv-footer__col h3 {
    color: var(--vv-white);
    font-size: var(--vv-fs-sm);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: var(--vv-space-3);
  }
  .vv-footer__col ul { display: flex; flex-direction: column; gap: 4px; }
  .vv-footer__col a { display: inline-block; padding: 5px 0; color: var(--vv-sky-200); font-size: var(--vv-fs-sm); transition: color var(--vv-dur-fast); }
  .vv-footer__col a:hover { color: var(--vv-white); }
</style>
