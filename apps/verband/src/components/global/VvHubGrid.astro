---
/**
 * Natives Kachelgitter für Übersichts-/Hub-Seiten.
 *
 * Ersetzt die dynamischen Impreza-`us_grid`-Portalgitter, die den statischen
 * REST-Schnappschuss nicht überstehen (falsche/leere Kacheln). Die Kacheln
 * kommen aus den echten Daten (CPT-Einträge oder WP-Kind-Seiten) — siehe
 * `fetchHubSources()` + Auflösung in `[...slug].astro`.
 */
import type { HubTile } from '../../lib/cms-wordpress';
import VvIcon from '../primitives/VvIcon.astro';

interface Props {
  tiles: HubTile[];
  /** Icon für bildlose Kacheln (Ämter, Kind-Seiten) */
  icon?: string;
  /** Überschrift, wo das Gitter nur einen Teil der Seite ausmacht. */
  titel?: string;
}
const { tiles, icon = 'arrow-up-right', titel } = Astro.props;

/* Hat KEINE Kachel des Gitters ein Bild, entfällt die Bildfläche ganz. Sonst
   stünden dort nur Platzhalter — auf sechs Seiten waren das zusammen 97 leere
   Bilderrahmen, unter anderem alle Bekanntmachungen der
   Verbandsversammlungs-Seite. */
const hatBilder = tiles.some((t) => t.image);

/* Anschrift unter den Titel: Die alte Seite zeigte sie in jeder Kachel mit
   an — /leben-freizeit/freibad bestand danach aus dem Wort „Freibad" und
   sonst nichts. Die Daten stecken ohnehin in der Kachel. */
function ort(t: HubTile): string {
  const k = t.kontakt;
  if (!k) return '';
  return [k.strasse_hausnummer, k.plz_ort].filter(Boolean).join(', ');
}
---
{tiles.length > 0 && titel && <h2 class="vv-hubgrid__titel">{titel}</h2>}
{tiles.length > 0 && (
  <ul class:list={['vv-hubgrid', { 'is-schlicht': !hatBilder }]} role="list">
    {tiles.map((t) => (
      <li>
        <a class="vv-hubtile" href={t.href}>
          {hatBilder && (
            <div class="vv-hubtile__media">
              <span class="vv-hubtile__ph" aria-hidden="true"><VvIcon name={icon} size={26} /></span>
              {t.image && (
                <img src={t.image} alt="" loading="lazy" decoding="async" onerror="this.style.display='none'" />
              )}
            </div>
          )}
          <div class="vv-hubtile__body">
            {!hatBilder && <VvIcon name={icon} size={18} class="vv-hubtile__leitzeichen" />}
            <span class="vv-hubtile__meta">
              <span class="vv-hubtile__title">{t.title}</span>
              {ort(t) && <span class="vv-hubtile__ort">{ort(t)}</span>}
            </span>
            <VvIcon name="arrow-right" size={16} class="vv-hubtile__arrow" />
          </div>
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  .vv-hubgrid__titel {
    margin: 0 0 var(--vv-space-4);
    padding-bottom: var(--vv-space-2);
    border-bottom: 2px solid var(--vv-sky-200);
    font-size: var(--vv-fs-xl);
    color: var(--vv-navy-800);
  }
  .vv-hubgrid {
    list-style: none;
    margin: 0 0 var(--vv-space-5);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(240px, 100%), 1fr));
    gap: var(--vv-space-4);
  }
  .vv-hubtile {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--vv-white);
    border: 1px solid var(--vv-border-soft);
    border-radius: var(--vv-radius-lg);
    overflow: hidden;
    text-decoration: none;
    box-shadow: var(--vv-shadow-sm);
    transition: transform var(--vv-dur-fast), box-shadow var(--vv-dur-fast), border-color var(--vv-dur-fast);
  }
  .vv-hubtile:hover,
  .vv-hubtile:focus-visible {
    transform: translateY(-3px);
    border-color: var(--vv-sky-400);
    box-shadow: var(--vv-shadow-md);
  }
  /* Medienfläche = immer gebrandetes Navy-Panel mit Höhenlinien (Platzhalter).
     Ein vorhandenes Bild liegt darüber; scheitert es (onerror), bleibt das
     Panel mit Icon sichtbar — nie ein leerer grauer Kasten. */
  /* Schlichte Variante ohne Bildfläche: enger gesetzt, damit aus 38 Einträgen
     kein Kachelfeld über den halben Bildschirm wird. */
  .vv-hubgrid.is-schlicht { grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr)); gap: var(--vv-space-3); }
  .vv-hubgrid.is-schlicht .vv-hubtile__body { padding: var(--vv-space-3) var(--vv-space-4); }
  .vv-hubtile__leitzeichen { color: var(--vv-primary); flex: none; }
  /* Drei Kinder statt zwei: der Titel nimmt den freien Platz, sonst schöbe
     space-between das Leitzeichen vom Text weg. */
  .vv-hubgrid.is-schlicht .vv-hubtile__meta { flex: 1; min-width: 0; }

  .vv-hubtile__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: linear-gradient(135deg, var(--vv-navy-800) 0%, var(--vv-navy-700) 100%);
  }
  .vv-hubtile__media::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/images/patterns/verband-topo.svg') center / cover no-repeat;
    filter: invert(1) brightness(1.6);
    opacity: 0.22;
  }
  .vv-hubtile__ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--vv-sky-200);
  }
  .vv-hubtile__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--vv-dur-base) var(--vv-ease-out);
  }
  .vv-hubtile:hover .vv-hubtile__media img { transform: scale(1.05); }
  .vv-hubtile__body {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--vv-space-3);
    padding: var(--vv-space-3) var(--vv-space-4);
  }
  .vv-hubtile__meta { display: grid; gap: 1px; min-width: 0; }
  .vv-hubtile__ort {
    font-size: var(--vv-fs-xs);
    color: var(--vv-text-muted);
    font-weight: 400;
    line-height: 1.35;
  }
  .vv-hubtile__title {
    font-weight: 600;
    color: var(--vv-navy-800);
    line-height: 1.3;
  }
  .vv-hubtile :global(.vv-hubtile__arrow) {
    flex-shrink: 0;
    color: var(--vv-sky-500);
    transition: transform var(--vv-dur-fast), color var(--vv-dur-fast);
  }
  .vv-hubtile:hover :global(.vv-hubtile__arrow) {
    transform: translateX(3px);
    color: var(--vv-primary);
  }
</style>
