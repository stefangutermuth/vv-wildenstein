# =================================================================
# CMS-Quelle für Neuigkeiten / Veranstaltungen
# =================================================================
# "wordpress" (Default) → zentrale REST-API des Verwaltungsverbands
# "local"               → Platzhalter aus src/content (Dev ohne Netz)
#
# Hinweis: Die Inhaltsseiten ([...slug].astro) kommen IMMER aus
# WordPress — ohne Netzwerk schlägt der Build bewusst fehl.
#
# PUBLIC_CMS_SOURCE=local

# Solange die Seite auf 2026.vv-wildenstein.com testet: nicht indexieren.
# Beim Day-X auf vv-wildenstein.com auf "false" setzen (oder entfernen).
PUBLIC_STAGING=true

# Optional — REST-Base überschreiben. Wird relevant, sobald das zentrale
# WordPress auf eine eigene Subdomain (z. B. cms.vv-wildenstein.com) umzieht.
# Default: https://vv-wildenstein.com/wp-json/wp/v2
# PUBLIC_WP_API_BASE=https://cms.vv-wildenstein.com/wp-json/wp/v2
# PUBLIC_VW_EVENTS_BASE=https://cms.vv-wildenstein.com/wp-json/vw-events/v1

# =================================================================
# WordPress Application Password (BUILD-ZEIT, NIEMALS PUBLIC_!)
# =================================================================
# Nur nötig, wenn die Media-API anonyme Aufrufe mit 401 blockt.
WP_AUTH_USER=
WP_AUTH_PASS=
