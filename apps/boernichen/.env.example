# =================================================================
# CMS-Quelle für News
# =================================================================
# "local"     → Astro Content Collections (apps/gruenhainichen/src/content)
# "wordpress" → REST-API von vv-wildenstein.com
#
# Lokal entwickeln:
#   cp .env.example .env.local
#   PUBLIC_CMS_SOURCE=wordpress npm run dev
#
# In Cloudflare Workers Builds:
#   Project → Settings → Variables → PUBLIC_CMS_SOURCE = wordpress
#
PUBLIC_CMS_SOURCE=local

# Optional — Base-URL überschreiben (Default: https://vv-wildenstein.com/wp-json/wp/v2)
# Z.B. für Staging-Tests:
# PUBLIC_WP_API_BASE=https://staging.vv-wildenstein.com/wp-json/wp/v2

# =================================================================
# WordPress Application Password (BUILD-ZEIT, NIEMALS PUBLIC_!)
# =================================================================
# Werden gebraucht, weil die Media-API in dieser Installation
# für anonyme Aufrufer 401 zurückgibt. Mit diesen Credentials kommen
# Beitragsbilder + Bildgrößen durch.
#
# Erstellen in WP-Admin:
#   Benutzer → Profil → Anwendungs-Passwörter → "Neu hinzufügen"
#
# In Cloudflare:
#   Project → Settings → Variables → "Encrypted" anhaken!
#
WP_AUTH_USER=
WP_AUTH_PASS=
