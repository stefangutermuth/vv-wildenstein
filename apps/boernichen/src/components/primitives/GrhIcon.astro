---
/**
 * GrhIcon – einheitliches Linien-Icon-Set, 1.5px Stroke, abgerundete Enden.
 * Ergänzt Lucide-Stil-Icons um regionale Custom-Icons:
 *   angel11 · chess-knight · schwibbogen · miner · fir · path · bridge
 */
type IconName =
  | 'angel11' | 'chess-knight' | 'schwibbogen' | 'miner' | 'fir' | 'path' | 'bridge'
  | 'arrow-right' | 'arrow-down' | 'menu' | 'close' | 'search' | 'phone' | 'mail'
  | 'map-pin' | 'calendar' | 'clock' | 'document' | 'building' | 'user'
  | 'hiking' | 'bike' | 'bed' | 'utensils' | 'tree' | 'star';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  ariaHidden?: boolean;
  title?: string;
}
const { name, size = 24, class: extra = '', ariaHidden = true, title } = Astro.props;
const ariaProps = ariaHidden
  ? { 'aria-hidden': 'true', focusable: 'false' }
  : { role: 'img', 'aria-label': title ?? name };
---
<svg
  class={`grh-icon ${extra}`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  {...ariaProps}
>
  {title && !ariaHidden && <title>{title}</title>}

  {name === 'angel11' && (
    <g>
      {/* Stilisierter 11-Punkte-Engel: Kopf, Flügel-Bogen, 11 Punkte */}
      <circle cx="12" cy="6" r="2.2" />
      <path d="M4 14c2.5-3 5-4 8-4s5.5 1 8 4" />
      <circle cx="6"  cy="14"   r="0.55" fill="currentColor" stroke="none" />
      <circle cx="7.5" cy="13"  r="0.55" fill="currentColor" stroke="none" />
      <circle cx="9"  cy="12.3" r="0.55" fill="currentColor" stroke="none" />
      <circle cx="10.5" cy="12" r="0.55" fill="currentColor" stroke="none" />
      <circle cx="12" cy="11.8" r="0.55" fill="currentColor" stroke="none" />
      <circle cx="13.5" cy="12" r="0.55" fill="currentColor" stroke="none" />
      <circle cx="15" cy="12.3" r="0.55" fill="currentColor" stroke="none" />
      <circle cx="16.5" cy="13" r="0.55" fill="currentColor" stroke="none" />
      <circle cx="18" cy="14"   r="0.55" fill="currentColor" stroke="none" />
      <circle cx="9"  cy="16"   r="0.55" fill="currentColor" stroke="none" />
      <circle cx="15" cy="16"   r="0.55" fill="currentColor" stroke="none" />
      <path d="M9 18c1 1.2 4 1.2 6 0" />
    </g>
  )}

  {name === 'chess-knight' && (
    <g>
      {/* Springer-Silhouette */}
      <path d="M9 4c1.5 0 2.5 1 3 2 .5-.5 1.5-1 2.5-1 2 0 3.5 1.7 3.5 4v8c0 1-.5 2-2 2H7c-1.2 0-2-.8-2-2 0-2 1.5-3.5 3-4.5C7 11 6 10 6 8.5 6 7 7 6 8.2 6 8 5 8.5 4 9 4z" />
      <circle cx="10" cy="8.2" r="0.5" fill="currentColor" stroke="none" />
    </g>
  )}

  {name === 'schwibbogen' && (
    <g>
      {/* Halbkreis-Bogen mit Sockel und drei Lichter-Andeutungen */}
      <path d="M3 18c0-5 4-9 9-9s9 4 9 9" />
      <line x1="2"  y1="18" x2="22" y2="18" />
      <line x1="3"  y1="20" x2="3"  y2="18" />
      <line x1="21" y1="20" x2="21" y2="18" />
      <line x1="2"  y1="20" x2="22" y2="20" />
      <circle cx="7"  cy="14" r="0.7" fill="currentColor" stroke="none" />
      <circle cx="12" cy="11.5" r="0.7" fill="currentColor" stroke="none" />
      <circle cx="17" cy="14" r="0.7" fill="currentColor" stroke="none" />
    </g>
  )}

  {name === 'miner' && (
    <g>
      {/* Bergmann mit Lampe */}
      <circle cx="12" cy="6" r="2.2" />
      <path d="M9 8h6l-1 4h-4z" />
      <path d="M9 12l-1 8h8l-1-8" />
      <path d="M14 6.5l3-1" />
      <circle cx="17.5" cy="5.2" r="0.8" fill="currentColor" stroke="none" />
    </g>
  )}

  {name === 'fir' && (
    <g>
      {/* Tanne, mehrlagig */}
      <path d="M12 3l-4 5h2.5l-3.5 4h3l-4 5h12l-4-5h3l-3.5-4H14z" />
      <line x1="12" y1="18" x2="12" y2="21" />
    </g>
  )}

  {name === 'path' && (
    <path d="M4 20c2-2 2-5 5-6s4 2 7-1 4-3 4-3" />
  )}

  {name === 'bridge' && (
    <g>
      <path d="M2 14c4-4 8-4 10-4s6 0 10 4" />
      <line x1="2" y1="18" x2="22" y2="18" />
      <line x1="6" y1="14" x2="6" y2="18" />
      <line x1="10" y1="12" x2="10" y2="18" />
      <line x1="14" y1="12" x2="14" y2="18" />
      <line x1="18" y1="14" x2="18" y2="18" />
    </g>
  )}

  {name === 'arrow-right' && (
    <g><line x1="5" y1="12" x2="19" y2="12" /><polyline points="13 6 19 12 13 18" /></g>
  )}
  {name === 'arrow-down' && (
    <g><line x1="12" y1="5" x2="12" y2="19" /><polyline points="6 13 12 19 18 13" /></g>
  )}
  {name === 'menu' && (
    <g><line x1="4" y1="7" x2="20" y2="7" /><line x1="4" y1="12" x2="20" y2="12" /><line x1="4" y1="17" x2="20" y2="17" /></g>
  )}
  {name === 'close' && (
    <g><line x1="6" y1="6" x2="18" y2="18" /><line x1="18" y1="6" x2="6" y2="18" /></g>
  )}
  {name === 'search' && (
    <g><circle cx="11" cy="11" r="6" /><line x1="16" y1="16" x2="20" y2="20" /></g>
  )}
  {name === 'phone' && (
    <path d="M5 4h3l2 5-2 1c1 2 3 4 5 5l1-2 5 2v3c0 1-1 2-2 2-8 0-14-6-14-14 0-1 1-2 2-2z" />
  )}
  {name === 'mail' && (
    <g><rect x="3" y="5" width="18" height="14" rx="2" /><polyline points="3 7 12 13 21 7" /></g>
  )}
  {name === 'map-pin' && (
    <g><path d="M12 21s7-7 7-12a7 7 0 1 0-14 0c0 5 7 12 7 12z" /><circle cx="12" cy="9" r="2.5" /></g>
  )}
  {name === 'calendar' && (
    <g><rect x="3" y="5" width="18" height="16" rx="2" /><line x1="3" y1="10" x2="21" y2="10" /><line x1="8" y1="3" x2="8" y2="7" /><line x1="16" y1="3" x2="16" y2="7" /></g>
  )}
  {name === 'clock' && (
    <g><circle cx="12" cy="12" r="9" /><polyline points="12 7 12 12 15.5 14" /></g>
  )}
  {name === 'document' && (
    <g><path d="M6 3h8l4 4v14H6z" /><polyline points="14 3 14 7 18 7" /></g>
  )}
  {name === 'building' && (
    <g><rect x="4" y="3" width="16" height="18" /><line x1="9" y1="3" x2="9" y2="21" /><line x1="15" y1="3" x2="15" y2="21" /><line x1="4" y1="9" x2="20" y2="9" /><line x1="4" y1="15" x2="20" y2="15" /></g>
  )}
  {name === 'user' && (
    <g><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 4-7 8-7s8 3 8 7" /></g>
  )}
  {name === 'hiking' && (
    <g>
      <circle cx="14" cy="4.5" r="1.5" />
      <path d="M10 21l3-7-3-2 2-4 3 2 3 1" />
      <path d="M5 21l4-9" />
    </g>
  )}
  {name === 'bike' && (
    <g><circle cx="6" cy="17" r="3.5" /><circle cx="18" cy="17" r="3.5" /><polyline points="6 17 10 9 14 9 18 17" /><line x1="10" y1="9" x2="14" y2="9" /><line x1="12" y1="9" x2="14" y2="6" /></g>
  )}
  {name === 'bed' && (
    <g><line x1="3" y1="20" x2="3" y2="8" /><path d="M3 12h14a4 4 0 0 1 4 4v4" /><circle cx="8" cy="12" r="2" /></g>
  )}
  {name === 'utensils' && (
    <g><path d="M7 2v8a2 2 0 0 0 4 0V2" /><line x1="9" y1="10" x2="9" y2="22" /><path d="M16 2c-2 1-3 4-3 7s1 4 3 4v9" /></g>
  )}
  {name === 'tree' && (
    <g><path d="M12 2l-5 7h2l-4 6h3l-3 4h14l-3-4h3l-4-6h2z" /><line x1="12" y1="19" x2="12" y2="22" /></g>
  )}
  {name === 'star' && (
    <polygon points="12 3 14.5 9.5 21 10 16 14.5 17.5 21 12 17.5 6.5 21 8 14.5 3 10 9.5 9.5" />
  )}
</svg>

<style>
  .grh-icon { display: inline-block; vertical-align: middle; flex-shrink: 0; }
</style>
