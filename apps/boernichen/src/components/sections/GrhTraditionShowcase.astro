---
import GrhButton from '../primitives/GrhButton.astro';

type Topic = 'wendt-kuehn' | 'schachdorf' | 'blaufarbenwerk';
interface CTA { label: string; href: string; variant?: 'primary' | 'secondary' | 'ghost' }
interface Props {
  topic: Topic;
  numeral: string;
  numeralLabel?: string;
  eyebrow: string;
  title: string;
  body: string;
  pullQuote?: string;
  facts?: { label: string; value: string }[];
  ctas?: CTA[];
  reverse?: boolean;
  image?: string;
  imageAlt?: string;
}
const {
  topic, numeral, numeralLabel, eyebrow, title, body, pullQuote,
  facts = [], ctas = [], reverse = false, image, imageAlt = '',
} = Astro.props;
---
<article class={`grh-spread2 grh-spread2--${topic} ${reverse ? 'is-reverse' : ''}`}>
  {/* Riesige Hintergrund-Numeral */}
  <span class="grh-spread2__numeral grh-numeral" aria-hidden="true">{numeral}</span>
  {numeralLabel && <span class="grh-spread2__numeral-label" aria-hidden="true">{numeralLabel}</span>}

  <div class="grh-spread2__media">
    {image ? (
      <img src={image} alt={imageAlt} loading="lazy" decoding="async" />
    ) : (
      <div class="grh-spread2__media-fallback" aria-hidden="true"></div>
    )}
  </div>

  <div class="grh-spread2__copy">
    <span class="grh-eyebrow">{eyebrow}</span>
    <h2 class="grh-spread2__title grh-text-reveal">{title}</h2>
    <p class="grh-spread2__body">{body}</p>

    {pullQuote && (
      <blockquote class="grh-spread2__quote">
        <span aria-hidden="true">„</span>{pullQuote}<span aria-hidden="true">"</span>
      </blockquote>
    )}

    {facts.length > 0 && (
      <ul class="grh-spread2__facts">
        {facts.map((f) => (
          <li>
            <strong>{f.value}</strong>
            <span>{f.label}</span>
          </li>
        ))}
      </ul>
    )}

    {ctas.length > 0 && (
      <div class="grh-spread2__ctas">
        {ctas.map((c, i) => (
          <GrhButton href={c.href} variant={c.variant ?? (i === 0 ? 'primary' : 'ghost')}>
            {c.label}
          </GrhButton>
        ))}
      </div>
    )}
  </div>
</article>

<style>
  .grh-spread2 {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--grh-space-7);
    align-items: center;
    padding-block: var(--grh-space-8);
    isolation: isolate;
  }
  @media (min-width: 980px) {
    .grh-spread2 { grid-template-columns: 7fr 5fr; gap: var(--grh-space-9); }
    .grh-spread2.is-reverse .grh-spread2__media { order: 2; }
  }

  .grh-spread2__numeral {
    position: absolute;
    z-index: -1;
    font-family: var(--grh-font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(12rem, 28vw, 26rem);
    line-height: 0.85;
    letter-spacing: -0.06em;
    color: var(--grh-forest-700);
    opacity: 0.08;
    top: -40px;
    pointer-events: none;
    user-select: none;
  }
  .grh-spread2:not(.is-reverse) .grh-spread2__numeral { right: -2vw; }
  .grh-spread2.is-reverse .grh-spread2__numeral       { left:  -2vw; }

  .grh-spread2__numeral-label {
    position: absolute;
    z-index: 0;
    top: var(--grh-space-2);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    color: var(--grh-stone-400);
    opacity: 0.65;
  }
  .grh-spread2:not(.is-reverse) .grh-spread2__numeral-label { right: 4vw; }
  .grh-spread2.is-reverse .grh-spread2__numeral-label       { left:  4vw; }

  .grh-spread2__media {
    aspect-ratio: 5 / 6;
    overflow: hidden;
    border-radius: 2px;
    box-shadow: 0 30px 60px -25px rgba(26, 61, 39, 0.35);
    position: relative;
    z-index: 1;
  }
  .grh-spread2__media img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 1.5s var(--grh-ease-out);
  }
  .grh-spread2:hover .grh-spread2__media img { transform: scale(1.04); }
  .grh-spread2__media-fallback {
    position: absolute; inset: 0;
    background: linear-gradient(160deg, #6B4A2A, #A6794E);
  }

  .grh-spread2__copy {
    display: flex;
    flex-direction: column;
    gap: var(--grh-space-4);
    max-width: 520px;
    position: relative;
    z-index: 1;
  }
  .grh-spread2__title {
    font-family: var(--grh-font-display);
    font-size: clamp(2.2rem, 4.5vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--grh-forest-900);
  }
  .grh-spread2__body {
    font-size: var(--grh-fs-md);
    line-height: 1.7;
    color: var(--grh-stone-700);
  }
  .grh-spread2__quote {
    font-family: var(--grh-font-display);
    font-style: italic;
    font-weight: 400;
    font-size: var(--grh-fs-xl);
    line-height: 1.4;
    color: var(--grh-forest-800);
    border-left: 2px solid var(--grh-candle-500);
    padding: var(--grh-space-2) 0 var(--grh-space-2) var(--grh-space-5);
    margin-top: var(--grh-space-2);
  }

  .grh-spread2__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: var(--grh-space-4);
    border-top: 1px solid var(--grh-line);
    padding-top: var(--grh-space-5);
    margin-top: var(--grh-space-4);
  }
  .grh-spread2__facts li {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .grh-spread2__facts strong {
    font-family: var(--grh-font-display);
    font-style: italic;
    font-weight: 400;
    font-size: var(--grh-fs-2xl);
    color: var(--grh-forest-800);
    line-height: 1;
  }
  .grh-spread2__facts span {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--grh-stone-400);
  }

  .grh-spread2__ctas {
    display: flex; flex-wrap: wrap;
    gap: var(--grh-space-3);
    margin-top: var(--grh-space-4);
  }
</style>
