---
type Tone = 'cream' | 'paper' | 'sage' | 'sandstone' | 'forest' | 'forest-deep';
type Pattern = 'topo' | 'chess' | 'rule' | 'none';
interface Props {
  tone?: Tone;
  pattern?: Pattern;
  padding?: 'sm' | 'md' | 'lg';
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  id?: string;
  align?: 'left' | 'center';
}
const {
  tone = 'cream',
  pattern = 'none',
  padding = 'lg',
  eyebrow,
  title,
  subtitle,
  id,
  align = 'left',
} = Astro.props;
---
<section
  class={`grh-section grh-section-tone-${tone} grh-section--pad-${padding} grh-section--align-${align}`}
  data-pattern={pattern}
  id={id}
>
  {pattern !== 'none' && (
    <div class="grh-section__pattern" aria-hidden="true">
      {pattern === 'topo' && (
        <svg viewBox="0 0 1200 400" preserveAspectRatio="xMidYMid slice">
          <path d="M-50 60 C 200 20, 500 100, 1250 40"  fill="none" stroke="currentColor" stroke-width="0.8" />
          <path d="M-50 130 C 220 90, 540 180, 1250 110" fill="none" stroke="currentColor" stroke-width="0.8" />
          <path d="M-50 210 C 240 170, 580 270, 1250 200" fill="none" stroke="currentColor" stroke-width="0.8" />
          <path d="M-50 300 C 260 250, 620 360, 1250 290" fill="none" stroke="currentColor" stroke-width="0.8" />
        </svg>
      )}
      {pattern === 'chess' && (
        <svg viewBox="0 0 800 40" preserveAspectRatio="none">
          {Array.from({ length: 40 }).map((_, i) => (
            i % 2 === 0 && <rect x={i * 20} y={0} width="20" height="20" />
          ))}
          {Array.from({ length: 40 }).map((_, i) => (
            i % 2 === 1 && <rect x={i * 20} y={20} width="20" height="20" />
          ))}
        </svg>
      )}
      {pattern === 'rule' && (
        <svg viewBox="0 0 1200 4" preserveAspectRatio="none">
          <line x1="0" y1="2" x2="1200" y2="2" stroke="currentColor" stroke-width="1" />
        </svg>
      )}
    </div>
  )}

  <div class="grh-container grh-section__inner">
    {(eyebrow || title || subtitle) && (
      <header class="grh-section__head grh-reveal">
        {eyebrow && <span class="grh-eyebrow">{eyebrow}</span>}
        {title && <h2 class="grh-section__title">{title}</h2>}
        {subtitle && <p class="grh-section__subtitle">{subtitle}</p>}
      </header>
    )}
    <div class="grh-section__content">
      <slot />
    </div>
    {Astro.slots.has('cta') && (
      <div class="grh-section__cta grh-reveal">
        <slot name="cta" />
      </div>
    )}
  </div>
</section>

<style>
  .grh-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  .grh-section--pad-sm { padding-block: var(--grh-space-7); }
  .grh-section--pad-md { padding-block: var(--grh-space-8); }
  .grh-section--pad-lg { padding-block: var(--grh-space-9); }

  .grh-section__pattern {
    position: absolute;
    pointer-events: none;
    color: currentColor;
    z-index: 0;
  }
  .grh-section[data-pattern="topo"] .grh-section__pattern {
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--grh-forest-700);
    opacity: 0.07;
  }
  .grh-section[data-pattern="topo"] .grh-section__pattern svg { width: 100%; height: 100%; }
  .grh-section.grh-section-tone-forest[data-pattern="topo"] .grh-section__pattern,
  .grh-section.grh-section-tone-forest-deep[data-pattern="topo"] .grh-section__pattern {
    color: var(--grh-cream-50);
    opacity: 0.06;
  }
  .grh-section[data-pattern="chess"] .grh-section__pattern {
    inset: auto 0 0 0;
    width: 100%;
    height: 6px;
    color: var(--grh-wood-500);
    opacity: 0.6;
  }
  .grh-section[data-pattern="chess"] .grh-section__pattern svg { width: 100%; height: 6px; }
  .grh-section[data-pattern="rule"] .grh-section__pattern {
    inset: 0 0 auto 0;
    width: 100%;
    height: 1px;
    color: var(--grh-line);
    opacity: 1;
  }

  .grh-section__inner {
    position: relative;
    z-index: 1;
  }
  .grh-section--align-center .grh-section__head { text-align: center; max-width: 720px; margin-inline: auto; }

  .grh-section__head {
    display: flex;
    flex-direction: column;
    gap: var(--grh-space-3);
    margin-bottom: var(--grh-space-7);
    max-width: 760px;
  }
  .grh-section__title {
    font-size: var(--grh-fs-3xl);
    line-height: 1.15;
  }
  @media (min-width: 768px) {
    .grh-section__title { font-size: var(--grh-fs-4xl); }
  }
  .grh-section__subtitle {
    font-size: var(--grh-fs-md);
    color: inherit;
    opacity: 0.85;
    max-width: 60ch;
    line-height: var(--grh-lh-normal);
  }
  .grh-section__cta {
    margin-top: var(--grh-space-7);
    display: flex;
    flex-wrap: wrap;
    gap: var(--grh-space-3);
  }
  .grh-section--align-center .grh-section__cta { justify-content: center; }
</style>
