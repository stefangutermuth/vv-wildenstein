---
import GrhIcon from '../primitives/GrhIcon.astro';

interface Item { title: string; image: string; href: string }
const items: Item[] = [
  { title: 'Freibad', image: '/images/tourism/teaser-freibad.jpg', href: '/tourismus/freibad-borstendorf' },
  { title: 'Gaststätte / Pension Waldhof', image: '/images/tourism/teaser-waldhof.jpg', href: '/tourismus/gaststaette-pension-waldhof' },
  { title: 'Ferienwohnung Schwarzmühle', image: '/images/tourism/teaser-schwarzmuehle.jpg', href: '/tourismus/ferienwohnung-schwarzmuehle' },
  { title: 'Ferienwohnung Familie Gleß', image: '/images/tourism/teaser-gless.jpg', href: '/tourismus/ferienwohnung-familie-gless' },
];
---
<section class="grh-tour">
  <div class="grh-container">
    <header class="grh-tour__head">
      <div class="grh-tour__intro">
        <span class="grh-eyebrow">Erleben &amp; Entdecken</span>
        <h2 class="grh-tour__title">Zwischen Wald &amp; Weitblick</h2>
        <p class="grh-tour__text">
          Ob Wandern im Bornwald, ein Spaziergang durch den Ort oder stille Momente an
          der Talsperre – in Börnichen findest du Natur, Geschichte und Erholung auf
          kleinstem Raum.
        </p>
      </div>
      <a href="/tourismus" class="grh-tour__more">
        Mehr entdecken <GrhIcon name="arrow-right" size={16} />
      </a>
    </header>

    <div class="grh-tour__grid">
      {items.map((i) => (
        <a class="grh-tour__card" href={i.href}>
          <img src={i.image} alt={i.title} loading="lazy" decoding="async" />
          <span class="grh-tour__card-scrim" aria-hidden="true"></span>
          <span class="grh-tour__card-title">{i.title}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .grh-tour {
    background: var(--grh-cream-50);
    padding-block: var(--grh-space-9);
  }
  .grh-tour__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--grh-space-5);
    margin-bottom: var(--grh-space-7);
  }
  .grh-tour__intro { max-width: 60ch; }
  .grh-tour__title {
    font-family: var(--grh-font-display);
    font-size: clamp(1.9rem, 3.6vw, 2.8rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: #1c2a5e;
    background: linear-gradient(100deg, #1c2a5e 0%, #211b46 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    margin: 6px 0 var(--grh-space-3);
  }
  .grh-tour__text {
    font-size: var(--grh-fs-md);
    line-height: 1.6;
    color: var(--grh-text-muted);
    margin: 0;
  }
  .grh-tour__more {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 22px;
    border-radius: var(--grh-radius-pill);
    background: var(--grh-candle-500);
    color: var(--grh-forest-950);
    font-size: var(--grh-fs-sm);
    font-weight: 700;
    text-decoration: none;
    transition: transform var(--grh-dur-fast), filter var(--grh-dur-fast);
  }
  .grh-tour__more:hover { transform: translateY(-2px); filter: brightness(1.05); }

  .grh-tour__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--grh-space-4);
  }
  @media (max-width: 900px) { .grh-tour__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .grh-tour__grid { grid-template-columns: 1fr; } }

  .grh-tour__card {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    border-radius: 18px 18px 56px 18px;
    overflow: hidden;
    text-decoration: none;
    box-shadow: var(--grh-shadow-md);
  }
  .grh-tour__card img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--grh-ease-out);
  }
  .grh-tour__card:hover img { transform: scale(1.06); }
  .grh-tour__card-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(18, 28, 22, 0.82) 0%, rgba(18, 28, 22, 0.1) 48%, transparent 70%);
  }
  .grh-tour__card-title {
    position: absolute;
    left: var(--grh-space-4);
    right: var(--grh-space-4);
    bottom: var(--grh-space-4);
    color: #fff;
    font-family: var(--grh-font-display);
    font-size: var(--grh-fs-md);
    font-weight: 500;
    line-height: 1.2;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.4);
  }
</style>
