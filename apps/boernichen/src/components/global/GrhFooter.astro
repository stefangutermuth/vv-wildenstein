---
import GrhWappen from './GrhWappen.astro';
import { navigation } from '../../lib/navigation';

/* Rechtslinks wie auf boernichen.de */
const legal: Array<[string, string]> = [
  ['Impressum', '/impressum'],
  ['Datenschutzerklärung', '/datenschutz'],
  ['Cookie-Richtlinie (EU)', '/cookie-richtlinie'],
];

/* Footer-Navigation = oberste Menü-Ebene */
const navLinks = navigation.map((n) => [n.label, n.href] as [string, string]);
---
<footer class="grh-footer">
  <div class="grh-container grh-footer__inner">
    {/* Links: Wappen + Copyright */}
    <div class="grh-footer__brand">
      <GrhWappen size={150} />
      <span class="grh-footer__copy">© Gemeinde Börnichen/Erzg.</span>
    </div>

    {/* Mitte: Rechtliches */}
    <nav class="grh-footer__links" aria-label="Rechtliches">
      <ul>
        {legal.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </nav>

    {/* Rechts: Navigation */}
    <nav class="grh-footer__links" aria-label="Footer-Navigation">
      <ul>
        {navLinks.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </nav>
  </div>

  {/* Heller Förderstreifen */}
  <div class="grh-footer__funding">
    <div class="grh-container grh-footer__funding-inner">
      <p class="grh-footer__funding-text">
        Diese Maßnahme wird mitfinanziert durch Steuermittel auf der Grundlage des
        vom Sächsischen Landtag beschlossenen Haushaltes.
      </p>
      <img
        class="grh-footer__funding-logos"
        src="/images/partner/foerderung-logos.svg"
        alt="Freistaat Sachsen · ASSKomm – Allianz Sichere Sächsische Kommunen · Landespräventionsrat Sachsen"
        width="319"
        height="61"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</footer>

<style>
  /* === Dunkles Indigo-Band ================================= */
  .grh-footer {
    background:
      radial-gradient(120% 140% at 0% 0%, rgba(94, 84, 160, 0.22), transparent 55%),
      linear-gradient(180deg, #1c1840 0%, #181334 100%);
    color: var(--grh-cream-50);
  }

  .grh-footer__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--grh-space-7);
    padding-block: var(--grh-space-9) var(--grh-space-8);
  }
  @media (min-width: 820px) {
    .grh-footer__inner {
      grid-template-columns: auto 1fr auto;
      gap: var(--grh-space-9);
      align-items: start;
    }
  }

  /* Wappen + Copyright */
  .grh-footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--grh-space-4);
  }
  .grh-footer__brand :global(.grh-wappen) {
    filter: drop-shadow(0 6px 22px rgba(0, 0, 0, 0.45));
  }
  .grh-footer__copy {
    font-size: var(--grh-fs-sm);
    color: var(--grh-cream-50);
    opacity: 0.75;
  }

  /* Link-Spalten (Rechtliches + Navigation) */
  .grh-footer__links ul {
    display: flex;
    flex-direction: column;
    gap: var(--grh-space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 820px) {
    /* Navigation rechtsbündig wie im Original */
    .grh-footer__links:last-of-type ul { align-items: flex-end; }
  }
  .grh-footer__links a {
    font-family: var(--grh-font-display);
    font-size: var(--grh-fs-md);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--grh-cream-50);
    text-decoration: none;
    opacity: 0.9;
    transition: color var(--grh-dur-fast), opacity var(--grh-dur-fast);
  }
  .grh-footer__links a:hover {
    opacity: 1;
    color: var(--grh-candle-300);
  }

  /* === Heller Förderstreifen =============================== */
  .grh-footer__funding {
    background: #f1f0f8;
    color: #2a2540;
  }
  .grh-footer__funding-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--grh-space-5);
    padding-block: var(--grh-space-6);
    text-align: center;
  }
  @media (min-width: 820px) {
    .grh-footer__funding-inner {
      flex-direction: row;
      justify-content: center;
      gap: var(--grh-space-8);
      text-align: left;
    }
  }
  .grh-footer__funding-text {
    margin: 0;
    max-width: 34ch;
    font-size: var(--grh-fs-sm);
    line-height: 1.55;
    color: #4a4560;
  }
  .grh-footer__funding-logos {
    width: 100%;
    max-width: 440px;
    height: auto;
  }
</style>
