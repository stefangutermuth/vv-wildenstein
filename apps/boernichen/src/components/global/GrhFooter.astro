---
import GrhWappen from './GrhWappen.astro';
import { navigation } from '../../lib/navigation';

/* Rechtslinks */
const legal: Array<[string, string]> = [
  ['Impressum', '/impressum'],
  ['Datenschutzerklärung', '/datenschutz'],
  ['Cookie-Richtlinie (EU)', '/cookie-richtlinie'],
];

/* Footer-Navigation = oberste Menü-Ebene */
const navLinks = navigation.map((n) => [n.label, n.href] as [string, string]);
---
<footer class="grh-footer">
  <div class="grh-container grh-footer__inner">
    {/* Marke + Kontakt */}
    <div class="grh-footer__brand">
      <div class="grh-footer__brand-top">
        <GrhWappen size={84} />
        <span class="grh-footer__wordmark">
          <span class="grh-footer__name">Börnichen</span>
          <span class="grh-footer__sub">Erzgebirge · Sachsen</span>
        </span>
      </div>
      <address class="grh-footer__contact">
        Gemeindeverwaltung Börnichen/Erzgeb.<br />
        Rathausstraße 6 · 09437 Börnichen/Erzgeb.<br />
        Tel. <a href="tel:+49372941225">037294 1225</a><br />
        <a href="mailto:rathaus@boernichen.de">rathaus@boernichen.de</a>
      </address>
      <span class="grh-footer__copy">© Gemeinde Börnichen/Erzgeb. · im Verwaltungsverband Wildenstein</span>
    </div>

    {/* Navigation */}
    <nav class="grh-footer__col" aria-label="Footer-Navigation">
      <h2 class="grh-footer__heading">Navigation</h2>
      <ul>
        {navLinks.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </nav>

    {/* Rechtliches */}
    <nav class="grh-footer__col" aria-label="Rechtliches">
      <h2 class="grh-footer__heading">Rechtliches</h2>
      <ul>
        {legal.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </nav>
  </div>

  {/* Heller Förderstreifen */}
  <div class="grh-footer__funding">
    <div class="grh-container grh-footer__funding-inner">
      <p class="grh-footer__funding-text">
        Diese Maßnahme wird mitfinanziert durch Steuermittel auf der Grundlage des
        vom Sächsischen Landtag beschlossenen Haushaltes.
      </p>
      <img
        class="grh-footer__funding-logos"
        src="/images/partner/foerderung-logos.svg"
        alt="Freistaat Sachsen · ASSKomm – Allianz Sichere Sächsische Kommunen · Landespräventionsrat Sachsen"
        width="319"
        height="61"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</footer>

<style>
  /* === Dunkles Indigo-Band ================================= */
  .grh-footer {
    background:
      radial-gradient(120% 140% at 0% 0%, rgba(94, 84, 160, 0.22), transparent 55%),
      linear-gradient(180deg, #1c1840 0%, #181334 100%);
    color: var(--grh-cream-50);
  }

  .grh-footer__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--grh-space-7);
    padding-block: var(--grh-space-9) var(--grh-space-8);
  }
  @media (min-width: 820px) {
    .grh-footer__inner {
      grid-template-columns: 1.5fr 1fr 1fr;
      gap: var(--grh-space-8);
      align-items: start;
    }
  }

  /* --- Marke + Kontakt --- */
  .grh-footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--grh-space-4);
    max-width: 42ch;
  }
  .grh-footer__brand-top {
    display: flex;
    align-items: center;
    gap: var(--grh-space-4);
  }
  .grh-footer__brand-top :global(.grh-wappen) {
    filter: drop-shadow(0 6px 22px rgba(0, 0, 0, 0.45));
    flex-shrink: 0;
  }
  .grh-footer__wordmark { display: flex; flex-direction: column; line-height: 1.1; }
  .grh-footer__name {
    font-family: var(--grh-font-display);
    font-size: 1.7rem;
    font-weight: 500;
    color: var(--grh-cream-50);
    letter-spacing: -0.02em;
  }
  .grh-footer__sub {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--grh-candle-300);
    font-weight: 600;
    margin-top: 4px;
  }
  .grh-footer__contact {
    font-style: normal;
    font-size: var(--grh-fs-sm);
    line-height: 1.7;
    color: var(--grh-cream-50);
    opacity: 0.82;
  }
  .grh-footer__contact a { color: inherit; text-decoration: none; }
  .grh-footer__contact a:hover { color: var(--grh-candle-300); }
  .grh-footer__copy {
    font-size: var(--grh-fs-xs);
    color: var(--grh-cream-50);
    opacity: 0.6;
  }

  /* --- Link-Spalten --- */
  .grh-footer__heading {
    font-family: var(--grh-font-body);
    font-size: var(--grh-fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 700;
    color: var(--grh-candle-300);
    margin: 0 0 var(--grh-space-4);
    opacity: 0.85;
  }
  .grh-footer__col ul {
    display: flex;
    flex-direction: column;
    gap: var(--grh-space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .grh-footer__col a {
    font-family: var(--grh-font-display);
    font-size: var(--grh-fs-md);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--grh-cream-50);
    text-decoration: none;
    opacity: 0.9;
    transition: color var(--grh-dur-fast), opacity var(--grh-dur-fast);
  }
  .grh-footer__col a:hover { opacity: 1; color: var(--grh-candle-300); }

  /* === Heller Förderstreifen =============================== */
  .grh-footer__funding {
    background: #f1f0f8;
    color: #2a2540;
  }
  .grh-footer__funding-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--grh-space-5);
    padding-block: var(--grh-space-6);
    text-align: center;
  }
  @media (min-width: 820px) {
    .grh-footer__funding-inner {
      flex-direction: row;
      justify-content: center;
      gap: var(--grh-space-8);
      text-align: left;
    }
  }
  .grh-footer__funding-text {
    margin: 0;
    max-width: 34ch;
    font-size: var(--grh-fs-sm);
    line-height: 1.55;
    color: #4a4560;
  }
  .grh-footer__funding-logos {
    width: 100%;
    max-width: 440px;
    height: auto;
  }
</style>
