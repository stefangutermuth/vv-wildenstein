---
import GrhPage from '../layouts/GrhPage.astro';
import GrhIcon from '../components/primitives/GrhIcon.astro';
import { getEvents } from '../lib/cms';

const events = await getEvents();

const fmtWeekday = new Intl.DateTimeFormat('de-DE', { weekday: 'long' });
const fmtDate = new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: 'long', year: 'numeric' });
const fmtTime = new Intl.DateTimeFormat('de-DE', { hour: '2-digit', minute: '2-digit' });
const fmtDay = new Intl.DateTimeFormat('de-DE', { day: '2-digit' });
const fmtMon = (d: Date) => new Intl.DateTimeFormat('de-DE', { month: 'short' }).format(d).replace('.', '');
const isExternal = (h: string) => /^https?:/i.test(h);
---
<GrhPage
  title="Veranstaltungen"
  eyebrow="Kalender"
  description="Veranstaltungen und Termine in Börnichen/Erzgeb. — Feste, Konzerte und Gemeindeleben."
  wide
>
  {events.length === 0 ? (
    <p class="grh-evp__empty">
      Aktuell sind keine Termine eingetragen. Schauen Sie bald wieder vorbei —
      neue Veranstaltungen werden hier laufend ergänzt.
    </p>
  ) : (
    <ul class="grh-evp__list">
      {events.map((e) => (
        <li class="grh-evp__item">
          <a
            class="grh-evp__link"
            href={e.href}
            {...(isExternal(e.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            <span class="grh-evp__date" aria-hidden="true">
              <span class="grh-evp__day">{fmtDay.format(e.startDate)}</span>
              <span class="grh-evp__mon">{fmtMon(e.startDate)}</span>
            </span>
            <span class="grh-evp__body">
              <time class="grh-evp__when" datetime={e.startDate.toISOString()}>
                {fmtWeekday.format(e.startDate)}, {fmtDate.format(e.startDate)} · {fmtTime.format(e.startDate)} Uhr
              </time>
              <strong class="grh-evp__title">{e.title}</strong>
              {e.location && (
                <span class="grh-evp__loc"><GrhIcon name="map-pin" size={14} /> {e.location}</span>
              )}
              {e.teaser && <span class="grh-evp__teaser">{e.teaser}</span>}
            </span>
            <span class="grh-evp__arrow" aria-hidden="true"><GrhIcon name="arrow-right" size={18} /></span>
          </a>
        </li>
      ))}
    </ul>
  )}
</GrhPage>

<style>
  .grh-evp__empty {
    font-size: var(--grh-fs-md);
    color: var(--grh-text-muted);
    background: var(--grh-bg-elevated);
    border: 1px solid var(--grh-border);
    border-radius: 18px 18px 40px 18px;
    padding: var(--grh-space-6);
    margin: 0;
  }

  .grh-evp__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--grh-space-4);
  }

  .grh-evp__link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--grh-space-5);
    padding: var(--grh-space-5);
    background: #fff;
    border: 1px solid var(--grh-border);
    border-radius: 18px 18px 44px 18px;
    text-decoration: none;
    color: inherit;
    box-shadow: var(--grh-shadow-sm);
    transition: border-color var(--grh-dur-fast), box-shadow var(--grh-dur-fast);
  }
  .grh-evp__link:hover {
    border-color: var(--grh-candle-500);
    box-shadow: var(--grh-shadow-md);
  }

  .grh-evp__date {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    border-radius: 14px 14px 28px 14px;
    background: linear-gradient(135deg, #1c2a5e 0%, #211b46 100%);
    color: #fff;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }
  .grh-evp__day { font-family: var(--grh-font-body); font-weight: 800; font-size: 1.7rem; }
  .grh-evp__mon { font-size: var(--grh-fs-xs); text-transform: uppercase; letter-spacing: 0.08em; margin-top: 4px; }

  .grh-evp__body { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .grh-evp__when { font-size: var(--grh-fs-sm); color: var(--grh-candle-500); font-weight: 600; }
  .grh-evp__title {
    font-family: var(--grh-font-display);
    font-size: var(--grh-fs-lg);
    font-weight: 500;
    color: var(--grh-text-heading);
    line-height: 1.25;
  }
  .grh-evp__loc {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--grh-fs-sm);
    color: var(--grh-text-muted);
  }
  .grh-evp__teaser {
    font-size: var(--grh-fs-sm);
    color: var(--grh-text-muted);
    line-height: 1.5;
    margin-top: 2px;
  }

  .grh-evp__arrow {
    flex-shrink: 0;
    color: var(--grh-text-muted);
    transition: transform var(--grh-dur-fast), color var(--grh-dur-fast);
  }
  .grh-evp__link:hover .grh-evp__arrow { color: var(--grh-candle-500); transform: translateX(3px); }

  @media (max-width: 560px) {
    .grh-evp__link { grid-template-columns: auto 1fr; gap: var(--grh-space-4); padding: var(--grh-space-4); }
    .grh-evp__arrow { display: none; }
    .grh-evp__date { width: 60px; height: 60px; }
    .grh-evp__day { font-size: 1.4rem; }
  }
</style>
