---
import GrhPage from '../layouts/GrhPage.astro';
import GrhIcon from '../components/primitives/GrhIcon.astro';

const ABFALLKALENDER = 'https://www.erzgebirgskreis.de/landratsamt-service/sonstiges/abfallkalender';

interface Tonne { name: string; rhythm: string; note?: string }
const tonnen: Tonne[] = [
  {
    name: 'Restabfall',
    rhythm: '14-täglich mittwochs · ungerade Kalenderwoche',
    note: 'Sondertour (Hauptstr. 30A, Huthain, Schwarzmühle, Siedlung 25/27/29): 14-täglich donnerstags, ungerade KW.',
  },
  {
    name: 'Biotonne',
    rhythm: '14-täglich donnerstags · gerade Kalenderwoche',
    note: 'Abfuhr im 2-Schicht-System – Behälter bitte ganztägig bis zur Leerung bereitstellen.',
  },
  {
    name: 'Blaue Tonne (Papier)',
    rhythm: '4-wöchentlich mittwochs',
    note: 'Für Huthain, Schwarzmühle & Siedlung 25/27/29 gilt eine abweichende Sondertour.',
  },
  {
    name: 'Gelbe Tonne',
    rhythm: '14-täglich montags · ungerade Kalenderwoche',
  },
];
---
<GrhPage
  title="Termine"
  eyebrow="Gemeinde"
  description="Abfuhrrhythmen und Entsorgungstermine in Börnichen/Erzgeb. — mit Link zum tagesaktuellen Abfallkalender."
  wide
>
  <p class="grh-tm__intro">
    Hier finden Sie die regelmäßigen Abfuhrrhythmen der einzelnen Tonnen in Börnichen/Erzgeb.
    Die konkreten Abfuhrtermine – straßengenau und stets aktuell – stellt der Erzgebirgskreis
    in seinem Abfallkalender bereit.
  </p>

  <!-- Live-Quelle -->
  <a class="grh-tm__cta" href={ABFALLKALENDER} target="_blank" rel="noopener noreferrer">
    <span class="grh-tm__cta-icon" aria-hidden="true"><GrhIcon name="calendar" size={26} /></span>
    <span class="grh-tm__cta-text">
      <strong>Zum Abfallkalender des Erzgebirgskreises</strong>
      <span>Konkrete Abfuhrtermine für Ihre Straße – als Kalender und zum Download.</span>
    </span>
    <span class="grh-tm__cta-arrow" aria-hidden="true"><GrhIcon name="arrow-right" size={20} /></span>
  </a>

  <!-- Abfuhrrhythmen -->
  <h2 class="grh-tm__h2">Abfuhrrhythmen</h2>
  <div class="grh-tm__grid">
    {tonnen.map((t) => (
      <article class="grh-tm__card">
        <span class="grh-tm__card-icon" aria-hidden="true"><GrhIcon name="calendar" size={20} /></span>
        <h3 class="grh-tm__card-title">{t.name}</h3>
        <p class="grh-tm__rhythm">{t.rhythm}</p>
        {t.note && <p class="grh-tm__note">{t.note}</p>}
      </article>
    ))}
  </div>

  <!-- Weitere Entsorgung -->
  <h2 class="grh-tm__h2">Weitere Entsorgung</h2>
  <div class="grh-tm__grid grh-tm__grid--two">
    <article class="grh-tm__card">
      <span class="grh-tm__card-icon" aria-hidden="true"><GrhIcon name="phone" size={20} /></span>
      <h3 class="grh-tm__card-title">Fäkalienabfuhr</h3>
      <p class="grh-tm__rhythm">Fa. Umtech, Mittweidaer Str. 1, 09306 Erlau</p>
      <p class="grh-tm__note">
        Telefon <a href="tel:+493727621831">03727 621831</a>. Sind Sie zum Termin verhindert,
        vereinbaren Sie bitte telefonisch einen neuen Termin.
      </p>
    </article>
    <article class="grh-tm__card">
      <span class="grh-tm__card-icon" aria-hidden="true"><GrhIcon name="document" size={20} /></span>
      <h3 class="grh-tm__card-title">Elektroschrott</h3>
      <p class="grh-tm__note">
        Elektroschrott darf <strong>nicht</strong> auf dem Festplatz abgelagert werden. Die Entsorgung
        erfolgt über die gesetzliche Hersteller-Rücknahme oder kostenfrei an den Wertstoffhöfen
        des Erzgebirgskreises.
      </p>
    </article>
  </div>
</GrhPage>

<style>
  .grh-tm__intro { font-size: var(--grh-fs-md); line-height: 1.6; color: var(--grh-text); max-width: 70ch; margin: var(--grh-space-6) 0 0; }

  /* Live-Quelle CTA */
  .grh-tm__cta {
    display: flex;
    align-items: center;
    gap: var(--grh-space-5);
    margin-top: var(--grh-space-6);
    padding: var(--grh-space-5) var(--grh-space-6);
    border-radius: 22px 22px 48px 22px;
    background:
      radial-gradient(120% 140% at 10% 0%, rgba(120, 150, 220, 0.20), transparent 55%),
      linear-gradient(115deg, #1c2a5e 0%, #211b46 100%);
    color: var(--grh-cream-50);
    text-decoration: none;
    transition: transform var(--grh-dur-fast), box-shadow var(--grh-dur-fast);
  }
  .grh-tm__cta:hover { transform: translateY(-2px); box-shadow: var(--grh-shadow-lg); }
  .grh-tm__cta-icon {
    display: inline-grid; place-items: center;
    width: 54px; height: 54px; flex-shrink: 0;
    border-radius: 14px 14px 24px 14px;
    background: var(--grh-candle-500); color: var(--grh-forest-950);
  }
  .grh-tm__cta-text { display: flex; flex-direction: column; gap: 3px; flex: 1; min-width: 0; }
  .grh-tm__cta-text strong { font-family: var(--grh-font-display); font-weight: 500; font-size: var(--grh-fs-lg); }
  .grh-tm__cta-text span { font-size: var(--grh-fs-sm); opacity: 0.9; }
  .grh-tm__cta-arrow { flex-shrink: 0; color: var(--grh-candle-300); transition: transform var(--grh-dur-fast); }
  .grh-tm__cta:hover .grh-tm__cta-arrow { transform: translateX(3px); }

  .grh-tm__h2 {
    font-family: var(--grh-font-display);
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    font-weight: 500;
    color: var(--grh-text-heading);
    margin: var(--grh-space-8) 0 var(--grh-space-4);
  }

  .grh-tm__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--grh-space-4);
  }
  .grh-tm__grid--two { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }

  .grh-tm__card {
    background: #fff;
    border: 1px solid #ddd9ef;
    border-radius: 18px 18px 44px 18px;
    padding: var(--grh-space-5);
    box-shadow: 0 1px 2px rgba(28, 24, 64, 0.04);
  }
  .grh-tm__card-icon {
    display: inline-grid; place-items: center;
    width: 42px; height: 42px;
    border-radius: 12px 12px 20px 12px;
    background: var(--grh-sage-100); color: var(--grh-forest-800);
    margin-bottom: var(--grh-space-3);
  }
  .grh-tm__card-title {
    font-family: var(--grh-font-display);
    font-size: var(--grh-fs-md);
    font-weight: 500;
    color: var(--grh-text-heading);
    margin: 0 0 6px;
  }
  .grh-tm__rhythm { font-weight: 700; color: var(--grh-forest-800); font-size: var(--grh-fs-sm); margin: 0; line-height: 1.4; }
  .grh-tm__note { font-size: var(--grh-fs-sm); color: var(--grh-text-muted); line-height: 1.55; margin: var(--grh-space-2) 0 0; }
  .grh-tm__note a { color: var(--grh-link); font-weight: 600; text-decoration: none; }
  .grh-tm__note a:hover { text-decoration: underline; }
</style>
