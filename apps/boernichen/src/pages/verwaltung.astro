---
import GrhPage from '../layouts/GrhPage.astro';
import GrhIcon from '../components/primitives/GrhIcon.astro';

interface Service { label: string; desc: string; href: string; icon: string }
const services: Service[] = [
  { label: 'Satzungen, Verordnungen & Anträge', desc: 'Dokumente des Verwaltungsverbands', href: 'https://vv-wildenstein.com/', icon: 'document' },
  { label: 'Amtsblatt VV Wildenstein',          desc: 'Amtliche Bekanntmachungen',        href: 'https://vv-wildenstein.com/amtsblatt/', icon: 'document' },
  { label: 'Amtsblatt Erzgebirgskreis',         desc: 'Aktuelles → Amtsblatt',             href: 'https://www.erzgebirgskreis.de', icon: 'document' },
  { label: 'Amt24 Sachsen',                     desc: 'Behördengänge online erledigen',    href: 'https://amt24.sachsen.de', icon: 'building' },
  { label: 'Führungszeugnis online',            desc: 'Bundesamt für Justiz (BfJ)',        href: 'https://www.fuehrungszeugnis.bund.de', icon: 'user' },
  { label: 'Abfallwirtschaft (ZAS)',            desc: 'Zweckverband Südwestsachsen',       href: 'http://www.za-sws.de/index_erz.cfm', icon: 'building' },
];
---
<GrhPage
  title="Verwaltung"
  eyebrow="Gemeinde"
  description="Gemeindeverwaltung Börnichen/Erzgeb. — Kontakt, Sprechzeiten und Online-Dienste im Verwaltungsverband Wildenstein."
  wide
>
  <!-- ===== Kontakt & Sprechzeiten ===== -->
  <div class="grh-vw__grid">
    <article class="grh-vw__card grh-vw__card--hours">
      <span class="grh-vw__icon" aria-hidden="true"><GrhIcon name="clock" size={22} /></span>
      <h2 class="grh-vw__card-title">Öffnungszeiten</h2>
      <dl class="grh-vw__hours">
        <div>
          <dt>Donnerstag</dt>
          <dd>08:00–12:00 &amp; 13:00–18:00 Uhr</dd>
        </div>
        <div>
          <dt>Bürgermeister­sprechstunde</dt>
          <dd>Donnerstag 16:00–19:00 Uhr</dd>
        </div>
      </dl>
      <p class="grh-vw__note">Weitere Termine gern nach Vereinbarung.</p>
    </article>

    <article class="grh-vw__card">
      <span class="grh-vw__icon" aria-hidden="true"><GrhIcon name="building" size={22} /></span>
      <h2 class="grh-vw__card-title">Gemeinde&shy;verwaltung</h2>
      <address class="grh-vw__addr">
        Gemeinde Börnichen/Erzgeb.<br />
        Rathausstraße 6<br />
        09437 Börnichen/Erzgeb.
      </address>
      <ul class="grh-vw__contact">
        <li><GrhIcon name="phone" size={16} /> <a href="tel:+49372941225">+49 37294 1225</a></li>
        <li><GrhIcon name="document" size={16} /> <span>Fax: +49 37294 1619</span></li>
      </ul>
    </article>

    <article class="grh-vw__card">
      <span class="grh-vw__icon" aria-hidden="true"><GrhIcon name="user" size={22} /></span>
      <h2 class="grh-vw__card-title">Ihre Ansprechpartner</h2>
      <ul class="grh-vw__people">
        <li><strong>Martin Trinks</strong><span>Bürgermeister</span></li>
        <li><strong>Kathleen Hunger</strong><span>Gemeindebüro</span></li>
      </ul>
    </article>
  </div>

  <!-- ===== Verwaltungsverband Wildenstein ===== -->
  <section class="grh-vw__band">
    <div class="grh-vw__band-text">
      <span class="grh-eyebrow grh-vw__band-eyebrow">Gemeinsame Verwaltung</span>
      <h2 class="grh-vw__band-title">Verwaltungsverband Wildenstein</h2>
      <p>
        Börnichen/Erzgeb. erfüllt seine Verwaltungsaufgaben gemeinsam mit der Gemeinde
        Grünhainichen im Verwaltungsverband Wildenstein. Der Sitz der Verbandsverwaltung
        befindet sich in Grünhainichen.
      </p>
    </div>
    <ul class="grh-vw__band-contact">
      <li><GrhIcon name="map-pin" size={18} /> <span>Chemnitzer Straße 41<br />09579 Grünhainichen</span></li>
      <li><GrhIcon name="phone" size={18} /> <a href="tel:+49372941700">+49 37294 1700</a></li>
      <li><GrhIcon name="document" size={18} /> <span>Fax: +49 37294 1721</span></li>
    </ul>
  </section>

  <!-- ===== Online-Dienste & Dokumente ===== -->
  <section class="grh-vw__services">
    <h2 class="grh-vw__h2">Online-Dienste &amp; Dokumente</h2>
    <div class="grh-vw__links">
      {services.map((s) => (
        <a class="grh-vw__link" href={s.href} target="_blank" rel="noopener noreferrer">
          <span class="grh-vw__link-icon" aria-hidden="true"><GrhIcon name={s.icon} size={20} /></span>
          <span class="grh-vw__link-text">
            <strong>{s.label}</strong>
            <span>{s.desc}</span>
          </span>
          <span class="grh-vw__link-arrow" aria-hidden="true"><GrhIcon name="arrow-right" size={18} /></span>
        </a>
      ))}
    </div>
  </section>
</GrhPage>

<style>
  /* ===== Kontakt-Karten ===== */
  .grh-vw__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--grh-space-5);
    margin-top: var(--grh-space-7);
  }
  .grh-vw__card {
    background: #fff;
    border: 1px solid #ddd9ef;
    border-radius: 22px 22px 56px 22px;
    padding: var(--grh-space-6);
    box-shadow: 0 1px 2px rgba(28, 24, 64, 0.04);
  }
  .grh-vw__card--hours {
    background: linear-gradient(150deg, #f7f9ec 0%, #eef2da 100%);
    border-color: #d7de8b;
  }
  .grh-vw__icon {
    display: inline-grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 13px 13px 22px 13px;
    background: var(--grh-sage-100);
    color: var(--grh-forest-800);
    margin-bottom: var(--grh-space-4);
  }
  .grh-vw__card--hours .grh-vw__icon { background: var(--grh-candle-500); color: var(--grh-forest-950); }
  .grh-vw__card-title {
    font-family: var(--grh-font-display);
    font-size: var(--grh-fs-lg);
    font-weight: 500;
    color: var(--grh-text-heading);
    margin: 0 0 var(--grh-space-3);
  }

  .grh-vw__hours { margin: 0; display: flex; flex-direction: column; gap: var(--grh-space-3); }
  .grh-vw__hours dt { font-weight: 700; color: var(--grh-text-heading); font-size: var(--grh-fs-sm); }
  .grh-vw__hours dd { margin: 2px 0 0; color: var(--grh-text); }
  .grh-vw__note { margin: var(--grh-space-4) 0 0; font-size: var(--grh-fs-sm); color: var(--grh-text-muted); }

  .grh-vw__addr { font-style: normal; line-height: 1.6; color: var(--grh-text); margin: 0 0 var(--grh-space-4); }
  .grh-vw__contact { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--grh-space-2); }
  .grh-vw__contact li { display: flex; align-items: center; gap: 10px; color: var(--grh-text); }
  .grh-vw__contact a { color: var(--grh-link); text-decoration: none; font-weight: 600; }
  .grh-vw__contact a:hover { text-decoration: underline; }
  .grh-vw__contact :global(svg) { color: var(--grh-moss-600); flex-shrink: 0; }

  .grh-vw__people { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--grh-space-4); }
  .grh-vw__people li { display: flex; flex-direction: column; }
  .grh-vw__people strong { color: var(--grh-text-heading); font-size: var(--grh-fs-md); }
  .grh-vw__people span { color: var(--grh-text-muted); font-size: var(--grh-fs-sm); }

  /* ===== VV-Wildenstein-Band ===== */
  .grh-vw__band {
    display: grid;
    grid-template-columns: 1.4fr 0.9fr;
    gap: var(--grh-space-7);
    align-items: center;
    margin-top: var(--grh-space-7);
    padding: var(--grh-space-8);
    border-radius: 28px 28px 72px 28px;
    background:
      radial-gradient(120% 120% at 12% 0%, rgba(120, 150, 220, 0.22), transparent 55%),
      linear-gradient(115deg, #1c2a5e 0%, #211b46 100%);
    color: var(--grh-cream-50);
  }
  @media (max-width: 760px) { .grh-vw__band { grid-template-columns: 1fr; gap: var(--grh-space-5); padding: var(--grh-space-6); } }
  .grh-vw__band-eyebrow { color: var(--grh-candle-300); }
  .grh-vw__band-title {
    font-family: var(--grh-font-display);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 500;
    color: var(--grh-cream-50);
    margin: 6px 0 var(--grh-space-3);
  }
  .grh-vw__band p { margin: 0; line-height: 1.6; opacity: 0.9; }
  .grh-vw__band-contact { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--grh-space-3); }
  .grh-vw__band-contact li { display: flex; align-items: flex-start; gap: 12px; line-height: 1.5; }
  .grh-vw__band-contact a { color: var(--grh-cream-50); text-decoration: none; font-weight: 600; }
  .grh-vw__band-contact a:hover { text-decoration: underline; }
  .grh-vw__band-contact :global(svg) { color: var(--grh-candle-300); flex-shrink: 0; margin-top: 2px; }

  /* ===== Online-Dienste ===== */
  .grh-vw__services { margin-top: var(--grh-space-8); }
  .grh-vw__h2 {
    font-family: var(--grh-font-display);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 500;
    color: var(--grh-text-heading);
    margin: 0 0 var(--grh-space-5);
  }
  .grh-vw__links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--grh-space-4);
  }
  .grh-vw__link {
    display: flex;
    align-items: center;
    gap: var(--grh-space-4);
    padding: var(--grh-space-4) var(--grh-space-5);
    background: #fff;
    border: 1px solid #ddd9ef;
    border-radius: 16px 16px 36px 16px;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 1px 2px rgba(28, 24, 64, 0.04);
    transition: border-color var(--grh-dur-fast), box-shadow var(--grh-dur-fast);
  }
  .grh-vw__link:hover { border-color: var(--grh-candle-500); box-shadow: var(--grh-shadow-md); }
  .grh-vw__link-icon {
    display: inline-grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    border-radius: 12px 12px 20px 12px;
    background: var(--grh-sage-100);
    color: var(--grh-forest-800);
  }
  .grh-vw__link-text { display: flex; flex-direction: column; min-width: 0; flex: 1; }
  .grh-vw__link-text strong { color: var(--grh-text-heading); font-size: var(--grh-fs-md); line-height: 1.25; }
  .grh-vw__link-text span { color: var(--grh-text-muted); font-size: var(--grh-fs-sm); }
  .grh-vw__link-arrow { color: var(--grh-text-muted); flex-shrink: 0; transition: transform var(--grh-dur-fast), color var(--grh-dur-fast); }
  .grh-vw__link:hover .grh-vw__link-arrow { color: var(--grh-candle-500); transform: translateX(3px); }
</style>
