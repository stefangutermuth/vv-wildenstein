---
import GrhPage from '../../layouts/GrhPage.astro';
import { getTourismus, type TourismusItem } from '../../lib/cms';

export async function getStaticPaths() {
  const items = await getTourismus();
  return items.map((t) => ({
    params: { ort: t.cptSlug },
    props: { item: t },
  }));
}

interface Props { item: TourismusItem }
const { item } = Astro.props;
const k = item.kontakt ?? {};
const telHref = (t: string) => 'tel:' + t.replace(/[^+\d]/g, '');
const hasKontakt = !!(k.fuehrende_person || k.strasse_hausnummer || k.plz_ort || k.telefon || k.email || k.website);
// Kontaktkarte weglassen, wenn die Beschreibung die Kontaktdaten ohnehin schon enthält (sonst doppelt).
const contentHasContact = !!(k.email && item.contentHtml.includes(k.email));
const showKontakt = hasKontakt && !contentHasContact;
---
<GrhPage
  title={item.title}
  eyebrow="Erleben & Entdecken"
  description={`${item.title} — Tourismus in und um Börnichen/Erzgeb.`}
  breadcrumb={[{ label: 'Tourismus', href: '/tourismus' }]}
>
  {item.image && (
    <figure class="grh-detail__img">
      <img src={item.image} alt={item.title} loading="lazy" decoding="async" />
    </figure>
  )}

  {item.contentHtml && <Fragment set:html={item.contentHtml} />}

  {showKontakt && (
    <div class="grh-contactcard">
      <h2>Kontakt</h2>
      {(k.fuehrende_person || k.strasse_hausnummer || k.plz_ort) && (
        <p>
          {k.fuehrende_person && <><strong>{k.fuehrende_person}</strong><br /></>}
          {k.strasse_hausnummer && <>{k.strasse_hausnummer}<br /></>}
          {k.plz_ort}
        </p>
      )}
      {(k.telefon || k.email || k.website) && (
        <p>
          {k.telefon && <>Telefon: <a href={telHref(k.telefon)}>{k.telefon}</a><br /></>}
          {k.email && <>E-Mail: <a href={`mailto:${k.email}`}>{k.email}</a><br /></>}
          {k.website && <>Web: <a href={k.website} target="_blank" rel="noopener noreferrer">{k.website}</a></>}
        </p>
      )}
    </div>
  )}
</GrhPage>

<style>
  .grh-detail__img {
    margin: var(--grh-space-6) 0;
    max-width: 520px;
    border-radius: 18px 18px 44px 18px;
    overflow: hidden;
    box-shadow: var(--grh-shadow-md);
  }
  .grh-detail__img img { width: 100%; height: auto; display: block; }

  /* === Foto-Galerie (kommt aus dem WP-Inhalt via set:html) ============ */
  .grh-prose :global(.grh-gallery__item) {
    box-shadow: var(--grh-shadow-sm);
    transition: box-shadow var(--grh-dur-fast), transform var(--grh-dur-fast);
    cursor: zoom-in;
  }
  .grh-prose :global(.grh-gallery__item img) {
    transition: transform 500ms var(--grh-ease-out);
  }
  .grh-prose :global(.grh-gallery__item:hover) { box-shadow: var(--grh-shadow-md); }
  .grh-prose :global(.grh-gallery__item:hover img) { transform: scale(1.06); }
  .grh-prose :global(.grh-gallery__item:focus-visible) {
    outline: 3px solid var(--grh-candle-500);
    outline-offset: 2px;
  }

  /* === Lightbox ======================================================= */
  .grh-lb {
    position: fixed; inset: 0; z-index: 1000;
    display: flex; align-items: center; justify-content: center;
    background: rgba(12, 16, 24, 0.92);
    opacity: 0; visibility: hidden;
    transition: opacity 220ms var(--grh-ease-out), visibility 220ms;
  }
  .grh-lb[data-open] { opacity: 1; visibility: visible; }
  .grh-lb__img {
    max-width: 92vw; max-height: 86vh;
    border-radius: 10px;
    box-shadow: 0 12px 48px rgba(0,0,0,.5);
    user-select: none;
  }
  .grh-lb__btn {
    position: absolute; top: 50%; transform: translateY(-50%);
    width: 52px; height: 52px; border-radius: 999px;
    border: none; background: rgba(255,255,255,.14); color: #fff;
    font-size: 26px; line-height: 1; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background var(--grh-dur-fast);
  }
  .grh-lb__btn:hover { background: rgba(255,255,255,.28); }
  .grh-lb__prev { left: max(12px, 3vw); }
  .grh-lb__next { right: max(12px, 3vw); }
  .grh-lb__close { top: max(12px, 3vh); right: max(12px, 3vw); transform: none; width: 46px; height: 46px; font-size: 22px; }
  .grh-lb__count {
    position: absolute; bottom: max(12px, 3vh); left: 0; right: 0;
    text-align: center; color: rgba(255,255,255,.85); font-size: 14px; letter-spacing: .04em;
  }
  @media (max-width: 640px) { .grh-lb__btn { width: 44px; height: 44px; font-size: 22px; } }
</style>

<script>
  // Leichte Lightbox für alle Galerien im Beitragsinhalt (.grh-gallery).
  document.addEventListener('DOMContentLoaded', () => {
    const items = Array.from(document.querySelectorAll<HTMLAnchorElement>('.grh-gallery__item'));
    if (!items.length) return;
    const srcs = items.map((a) => a.getAttribute('href') || '');

    const lb = document.createElement('div');
    lb.className = 'grh-lb';
    lb.innerHTML =
      '<button class="grh-lb__btn grh-lb__close" aria-label="Schließen">✕</button>' +
      '<button class="grh-lb__btn grh-lb__prev" aria-label="Vorheriges Bild">‹</button>' +
      '<img class="grh-lb__img" alt="" />' +
      '<button class="grh-lb__btn grh-lb__next" aria-label="Nächstes Bild">›</button>' +
      '<div class="grh-lb__count"></div>';
    document.body.appendChild(lb);

    const img = lb.querySelector('.grh-lb__img') as HTMLImageElement;
    const count = lb.querySelector('.grh-lb__count') as HTMLElement;
    let i = 0;

    const show = (n: number) => {
      i = (n + srcs.length) % srcs.length;
      img.src = srcs[i];
      count.textContent = `${i + 1} / ${srcs.length}`;
    };
    const open = (n: number) => { show(n); lb.setAttribute('data-open', ''); document.body.style.overflow = 'hidden'; };
    const close = () => { lb.removeAttribute('data-open'); document.body.style.overflow = ''; };

    items.forEach((a, n) => a.addEventListener('click', (e) => { e.preventDefault(); open(n); }));
    lb.querySelector('.grh-lb__next')!.addEventListener('click', (e) => { e.stopPropagation(); show(i + 1); });
    lb.querySelector('.grh-lb__prev')!.addEventListener('click', (e) => { e.stopPropagation(); show(i - 1); });
    lb.querySelector('.grh-lb__close')!.addEventListener('click', close);
    lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
    document.addEventListener('keydown', (e) => {
      if (!lb.hasAttribute('data-open')) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowRight') show(i + 1);
      else if (e.key === 'ArrowLeft') show(i - 1);
    });
  });
</script>
