---
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout title="Willkommen – Mängelmelder VV Wildenstein">
  <section class="hero">
    <div class="hero__overlay container">
      <h1 class="hero__title">
        Herzlich willkommen beim<br />
        <strong>Mängelmelder</strong> des Verwaltungsverbands Wildenstein
      </h1>
      <p class="hero__lead">
        Sehen Sie einen Mangel im öffentlichen Raum — ein Schlagloch, eine defekte
        Straßenlampe, wilden Müll? Melden Sie ihn in wenigen Schritten mit Foto und Standort.
      </p>
      <div class="hero__actions">
        <a href="/mangel-einreichen" class="btn btn--primary">＋ Mangel melden</a>
        <a href="/" class="btn btn--green">Zur Karte</a>
      </div>
    </div>
  </section>

  <section class="container steps">
    <h2 class="steps__title">So funktioniert's</h2>
    <ol class="steps__list">
      <li><span class="steps__num">1</span> Mangel beschreiben und fotografieren</li>
      <li><span class="steps__num">2</span> Standort auf der Karte setzen</li>
      <li><span class="steps__num">3</span> Absenden — der Verband kümmert sich</li>
    </ol>
  </section>

  <style>
    .hero {
      position: relative;
      min-height: clamp(360px, 70vh, 620px);
      display: flex;
      align-items: flex-end;
      background-image: linear-gradient(to top, rgba(8, 30, 16, 0.85) 0%, rgba(8, 30, 16, 0.25) 55%, rgba(8, 30, 16, 0.1) 100%),
        url('/images/hero-herbst.jpg');
      background-size: cover;
      background-position: center;
      color: #fff;
    }
    .hero__overlay { padding-block: 2.5rem 3rem; }
    .hero__title { font-size: clamp(1.6rem, 4.5vw, 2.8rem); margin: 0 0 1rem; font-weight: 500; max-width: 18ch; }
    .hero__title strong { font-weight: 800; }
    .hero__lead { font-size: clamp(1rem, 2vw, 1.2rem); max-width: 48ch; margin: 0 0 1.75rem; opacity: 0.95; }
    .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }

    .steps { padding-block: 3rem; }
    .steps__title { font-size: 1.5rem; margin: 0 0 1.5rem; }
    .steps__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
    .steps__list li {
      display: flex; align-items: center; gap: 0.85rem;
      background: var(--bg-soft); border: 1px solid var(--border);
      border-radius: var(--radius-lg); padding: 1.1rem 1.25rem; font-weight: 500;
    }
    .steps__num {
      flex: none; width: 2rem; height: 2rem; border-radius: 50%;
      background: var(--vv-green); color: #fff; font-weight: 700;
      display: grid; place-items: center;
    }
  </style>
</BaseLayout>
