---
import BaseLayout from '~/layouts/BaseLayout.astro';
import content from '~/content-legal/impressum.html?raw';
---

<BaseLayout title="Impressum – Mängelmelder VV Wildenstein">
  <article class="legal container">
    <h1>Impressum</h1>
    <div class="legal__body" set:html={content} />
  </article>

  <style>
    .legal { max-width: 820px; padding-block: 1.75rem 2.5rem; }
    .legal h1 { font-size: clamp(1.6rem, 4vw, 2.2rem); margin: 0 0 1.5rem; }
    .legal__body :global(h1) { font-size: 1.25rem; margin-top: 1.5rem; }
    .legal__body :global(h2),
    .legal__body :global(h3),
    .legal__body :global(h4) { margin-top: 1.5rem; }
    .legal__body :global(dl) { display: grid; grid-template-columns: max-content 1fr; gap: 0.35rem 1rem; }
    .legal__body :global(dt) { font-weight: 600; }
    .legal__body :global(dd) { margin: 0; }
    .legal__body :global(address) { font-style: normal; }
    .legal__body :global(a) { color: var(--vv-blue); }
  </style>
</BaseLayout>
