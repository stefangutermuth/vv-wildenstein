---
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout title="Vielen Dank! – Mängelmelder VV Wildenstein">
  <section class="thanks container">
    <div class="thanks__icon" aria-hidden="true">✓</div>
    <h1>Vielen Dank für Ihre Meldung!</h1>
    <p>
      Ihre Meldung ist beim Verwaltungsverband Wildenstein eingegangen. Sie wird nun geprüft
      und anschließend auf der Karte veröffentlicht. Falls Sie eine Benachrichtigung gewünscht
      haben, informieren wir Sie über den Bearbeitungsstand.
    </p>
    <div class="thanks__actions">
      <a href="/" class="btn btn--green">Zur Karte</a>
      <a href="/mangel-einreichen" class="btn btn--primary">Weitere Meldung</a>
    </div>
  </section>

  <style>
    .thanks { max-width: 620px; text-align: center; padding-block: 4rem 5rem; }
    .thanks__icon {
      width: 72px; height: 72px; margin: 0 auto 1.5rem; border-radius: 50%;
      background: var(--vv-green); color: #fff; font-size: 2.4rem;
      display: grid; place-items: center;
    }
    .thanks h1 { font-size: clamp(1.5rem, 4vw, 2.1rem); margin: 0 0 1rem; }
    .thanks p { color: var(--text-soft); margin: 0 0 2rem; }
    .thanks__actions { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }
  </style>
</BaseLayout>
