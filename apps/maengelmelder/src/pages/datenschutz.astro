---
import BaseLayout from '~/layouts/BaseLayout.astro';
import content from '~/content-legal/datenschutz.html?raw';
---

<BaseLayout title="Datenschutzerklärung – Mängelmelder VV Wildenstein">
  <article class="legal container">
    <h1>Datenschutzerklärung</h1>
    <div class="legal__body" set:html={content} />
  </article>

  <style>
    .legal { max-width: 820px; padding-block: 1.75rem 2.5rem; }
    .legal h1 { font-size: clamp(1.6rem, 4vw, 2.2rem); margin: 0 0 1.5rem; }
    .legal__body { line-height: 1.7; }
    .legal__body :global(h1) { font-size: 1.25rem; margin-top: 1.75rem; }
    .legal__body :global(h2),
    .legal__body :global(h3),
    .legal__body :global(h4) { margin-top: 1.5rem; }
    .legal__body :global(a) { color: var(--vv-blue); word-break: break-word; }
    .legal__body :global(table) { width: 100%; border-collapse: collapse; }
    .legal__body :global(td),
    .legal__body :global(th) { border: 1px solid var(--border); padding: 0.4rem 0.6rem; text-align: left; }
  </style>
</BaseLayout>
