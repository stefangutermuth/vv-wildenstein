---
import type { Meldung } from '~/lib/melder';
import { cardHTML } from '~/lib/melder';

interface Props { meldung: Meldung; }
const { meldung } = Astro.props;
---
{/* Markup kommt aus cardHTML() in lib/melder.ts — dieselbe Quelle nutzt das
    Live-Nachlade-Script auf Karte & Liste. Styles liegen global in tokens.css. */}
<Fragment set:html={cardHTML(meldung)} />
