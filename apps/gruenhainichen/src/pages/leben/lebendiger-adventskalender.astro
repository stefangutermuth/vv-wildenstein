---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Grafik des Heimatvereins ohne Jahreszahl (WordPress-Mediathek #48650)
const grafik = 'https://vv-wildenstein.com/wp-content/uploads/2026/09/Lebendiger-Adventskalender.jpg';
// Programm und Anmeldung pflegt der Grünhainichener Heimatverein; dieselben
// Links wie auf vv-wildenstein.com.
const HV_PROGRAMM = 'https://gruenhainichener-heimatverein.de/lebendiger_adventskalender/';
const HV_ANMELDEN = 'https://gruenhainichener-heimatverein.de/neues-tuerchen-fuer-den-lebendigen-adventskalender/';
---
<BaseLayout title="Lebendiger Adventskalender · Gemeinde Grünhainichen" header="compact">

  <header class="grh-adv-head">
    <div class="grh-container grh-adv-head__grid">
      <div class="grh-adv-head__text">
        <p class="grh-adv-crumb">Leben · Lebendiger Adventskalender</p>
        <span class="grh-adv-eyebrow">Jeden Tag ein neues Türchen</span>
        <h1>Lebendiger Adventskalender</h1>
        <p class="grh-adv-lead">
          Vom 1. bis 24. Dezember öffnet jeden Tag irgendwo in unserer
          Gemeinde ein <em>Türchen</em>, und Nachbarinnen und Nachbarn
          treffen sich zu Punsch, Musik und Geschichten.
        </p>
        <p class="grh-adv-status">
          Das Programm mit allen 24 Türchen stellt der Grünhainichener Heimatverein zusammen.
        </p>
        <div class="grh-adv-links">
          <a class="grh-adv-btn" href={HV_PROGRAMM}>Programm beim Heimatverein</a>
          <a class="grh-adv-btn grh-adv-btn--zwei" href={HV_ANMELDEN}>Türchen anmelden</a>
        </div>
      </div>
      <figure class="grh-adv-poster">
        <img src={grafik} alt="Lebendiger Adventskalender, 1. bis 24. Dezember, Borstendorf · Grünhainichen · Waldkirchen" loading="eager" />
        <figcaption>Grafik: Grünhainichener Heimatverein</figcaption>
      </figure>
    </div>
  </header>

  <section class="grh-adv-how">
    <div class="grh-container">
      <header class="grh-adv-section-head">
        <span class="grh-adv-section-eyebrow">So funktioniert es</span>
        <h2>24 Tage, 24 Türchen</h2>
      </header>
      <div class="grh-adv-steps">
        <article>
          <span class="grh-adv-step__num">01</span>
          <h3>Ein Türchen öffnet sich</h3>
          <p>
            Jeden Tag vom 1. bis 24. Dezember lädt eine Familie, ein Verein,
            eine Kita oder ein Geschäft an einem Fenster, einem Tor oder
            einer Tür zu sich ein.
          </p>
        </article>
        <article>
          <span class="grh-adv-step__num">02</span>
          <h3>Punsch, Musik &amp; Geschichten</h3>
          <p>
            Was passiert, entscheiden die Gastgeber selbst:
            Lieder mit dem Posaunenchor, Klöppel-Werkstatt, Plätzchen,
            Adventsgedichte oder schlicht ein warmer Tee.
          </p>
        </article>
        <article>
          <span class="grh-adv-step__num">03</span>
          <h3>Gemeinsam unterwegs</h3>
          <p>
            Ein Spaziergang durch den Ort, ein neues Gesicht jeden Tag
            und ein Adventskalender, der nicht auf dem Tisch, sondern
            in der ganzen Gemeinde steht.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="grh-adv-foot">
    <div class="grh-container">
      <p>
        Wann und wo sich welches Türchen öffnet, steht beim
        Grünhainichener Heimatverein.
        <a href={HV_PROGRAMM}>Zum Programm</a>
      </p>
    </div>
  </section>

</BaseLayout>

<style>
  .grh-adv-head {
    padding: clamp(var(--grh-space-7), 10vw, var(--grh-space-9)) 0 var(--grh-space-7);
    background:
      radial-gradient(circle at 100% 100%, rgba(212, 165, 92, 0.18), transparent 55%),
      radial-gradient(circle at 0% 0%, rgba(91, 174, 120, 0.12), transparent 55%),
      var(--grh-cream-50);
    border-bottom: 1px solid var(--grh-line);
  }
  .grh-adv-head__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--grh-space-6);
    align-items: center;
  }
  @media (min-width: 880px) {
    .grh-adv-head__grid { grid-template-columns: 1.4fr 1fr; gap: var(--grh-space-7); }
  }
  .grh-adv-crumb {
    font-family: var(--grh-font-body);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--grh-stone-400);
    margin: 0 0 var(--grh-space-4);
  }
  .grh-adv-eyebrow {
    display: inline-block;
    font-family: var(--grh-font-body);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    color: var(--grh-candle-500);
    font-weight: 700;
    margin-bottom: var(--grh-space-3);
  }
  .grh-adv-head__text h1 {
    font-family: var(--grh-font-display);
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--grh-forest-900);
    margin: 0 0 var(--grh-space-4);
    max-width: 14ch;
  }
  .grh-adv-lead {
    font-family: var(--grh-font-display);
    font-style: normal;
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    line-height: 1.55;
    color: var(--grh-forest-800);
    max-width: 55ch;
    margin: 0 0 var(--grh-space-4);
  }
  .grh-adv-lead em {
    font-style: normal;
    color: var(--grh-moss-600);
    background:
      linear-gradient(transparent 62%, rgba(212, 165, 92, 0.30) 62%, rgba(212, 165, 92, 0.30) 92%, transparent 92%);
    padding: 0 3px;
  }
  .grh-adv-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--grh-space-3);
    margin-top: var(--grh-space-5);
  }
  .grh-adv-btn {
    display: inline-block;
    padding: 12px 22px;
    border-radius: var(--grh-radius-pill);
    background: var(--grh-forest-900);
    color: var(--grh-cream-50);
    border: 1.5px solid var(--grh-forest-900);
    text-decoration: none;
    font-family: var(--grh-font-body);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-weight: 700;
    transition: background var(--grh-dur-fast), color var(--grh-dur-fast), transform var(--grh-dur-fast);
  }
  .grh-adv-btn:hover { background: var(--grh-forest-800); transform: translateY(-2px); }
  .grh-adv-btn--zwei { background: transparent; color: var(--grh-forest-900); }
  .grh-adv-btn--zwei:hover { background: var(--grh-candle-500); border-color: var(--grh-candle-500); color: var(--grh-forest-950); }
  .grh-adv-status {
    font-family: var(--grh-font-body);
    font-size: var(--grh-fs-sm);
    color: var(--grh-stone-700);
    margin: 0;
  }

  .grh-adv-poster {
    margin: 0;
    background: var(--grh-cream-50);
    border-radius: var(--grh-radius-md);
    padding: var(--grh-space-3);
    border: 1px solid var(--grh-line);
    box-shadow: 0 16px 40px rgba(26, 61, 39, 0.15);
    transform: rotate(-1.5deg);
    transition: transform var(--grh-dur-base);
  }
  .grh-adv-poster:hover { transform: rotate(0deg); }
  .grh-adv-poster img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--grh-radius-sm);
  }
  .grh-adv-poster figcaption {
    text-align: center;
    margin-top: var(--grh-space-2);
    font-family: var(--grh-font-display);
    font-style: normal;
    font-size: var(--grh-fs-sm);
    color: var(--grh-stone-400);
  }
  .grh-adv-how { padding: var(--grh-space-7) 0; }
  .grh-adv-section-head { margin-bottom: var(--grh-space-6); text-align: center; }
  .grh-adv-section-eyebrow {
    display: inline-block;
    font-family: var(--grh-font-body);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: var(--grh-moss-600);
    font-weight: 700;
    margin-bottom: var(--grh-space-2);
  }
  .grh-adv-section-head h2 {
    font-family: var(--grh-font-display);
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    color: var(--grh-forest-900);
    margin: 0;
    letter-spacing: -0.02em;
  }
  .grh-adv-steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--grh-space-5);
  }
  @media (min-width: 800px) {
    .grh-adv-steps { grid-template-columns: repeat(3, 1fr); gap: var(--grh-space-6); }
  }
  .grh-adv-steps article {
    background: var(--grh-cream-50);
    border-radius: var(--grh-radius-md);
    padding: var(--grh-space-5);
    border-top: 3px solid var(--grh-candle-500);
    display: flex;
    flex-direction: column;
    gap: var(--grh-space-2);
  }
  .grh-adv-step__num {
    font-family: var(--grh-font-display);
    font-style: normal;
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--grh-candle-500);
    line-height: 1;
    font-weight: 500;
  }
  .grh-adv-steps h3 {
    font-family: var(--grh-font-display);
    font-size: var(--grh-fs-lg);
    color: var(--grh-forest-900);
    margin: 0;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }
  .grh-adv-steps p {
    font-size: var(--grh-fs-sm);
    color: var(--grh-stone-700);
    line-height: 1.6;
    margin: 0;
  }

  .grh-adv-foot {
    padding: var(--grh-space-5) 0 var(--grh-space-7);
    background: var(--grh-cream-50);
    border-top: 1px solid var(--grh-line);
    text-align: center;
  }
  .grh-adv-foot p {
    font-family: var(--grh-font-display);
    font-style: normal;
    font-size: var(--grh-fs-md);
    color: var(--grh-stone-700);
    max-width: 56ch;
    margin: 0 auto;
    line-height: 1.6;
  }
  .grh-adv-foot a {
    color: var(--grh-forest-800);
    border-bottom: 1.5px solid var(--grh-candle-500);
    text-decoration: none;
    font-style: normal;
    font-family: var(--grh-font-body);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-weight: 700;
    padding-bottom: 2px;
    margin-left: 4px;
  }
  .grh-adv-foot a:hover { color: var(--grh-moss-600); }
</style>
