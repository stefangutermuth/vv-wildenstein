    shops: [
      { name: 'Holzhandel Köhler', icon: 'tree-pine',
        street: 'Am Berg 1 b', city: 'Borstendorf · 09579 Grünhainichen' },
      { name: 'Gartenbau Schneller', icon: 'sprout',
        street: 'Mühlenstraße 50', city: '09579 Grünhainichen',
        phone: '037294 / 1478' },
      { name: 'Kommunalmaschinen & Friedhofstechnik Fethke', icon: 'wrench',
        street: 'Chemnitzer Straße 4', city: '09579 Grünhainichen',
