---
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Shop {
  name: string;
  icon: string;          // Lucide-Icon-Slug, z.B. "croissant"
  street?: string;
  city: string;
  phone?: string;
  email?: string;
  website?: string;
}
interface Group {
  slug: string;
  title: string;
  eyebrow: string;
  shops: Shop[];
}

const groups: Group[] = [
