---
/**
 * Einkaufen: liest die Profile der Kategorie „Einkaufen“ aus WordPress.
 * Die Gruppen (Essen & Trinken, Erzgebirgisches Handwerk …) sind
 * Unterkategorien von „Einkaufen“, ihre Beschreibung ist die Unterzeile.
 * Name, Anschrift, Telefon, E-Mail, Website und Öffnungszeiten stehen im
 * Profil. Im Code bleiben nur die Symbole je Geschäft (Gestaltung).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProfileNachKategorie, getProfilUnterkategorien } from '../../lib/cms-cpt';

interface Shop {
  name: string;
  icon: string;          // Lucide-Icon-Slug, z.B. "croissant"
  street?: string;
  city?: string;
  phone?: string;
  mobil?: string;
  email?: string;
  website?: string;
  zeiten?: string;
  detail?: string;
}
interface Group {
  slug: string;
  title: string;
  eyebrow: string;
  shops: Shop[];
}

/* Symbole: je Geschäft (Profil-Slug), sonst je Gruppe, sonst ein Laden */
const ICON_GESCHAEFT: Record<string, string> = {
  'baeckerei-vieweger': 'croissant', 'fleischerei-borstendorf': 'beef', 'fachhandel-fuer-getraenke-spirituosen-fethke': 'wine',
  'wendt-kuehn-kg': 'sparkles', 'hobler-figuren-mit-herz-aus-gruenhainichen': 'heart-handshake', 'blank-kunsthandwerk': 'palette',
  'baumanns-holzschnitzerei': 'axe', 'drechslerei-kluge': 'cylinder', 'holzhandel-koehler-inh-grit-haehnel': 'tree-pine',
  'gartenbau-schneller': 'sprout', 'kommunalmaschinen-friedhofstechnik-fethke': 'wrench', 'auto-sachsse': 'car',
  'antik-dekoration-jana-franke': 'armchair', 'troedelschmiede': 'hammer', 'rochhausmuehle': 'clock', 'feuerwerkland': 'rocket',
  'hoergeraete-akustik-rochhausen-gmbh': 'ear', 'raiffeisen-bezugs-und-handelsgenossenschaft-waldkirchen-erzgeb-e-g': 'tractor',
  'freitag-gmbh': 'store', 'rolle-muehle': 'wheat',
};
const ICON_GRUPPE: Record<string, string> = {
  'einkaufen-essen-trinken': 'utensils', 'einkaufen-erzgebirgisches-handwerk': 'sparkles', 'einkaufen-haus-garten': 'house',
  'einkaufen-antik-geschenke': 'gift', 'einkaufen-service': 'store',
};
const leer = (v?: string) => (v && v.trim() ? v.trim() : undefined);
const text = (html: string) => html.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();

const [profile, gruppen] = await Promise.all([getProfileNachKategorie('einkaufen'), getProfilUnterkategorien('einkaufen')]);
const alsShop = (p: (typeof profile)[number], gruppe?: string): Shop => {
  const k = p.kontakt ?? {};
  return {
    name: p.title,
    icon: ICON_GESCHAEFT[p.slug] ?? (gruppe && ICON_GRUPPE[gruppe]) ?? 'store',
    street: leer(k.strasse_hausnummer),
    city: leer(k.plz_ort),
    phone: leer(k.telefon),
    mobil: leer(k.mobil),
    email: leer(k.email),
    website: leer(k.website),
    zeiten: leer(k.oeffnungszeiten),
    detail: p.hatDetailseite && text(p.contentHtml).length > 0 ? `/gewerbe/${p.slug}/` : undefined,
  };
};
const nachName = (x: Shop, y: Shop) => x.name.localeCompare(y.name, 'de');
const groups: Group[] = gruppen
  .map((g) => ({
    slug: g.slug.replace(/^einkaufen-/, ''),
    title: g.name,
    eyebrow: g.beschreibung,
    shops: profile.filter((p) => p.kategorien.includes(g.slug)).map((p) => alsShop(p, g.slug)).sort(nachName),
  }))
  .filter((g) => g.shops.length > 0);
/* Neue Geschäfte ohne Gruppe gehen nicht verloren */
const ohneGruppe = profile.filter((p) => !gruppen.some((g) => p.kategorien.includes(g.slug)));
if (ohneGruppe.length) groups.push({ slug: 'weitere', title: 'Weitere Geschäfte', eyebrow: 'In unserer Gemeinde', shops: ohneGruppe.map((p) => alsShop(p)).sort(nachName) });

const totalShops = groups.reduce((n, g) => n + g.shops.length, 0);

function telHref(p: string): string {
  return 'tel:' + p.replace(/[^+\d]/g, '');
}

// Build-Time SVG-Fetch von Iconify-CDN. Hat den Vorteil:
//   - Keine Runtime-Requests beim Nutzer (CSP-sicher, offline-fähig)
//   - Inline-SVGs nehmen `currentColor` an → easy zu stylen
// Wenn Iconify nicht erreichbar ist, fallback auf leeres SVG.
async function fetchIcon(slug: string): Promise<string> {
  try {
    const ctrl = new AbortController();
    const t = setTimeout(() => ctrl.abort(), 4000);
    const res = await fetch(`https://api.iconify.design/lucide/${slug}.svg?width=32&height=32`, { signal: ctrl.signal });
    clearTimeout(t);
    if (!res.ok) return '';
    let svg = await res.text();
    // Iconify SVGs nutzen "currentColor" by default → wir können via CSS einfärben.
    return svg;
  } catch {
    return '';
  }
}

const uniqueSlugs = Array.from(new Set(groups.flatMap((g) => g.shops.map((s) => s.icon))));
const iconMap: Record<string, string> = {};
await Promise.all(uniqueSlugs.map(async (slug) => {
  iconMap[slug] = await fetchIcon(slug);
}));
---
<BaseLayout title="Einkaufen · Gemeinde Grünhainichen" header="compact">

  <header class="grh-eink-head">
    <div class="grh-container">
      <p class="grh-eink-crumb">Leben · Einkaufen</p>
      <span class="grh-eink-eyebrow">Vor Ort gut versorgt</span>
      <h1>Einkaufen in unserer Gemeinde</h1>
      <p class="grh-eink-lead">
        {totalShops} Geschäfte, Handwerker und Manufakturen in unserer
        Gemeinde mit Adresse, Telefon und Öffnungszeiten.
      </p>
      <nav class="grh-eink-anchors" aria-label="Sprung zu Kategorien">
        {groups.map((g) => <a href={`#${g.slug}`}>{g.title}</a>)}
      </nav>
    </div>
  </header>

  {groups.map((g, i) => (
    <section class={`grh-eink-section ${i % 2 === 0 ? '' : 'grh-eink-section--alt'}`} id={g.slug}>
      <div class="grh-container">
        <header class="grh-eink-section__head">
          <span class="grh-eink-section__eyebrow">{g.eyebrow}</span>
          <h2>{g.title}</h2>
        </header>
        <ul class="grh-eink-list">
          {g.shops.map((s) => (
            <li class="grh-eink-card">
              <div class="grh-eink-card__icon" aria-hidden="true" set:html={iconMap[s.icon] ?? ''} />
              <h3>{s.name}</h3>
              {(s.street || s.city) && (
                <p class="grh-eink-card__addr">
                  {s.street && <>{s.street}<br /></>}{s.city}
                </p>
              )}
              <ul class="grh-eink-card__ways">
                {s.phone && <li><span>Telefon</span><a href={telHref(s.phone)}>{s.phone}</a></li>}
                {s.mobil && <li><span>Mobil</span><a href={telHref(s.mobil)}>{s.mobil}</a></li>}
                {s.email && <li><span>E-Mail</span><a href={`mailto:${s.email}`}>{s.email}</a></li>}
                {s.website && (
                  <li>
                    <span>Internet</span>
                    <a href={s.website} target="_blank" rel="noopener">
                      {s.website.replace(/^https?:\/\//,'').replace(/\/$/,'')}
                    </a>
                  </li>
                )}
              </ul>
              {s.zeiten && (
                <details class="grh-eink-card__zeiten">
                  <summary>Öffnungszeiten</summary>
                  <p>{s.zeiten}</p>
                </details>
              )}
              {s.detail && <a class="grh-eink-card__mehr" href={s.detail}>Mehr erfahren →</a>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

</BaseLayout>

<style>
  .grh-eink-head {
    padding: clamp(var(--grh-space-7), 10vw, var(--grh-space-9)) 0 var(--grh-space-6);
    background:
      radial-gradient(circle at 100% 0%, rgba(212, 165, 92, 0.08), transparent 55%),
      var(--grh-cream-50);
    border-bottom: 1px solid var(--grh-line);
  }
  .grh-eink-crumb {
    font-family: var(--grh-font-body);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--grh-stone-400);
    margin: 0 0 var(--grh-space-4);
  }
  .grh-eink-eyebrow {
    display: inline-block;
    font-family: var(--grh-font-body);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    color: var(--grh-candle-500);
    font-weight: 700;
    margin-bottom: var(--grh-space-3);
  }
  .grh-eink-head h1 {
    font-family: var(--grh-font-display);
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--grh-forest-900);
    margin: 0 0 var(--grh-space-4);
    max-width: 18ch;
  }
  .grh-eink-lead {
    font-family: var(--grh-font-display);
    font-style: normal;
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    line-height: 1.55;
    color: var(--grh-forest-800);
    max-width: 60ch;
    margin: 0 0 var(--grh-space-5);
  }
  .grh-eink-anchors {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .grh-eink-anchors a {
    padding: 6px 14px;
    background: var(--grh-paper-100);
    border: 1px solid var(--grh-line);
    border-radius: var(--grh-radius-pill);
    text-decoration: none;
    color: var(--grh-forest-800);
    font-family: var(--grh-font-body);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-weight: 700;
    transition: background var(--grh-dur-fast), color var(--grh-dur-fast);
  }
  .grh-eink-anchors a:hover {
    background: var(--grh-forest-900);
    color: var(--grh-cream-50);
    border-color: var(--grh-forest-900);
  }

  /* === Sektionen ====================================================== */
  .grh-eink-section {
    padding: var(--grh-space-7) 0;
    scroll-margin-top: 80px;
  }
  .grh-eink-section--alt { background: var(--grh-paper-100); }
  .grh-eink-section__head { margin-bottom: var(--grh-space-5); }
  .grh-eink-section__eyebrow {
    display: inline-block;
    font-family: var(--grh-font-body);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: var(--grh-moss-600);
    font-weight: 700;
    margin-bottom: var(--grh-space-2);
  }
  .grh-eink-section__head h2 {
    font-family: var(--grh-font-display);
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    color: var(--grh-forest-900);
    margin: 0;
    letter-spacing: -0.02em;
  }

  /* === Karten ========================================================= */
  .grh-eink-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--grh-space-4);
  }
  @media (min-width: 720px)  { .grh-eink-list { grid-template-columns: repeat(2, 1fr); gap: var(--grh-space-4); } }
  @media (min-width: 1000px) { .grh-eink-list { grid-template-columns: repeat(3, 1fr); gap: var(--grh-space-5); } }

  .grh-eink-card {
    background: var(--grh-cream-50);
    border: 1px solid var(--grh-line);
    border-radius: var(--grh-radius-md);
    padding: var(--grh-space-5);
    display: flex;
    flex-direction: column;
    gap: var(--grh-space-3);
    transition: border-color var(--grh-dur-fast), transform var(--grh-dur-fast);
  }
  .grh-eink-card:hover {
    border-color: var(--grh-candle-500);
    transform: translateY(-2px);
  }
  .grh-eink-card__icon {
    width: 56px;
    height: 56px;
    border-radius: var(--grh-radius-sm);
    background: var(--grh-paper-100);
    display: grid;
    place-items: center;
    transition: background var(--grh-dur-fast), color var(--grh-dur-fast);
    color: var(--grh-forest-900);
  }
  .grh-eink-card:hover .grh-eink-card__icon {
    background: rgba(212, 165, 92, 0.25);
    color: var(--grh-moss-600);
  }
  .grh-eink-card__icon :global(svg) {
    width: 32px;
    height: 32px;
    display: block;
    stroke: currentColor;
    stroke-width: 1.6;
  }
  .grh-eink-card h3 {
    font-family: var(--grh-font-display);
    font-size: var(--grh-fs-lg);
    color: var(--grh-forest-900);
    margin: 0;
    letter-spacing: -0.015em;
    line-height: 1.25;
  }
  .grh-eink-card__addr {
    font-size: var(--grh-fs-sm);
    color: var(--grh-stone-700);
    margin: 0;
    line-height: 1.5;
  }
  .grh-eink-card__ways {
    list-style: none;
    padding: var(--grh-space-3) 0 0;
    margin: 0;
    border-top: 1px solid var(--grh-line);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .grh-eink-card__ways li {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .grh-eink-card__ways span {
    font-family: var(--grh-font-body);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--grh-stone-400);
    font-weight: 700;
  }
  .grh-eink-card__ways a {
    font-family: var(--grh-font-display);
    font-style: normal;
    font-size: var(--grh-fs-sm);
    color: var(--grh-forest-800);
    text-decoration: none;
    border-bottom: 1.5px solid var(--grh-candle-500);
    width: fit-content;
    padding-bottom: 2px;
    word-break: break-word;
  }
  .grh-eink-card__ways a:hover { color: var(--grh-moss-600); }
  .grh-eink-card__zeiten { margin-top: var(--grh-space-3); font-size: 13px; color: var(--grh-stone-700); }
  .grh-eink-card__zeiten summary { cursor: pointer; font-size: 10px; text-transform: uppercase; letter-spacing: 0.18em; font-weight: 700; color: var(--grh-moss-600); }
  .grh-eink-card__zeiten p { margin: 6px 0 0; white-space: pre-line; line-height: 1.55; }
  .grh-eink-card__mehr { display: inline-block; margin-top: var(--grh-space-3); font-size: 12px; font-weight: 600; color: var(--grh-moss-600); }
</style>
