      { name: 'Raiffeisen BHG Waldkirchen e.G.', icon: 'tractor',
        street: 'Am Bahnhof 1', city: 'Waldkirchen · 09579 Grünhainichen',
        phone: '03725 / 2901-0', email: 'info@raiffeisen-waldkirchen.de', website: 'http://bhg-waldkirchen.de' },
      { name: 'Freitag GmbH', icon: 'store',
