---
/**
 * Kirchen: liest die Profile der Kategorie „Kirchen“ aus WordPress
 * (vv-wildenstein.com › Profile). Name, Bild, Anschrift, Telefon, E-Mail,
 * Website und Beschreibung pflegt der Verband dort; diese Seite legt nur
 * Reihenfolge und Gestaltung fest.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProfileNachKategorie } from '../../lib/cms-cpt';

interface Kirche {
  ortsteil: string;
  name: string;
  image?: string;
  street?: string;
  city?: string;
  phone?: string;
  mobil?: string;
  fax?: string;
  email?: string;
  website?: string;
  person?: string;
  description?: string;
  detail?: string;
}

const ORTE: Array<[RegExp, string]> = [
  [/gr(ü|ue)nhainichen/i, 'Grünhainichen'],
  [/waldkirchen/i, 'Waldkirchen'],
  [/borstendorf/i, 'Borstendorf'],
  [/b(ö|oe)rnichen/i, 'Börnichen'],
];
const REIHENFOLGE = ORTE.map(([, o]) => o);
/* Ortsteil: zuerst aus dem Titel, dann aus der WordPress-Zuordnung. Die
   meisten Profile haben dort (noch) keinen Ortsteil. */
const ortAus = (titel: string, teile: string[]) =>
  ORTE.find(([re]) => re.test(titel))?.[1]
  ?? ORTE.find(([re]) => teile.some((t) => re.test(t)))?.[1]
  ?? '';
const text = (html: string) => html.replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ').replace(/&[#\w]+;/g, (e) => ({ '&amp;': '&', '&#8211;': '-', '&#8220;': '„', '&#8221;': '“', '&#8222;': '„' } as Record<string, string>)[e] ?? ' ').replace(/\s+/g, ' ').trim();
/* Kurzbeschreibung: das Feld „Informationen“, sonst die ersten Sätze des
   Textes bis etwa 240 Zeichen. */
const kurz = (html: string) => {
  const t = text(html);
  if (t.length <= 240) return t;
  const saetze = t.match(/[^.!?]+[.!?]+/g) ?? [t];
  let out = '';
  for (const satz of saetze) { if ((out + satz).length > 240 && out) break; out += satz; }
  return out.trim() || t.slice(0, 240) + ' …';
};
const leer = (v?: string) => (v && v.trim() ? v.trim() : undefined);

const kirchen: Kirche[] = (await getProfileNachKategorie('kirchen'))
  .map((p) => {
    const k = p.kontakt ?? {};
    const person = leer(k.fuehrende_person);
    return {
      ortsteil: ortAus(p.title, p.gemeindeteile),
      name: p.title,
      image: p.image,
      street: leer(k.strasse_hausnummer),
      city: leer(k.plz_ort),
      phone: leer(k.telefon),
      mobil: leer(k.mobil),
      fax: leer(k.fax),
      email: leer(k.email),
      website: leer(k.website),
      /* „Ev.-Luth. Kirchgemeinde …“ im Personenfeld ist kein Ansprechpartner */
      person: person && !/kirch/i.test(person) ? person : undefined,
      description: leer(k.informationen) ?? (leer(text(p.contentHtml)) ? kurz(p.contentHtml) : undefined),
      detail: p.hatDetailseite && text(p.contentHtml).length > 240 ? `/gewerbe/${p.slug}/` : undefined,
    };
  })
  .sort((a, b) => REIHENFOLGE.indexOf(a.ortsteil) - REIHENFOLGE.indexOf(b.ortsteil));
---
<BaseLayout title="Kirchen · Gemeinde Grünhainichen" header="compact">

  <header class="grh-kir-head">
    <div class="grh-container">
      <p class="grh-kir-crumb">Leben · Kirche</p>
      <span class="grh-kir-eyebrow">Glauben &amp; Gemeinschaft</span>
      <h1>Kirchen unserer Gemeinde</h1>
      <p class="grh-kir-lead">
        Die evangelisch-lutherischen Kirchgemeinden prägen das Leben in
        unseren Ortsteilen und der Nachbargemeinde Börnichen, von der
        <em>Mutterkirche Waldkirchen</em> (seit 1539) bis zur jüngsten
        Schwester in Börnichen (geweiht 1900).
      </p>
    </div>
  </header>

  <section class="grh-kir-grid-section">
    <div class="grh-container">
      <div class="grh-kir-grid">
        {kirchen.map((k) => (
          <article class="grh-kir-card">
            {k.image && (
              <figure class="grh-kir-card__media">
                <img src={k.image!} alt={k.name} loading="lazy" />
              </figure>
            )}
            <div class="grh-kir-card__body">
              <header class="grh-kir-card__head">
                <span class="grh-kir-card__ort">{k.ortsteil}</span>
              </header>
              <h2>{k.name}</h2>
              {k.description
                ? <p class="grh-kir-card__desc">{k.description}</p>
                : !k.street && !k.phone && !k.email && <p class="grh-kir-card__desc grh-kir-card__desc--leer">Für diese Kirche sind noch keine Angaben hinterlegt.</p>}

              {(k.street || k.phone || k.mobil || k.email) && (
                <div class="grh-kir-card__contact">
                  {k.street && (
                    <p class="grh-kir-card__addr">
                      {k.street}<br />
                      {k.city}
                    </p>
                  )}
                  <ul>
                    {k.person && <li><span>Kontakt</span>{k.person}</li>}
                    {k.phone && <li><span>Telefon</span><a href={`tel:${k.phone.replace(/[^+\d]/g,'')}`}>{k.phone}</a></li>}
                    {k.mobil && <li><span>Mobil</span><a href={`tel:${k.mobil.replace(/[^+\d]/g,'')}`}>{k.mobil}</a></li>}
                    {k.fax && <li><span>Fax</span>{k.fax}</li>}
                    {k.email && <li><span>E-Mail</span><a href={`mailto:${k.email}`}>{k.email}</a></li>}
                  </ul>
                </div>
              )}

              <div class="grh-kir-card__links">
                {k.detail && <a class="grh-kir-card__link" href={k.detail}>Mehr erfahren →</a>}
                {k.website && (
                  <a class="grh-kir-card__link" href={k.website} target="_blank" rel="noopener">
                    {k.website.replace(/^https?:\/\//,'').replace(/\/$/,'')} ↗
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="grh-kir-foot">
    <div class="grh-container">
      <p>
        Aktuelle Gottesdienste, Termine und Ansprechpartner veröffentlichen die
        Kirchgemeinden auf ihren eigenen Webseiten.
      </p>
    </div>
  </section>

</BaseLayout>

<style>
  /* === Kopfzeile ====================================================== */
  .grh-kir-head {
    padding: clamp(var(--grh-space-7), 10vw, var(--grh-space-9)) 0 var(--grh-space-6);
    background:
      radial-gradient(circle at 100% 0%, rgba(91, 174, 120, 0.10), transparent 55%),
      var(--grh-cream-50);
    border-bottom: 1px solid var(--grh-line);
  }
  .grh-kir-crumb {
    font-family: var(--grh-font-body);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--grh-stone-400);
    margin: 0 0 var(--grh-space-4);
  }
  .grh-kir-eyebrow {
    display: inline-block;
    font-family: var(--grh-font-body);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    color: var(--grh-candle-500);
    font-weight: 700;
    margin-bottom: var(--grh-space-3);
  }
  .grh-kir-head h1 {
    font-family: var(--grh-font-display);
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--grh-forest-900);
    margin: 0 0 var(--grh-space-4);
    max-width: 18ch;
  }
  .grh-kir-lead {
    font-family: var(--grh-font-display);
    font-style: normal;
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    line-height: 1.5;
    color: var(--grh-forest-800);
    max-width: 58ch;
    margin: 0;
  }
  .grh-kir-lead em {
    font-style: normal;
    color: var(--grh-moss-600);
  }

  /* === Karten-Grid ==================================================== */
  .grh-kir-grid-section { padding: var(--grh-space-7) 0; }
  .grh-kir-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--grh-space-5);
  }
  @media (min-width: 800px) {
    .grh-kir-grid { grid-template-columns: 1fr 1fr; gap: var(--grh-space-6); }
  }

  .grh-kir-card {
    display: flex;
    flex-direction: column;
    background: var(--grh-cream-50);
    border: 1px solid var(--grh-line);
    border-radius: var(--grh-radius-md);
    overflow: hidden;
    transition: border-color var(--grh-dur-fast), transform var(--grh-dur-fast), box-shadow var(--grh-dur-base);
  }
  .grh-kir-card:hover {
    border-color: var(--grh-candle-500);
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(26, 61, 39, 0.08);
  }
  .grh-kir-card__media {
    margin: 0;
    overflow: hidden;
    background: var(--grh-paper-100);
  }
  .grh-kir-card__media img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
  }
  .grh-kir-card__body {
    padding: var(--grh-space-5);
    display: flex;
    flex-direction: column;
    gap: var(--grh-space-3);
    flex: 1;
  }
  .grh-kir-card__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--grh-space-3);
  }
  .grh-kir-card__ort {
    font-family: var(--grh-font-body);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: var(--grh-moss-600);
    font-weight: 700;
  }
  .grh-kir-card__year {
    font-family: var(--grh-font-display);
    font-style: normal;
    font-size: var(--grh-fs-sm);
    color: var(--grh-stone-400);
  }
  .grh-kir-card__body h2 {
    font-family: var(--grh-font-display);
    font-size: var(--grh-fs-xl);
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--grh-forest-900);
    margin: 0;
  }
  .grh-kir-card__desc {
    font-size: var(--grh-fs-sm);
    color: var(--grh-stone-700);
    line-height: 1.6;
    margin: 0;
  }
  .grh-kir-card__contact {
    border-top: 1px solid var(--grh-line);
    padding-top: var(--grh-space-3);
    display: flex;
    flex-direction: column;
    gap: var(--grh-space-2);
  }
  .grh-kir-card__addr {
    font-family: var(--grh-font-display);
    font-size: var(--grh-fs-md);
    color: var(--grh-forest-900);
    line-height: 1.4;
    margin: 0;
  }
  .grh-kir-card__contact ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .grh-kir-card__contact li {
    display: flex;
    flex-direction: column;
    gap: 1px;
    font-size: var(--grh-fs-sm);
    color: var(--grh-stone-700);
    line-height: 1.5;
  }
  .grh-kir-card__contact li span {
    font-family: var(--grh-font-body);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--grh-stone-400);
    font-weight: 700;
  }
  .grh-kir-card__contact a {
    color: var(--grh-forest-800);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--grh-dur-fast);
    word-break: break-word;
  }
  .grh-kir-card__contact a:hover { border-color: var(--grh-candle-500); }
  .grh-kir-card__link {
    margin-top: auto;
    align-self: flex-start;
    font-family: var(--grh-font-body);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-weight: 700;
    color: var(--grh-forest-800);
    text-decoration: none;
    border-bottom: 1.5px solid var(--grh-candle-500);
    padding-bottom: 2px;
    word-break: break-all;
  }
  .grh-kir-card__link:hover { color: var(--grh-moss-600); }

  /* === Footer ========================================================= */
  .grh-kir-foot {
    padding: var(--grh-space-6) 0 var(--grh-space-8);
    background: var(--grh-paper-100);
    border-top: 1px solid var(--grh-line);
  }
  .grh-kir-foot p {
    font-family: var(--grh-font-display);
    font-style: normal;
    font-size: var(--grh-fs-md);
    color: var(--grh-stone-700);
    text-align: center;
    max-width: 58ch;
    margin: 0 auto;
    line-height: 1.6;
  }
  .grh-kir-foot strong {
    font-style: normal;
    color: var(--grh-forest-900);
    font-weight: 500;
  }
  .grh-kir-card__links { display: flex; flex-wrap: wrap; gap: 6px 16px; margin-top: auto; }
  .grh-kir-card__desc--leer { color: var(--grh-stone-400); font-size: 13px; }
</style>
