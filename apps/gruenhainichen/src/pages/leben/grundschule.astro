---
/**
 * Grundschule: liest die Profile der Kategorie „Schule“ aus WordPress
 * (vv-wildenstein.com › Profile). Foto, Beschreibung, Anschrift, Telefon,
 * E-Mail, Website und die Angaben zu Hort und Förderverein pflegt der Verband
 * dort. Die frühere Grundschule Waldkirchen steht als zweites Profil in
 * derselben Kategorie und erscheint unten als Rückblick.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProfileNachKategorie, getVereine } from '../../lib/cms-cpt';

const schulen = await getProfileNachKategorie('schule');
const schule = schulen.find((p) => /im gr(ü|ue)nen/i.test(p.title)) ?? schulen[0];
const frueher = schulen.filter((p) => p !== schule);

const k = schule?.kontakt ?? {};
/* Leere Felder weg, gerade Anführungszeichen aus WordPress als „…“ */
const leer = (v?: string) => (v && v.trim() ? v.trim().replace(/"([^"]+)"/g, '„$1“') : undefined);
const tel = (v: string) => `tel:${v.replace(/[^+\d]/g, '').replace(/^0/, '+49')}`;
const webLabel = (u: string) => u.replace(/^https?:\/\//, '').replace(/^www\./, '').replace(/\/$/, '');
const text = (html: string) => html.replace(/<[^>]+>/g, ' ').replace(/&#8222;|&#8220;/g, '"').replace(/&#8211;/g, '-').replace(/&amp;/g, '&').replace(/&nbsp;/g, ' ').replace(/&[#\w]+;/g, ' ').replace(/\s+/g, ' ').trim();

const titel = schule?.title ?? 'Grundschule';
const einleitung = schule?.auszug;
const photo = schule?.image;
/* Förderverein: eigenes Vereinsprofil in WordPress (Vereine), Text und Link von dort */
const foerderverein = (await getVereine()).find((v) => /f(ö|oe)rderverein.*grundschule/i.test(v.title));
const foerdervereinText = foerderverein ? text(foerderverein.contentHtml) : undefined;
const website = leer(k.website);
const kontakt = {
  name: leer(k.fuehrende_person) ?? titel,
  strasse: leer(k.strasse_hausnummer),
  ort: leer(k.plz_ort),
  telefon: leer(k.telefon),
  mobil: leer(k.mobil),
  fax: leer(k.fax),
  email: leer(k.email),
};
/* Freitext aus WordPress: Hort- und Fördervereinskontakt, mehrzeilig */
const weitere = leer(k.oeffnungszeiten);
const hinweis = leer(k.informationen);
---
<BaseLayout title={`${titel} · Gemeinde Grünhainichen`} header="compact">

  {/* === Hero mit Schul-Foto ============================================ */}
  <header class="grh-gs-head">
    <div class="grh-container grh-gs-head__grid">
      <div class="grh-gs-head__text">
        <p class="grh-gs-crumb">Leben · Grundschule</p>
        <h1>{titel}</h1>
        {einleitung && <p class="grh-gs-lead">{einleitung}</p>}
        {website && (
          <a class="grh-gs-cta" href={website} target="_blank" rel="noopener">
            {webLabel(website)} ↗
          </a>
        )}
      </div>
      {photo && (
        <figure class="grh-gs-photo">
          <img src={photo} alt={titel} loading="eager" />
        </figure>
      )}
    </div>
  </header>

  {/* === Über die Schule: Text aus WordPress =========================== */}
  {schule?.contentHtml && (
    <section class="grh-gs-block">
      <div class="grh-container grh-gs-ueber">
        <header class="grh-gs-section-head">
          <span class="grh-gs-section-eyebrow">Über die Schule</span>
        </header>
        <div class="grh-prose grh-gs-prose" set:html={schule.contentHtml} />
      </div>
    </section>
  )}

  {/* === Kontakt & Förderverein ========================================= */}
  <section class="grh-gs-block grh-gs-block--alt">
    <div class="grh-container grh-gs-grid">
      <article class="grh-gs-card">
        <span class="grh-gs-card__label">Schule</span>
        <h2>Kontakt</h2>
        <div class="grh-gs-contact">
          <strong>{kontakt.name}</strong>
          {(kontakt.strasse || kontakt.ort) && <span>{kontakt.strasse}<br />{kontakt.ort}</span>}
          <ul>
            {kontakt.telefon && <li><span>Telefon</span><a href={tel(kontakt.telefon)}>{kontakt.telefon}</a></li>}
            {kontakt.mobil && <li><span>Mobil</span><a href={tel(kontakt.mobil)}>{kontakt.mobil}</a></li>}
            {kontakt.fax && <li><span>Fax</span>{kontakt.fax}</li>}
            {kontakt.email && <li><span>E-Mail</span><a href={`mailto:${kontakt.email}`}>{kontakt.email}</a></li>}
            {website && <li><span>Internet</span><a href={website} target="_blank" rel="noopener">{webLabel(website)}</a></li>}
          </ul>
        </div>
      </article>

      <article class="grh-gs-card grh-gs-card--accent">
        <span class="grh-gs-card__label">Hort &amp; Förderverein</span>
        <h2>Rund um die Schule</h2>
        {hinweis && <p>{hinweis}</p>}
        {weitere && <p class="grh-gs-weitere">{weitere}</p>}
        {foerdervereinText && <p>{foerdervereinText}</p>}
        {foerderverein && (
          <a class="grh-gs-foev" href={`/vereine/${foerderverein.slug}/`}>
            {foerderverein.title} →
          </a>
        )}
      </article>
    </div>
  </section>


  {/* === Rückblick: frühere Grundschule (weiteres Profil der Kategorie) === */}
  {frueher.map((f) => (
    <section class="grh-gs-block">
      <div class="grh-container grh-gs-frueher">
        {f.image && <img src={f.image} alt={f.title} loading="lazy" />}
        <div>
          <span class="grh-gs-section-eyebrow">Rückblick</span>
          <h2>{f.title.replace(/\s+[–-]\s+.*$/, '').replace(/^./, (c) => c.toUpperCase())}</h2>
          <p>{text(f.contentHtml)}</p>
        </div>
      </div>
    </section>
  ))}
</BaseLayout>

<style>
  /* === Hero ============================================================ */
  .grh-gs-head {
    padding: clamp(var(--grh-space-7), 10vw, var(--grh-space-9)) 0 var(--grh-space-6);
    background:
      radial-gradient(circle at 100% 0%, rgba(91, 174, 120, 0.10), transparent 55%),
      var(--grh-cream-50);
    border-bottom: 1px solid var(--grh-line);
  }
  .grh-gs-head__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--grh-space-6);
    align-items: center;
  }
  @media (min-width: 880px) {
    .grh-gs-head__grid { grid-template-columns: 1.2fr 1fr; gap: var(--grh-space-7); }
  }
  .grh-gs-crumb {
    font-family: var(--grh-font-body);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--grh-stone-400);
    margin: 0 0 var(--grh-space-4);
  }
  .grh-gs-eyebrow {
    display: inline-block;
    font-family: var(--grh-font-body);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    color: var(--grh-candle-500);
    font-weight: 700;
    margin-bottom: var(--grh-space-3);
  }
  .grh-gs-head__text h1 {
    font-family: var(--grh-font-display);
    font-size: clamp(2.2rem, 5.5vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--grh-forest-900);
    margin: 0 0 var(--grh-space-4);
  }
  .grh-gs-lead {
    font-family: var(--grh-font-display);
    font-style: normal;
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    line-height: 1.55;
    color: var(--grh-forest-800);
    max-width: 50ch;
    margin: 0 0 var(--grh-space-5);
  }
  .grh-gs-cta {
    display: inline-block;
    padding: 10px 18px;
    background: var(--grh-forest-900);
    color: var(--grh-cream-50);
    text-decoration: none;
    border-radius: var(--grh-radius-pill);
    font-family: var(--grh-font-body);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-weight: 700;
    transition: background var(--grh-dur-fast), transform var(--grh-dur-fast);
  }
  .grh-gs-cta:hover { background: var(--grh-moss-600); transform: translateY(-2px); }

  .grh-gs-photo {
    margin: 0;
    border-radius: var(--grh-radius-md);
    overflow: hidden;
    box-shadow: 0 16px 40px rgba(26, 61, 39, 0.15);
  }
  .grh-gs-photo img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
  }

  /* === Stats-Streifen ================================================= */
  .grh-gs-stats {
    background: var(--grh-forest-950);
    color: var(--grh-cream-50);
    padding: var(--grh-space-5) 0;
  }
  .grh-gs-stats ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--grh-space-4);
  }
  @media (min-width: 720px) {
    .grh-gs-stats ul { grid-template-columns: repeat(4, 1fr); }
  }
  .grh-gs-stats li {
    text-align: center;
  }
  .grh-gs-stats strong {
    display: block;
    font-family: var(--grh-font-display);
    font-style: normal;
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--grh-candle-300);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .grh-gs-stats span {
    display: block;
    font-family: var(--grh-font-body);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: rgba(250, 247, 241, 0.7);
    margin-top: 8px;
  }

  /* === Block / Section-Heads ========================================== */
  .grh-gs-block { padding: var(--grh-space-7) 0; }
  .grh-gs-block--alt { background: var(--grh-paper-100); }

  .grh-gs-section-head { margin-bottom: var(--grh-space-6); }
  .grh-gs-section-eyebrow {
    display: inline-block;
    font-family: var(--grh-font-body);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: var(--grh-moss-600);
    font-weight: 700;
    margin-bottom: var(--grh-space-2);
  }
  .grh-gs-section-head h2 {
    font-family: var(--grh-font-display);
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    color: var(--grh-forest-900);
    margin: 0;
    letter-spacing: -0.02em;
  }

  /* === Feature-Kacheln ================================================ */
  .grh-gs-features {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--grh-space-4);
  }
  @media (min-width: 720px) {
    .grh-gs-features { grid-template-columns: repeat(2, 1fr); gap: var(--grh-space-5); }
  }
  .grh-gs-features article {
    background: var(--grh-cream-50);
    border-radius: var(--grh-radius-md);
    padding: var(--grh-space-5);
    border-left: 3px solid var(--grh-candle-500);
  }
  .grh-gs-features h3 {
    font-family: var(--grh-font-display);
    font-size: var(--grh-fs-xl);
    color: var(--grh-forest-900);
    margin: 0 0 var(--grh-space-3);
    letter-spacing: -0.015em;
  }
  .grh-gs-features p {
    font-size: var(--grh-fs-md);
    color: var(--grh-stone-700);
    line-height: 1.6;
    margin: 0;
  }

  /* === Kontakt + Förderverein ========================================= */
  .grh-gs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--grh-space-5);
  }
  @media (min-width: 800px) {
    .grh-gs-grid { grid-template-columns: 1.5fr 1fr; gap: var(--grh-space-6); }
  }
  .grh-gs-card {
    background: var(--grh-cream-50);
    border: 1px solid var(--grh-line);
    border-radius: var(--grh-radius-md);
    padding: var(--grh-space-5) var(--grh-space-6);
    display: flex;
    flex-direction: column;
    gap: var(--grh-space-3);
  }
  .grh-gs-card--accent {
    background:
      radial-gradient(circle at 100% 0%, rgba(212, 165, 92, 0.12), transparent 60%),
      var(--grh-cream-50);
    border-color: var(--grh-candle-500);
  }
  .grh-gs-card__label {
    font-family: var(--grh-font-body);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: var(--grh-moss-600);
    font-weight: 700;
  }
  .grh-gs-card h2 {
    font-family: var(--grh-font-display);
    font-size: var(--grh-fs-2xl);
    color: var(--grh-forest-900);
    margin: 0;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .grh-gs-card p {
    font-size: var(--grh-fs-md);
    color: var(--grh-stone-700);
    line-height: 1.6;
    margin: 0;
  }
  .grh-gs-card strong { color: var(--grh-forest-900); font-weight: 600; }

  .grh-gs-contact {
    margin-top: var(--grh-space-3);
    padding-top: var(--grh-space-3);
    border-top: 1px solid var(--grh-line);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .grh-gs-contact strong {
    font-family: var(--grh-font-display);
    font-size: var(--grh-fs-md);
    color: var(--grh-forest-900);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .grh-gs-contact > span {
    font-size: var(--grh-fs-sm);
    color: var(--grh-stone-700);
    line-height: 1.5;
  }
  .grh-gs-contact ul {
    list-style: none;
    padding: 0;
    margin: var(--grh-space-3) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--grh-space-2);
  }
  .grh-gs-contact ul li {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .grh-gs-contact ul span {
    font-family: var(--grh-font-body);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--grh-stone-400);
    font-weight: 700;
  }
  .grh-gs-contact ul a {
    font-family: var(--grh-font-display);
    font-style: normal;
    color: var(--grh-forest-800);
    text-decoration: none;
    border-bottom: 1.5px solid var(--grh-candle-500);
    width: fit-content;
    padding-bottom: 2px;
    word-break: break-word;
  }
  .grh-gs-contact ul a:hover { color: var(--grh-moss-600); }

  .grh-gs-foev {
    margin-top: auto;
    align-self: flex-start;
    font-family: var(--grh-font-body);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-weight: 700;
    color: var(--grh-forest-800);
    text-decoration: none;
    border-bottom: 1.5px solid var(--grh-candle-500);
    padding-bottom: 2px;
  }
  .grh-gs-foev:hover { color: var(--grh-moss-600); }
  .grh-gs-ueber { max-width: 820px; }
  .grh-gs-prose :global(p) { margin: 0 0 var(--grh-space-4); line-height: 1.7; color: var(--grh-stone-700); }
  .grh-gs-prose :global(p:last-child) { margin-bottom: 0; }
  .grh-gs-prose :global(h6) { font-family: var(--grh-font-display); font-size: var(--grh-fs-lg); font-weight: 500; color: var(--grh-forest-900); margin: 0 0 var(--grh-space-3); letter-spacing: 0; text-transform: none; }
  .grh-gs-weitere { white-space: pre-line; font-size: 14px; }
  .grh-gs-frueher { display: grid; grid-template-columns: 1fr; gap: var(--grh-space-5); align-items: start; }
  @media (min-width: 880px) { .grh-gs-frueher { grid-template-columns: 320px 1fr; gap: var(--grh-space-6); } }
  .grh-gs-frueher img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; border-radius: var(--grh-radius-md); }
  .grh-gs-frueher h2 { font-family: var(--grh-font-display); font-weight: 500; font-size: var(--grh-fs-xl); color: var(--grh-forest-900); margin: 4px 0 var(--grh-space-3); }
  .grh-gs-frueher p { margin: 0; color: var(--grh-stone-700); line-height: 1.65; max-width: 70ch; }
</style>
