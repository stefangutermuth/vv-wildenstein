---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GrhCPTDetail from '../../components/global/GrhCPTDetail.astro';
import GrhTerminProgramm from '../../components/global/GrhTerminProgramm.astro';
import GrhHighlightSeite from '../../components/global/GrhHighlightSeite.astro';
import { getEvents } from '../../lib/cms';
import { HIGHLIGHT_KATEGORIE, kurzTitel } from '../../lib/highlight';

export async function getStaticPaths() {
  // Auch vergangene Termine: Der Kalender verlinkt sein Archiv, und ohne
  // diese Seiten liefen 288 Verweise ins Leere (Prüfung 22.09.2026).
  const list = await getEvents({ includePast: true });
  return list.map((e) => ({
    params: { slug: e.slug },
    props: { event: e },
  }));
}

const { event } = Astro.props as { event: Awaited<ReturnType<typeof getEvents>>[number] };
const fmt = new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: 'long', year: 'numeric' });
const fmtTime = new Intl.DateTimeFormat('de-DE', { hour: '2-digit', minute: '2-digit' });
const meta = event.endDate
  ? `${fmt.format(event.startDate)} bis ${fmt.format(event.endDate)}`
  : event.allDay
    ? fmt.format(event.startDate)
    : `${fmt.format(event.startDate)} · ${fmtTime.format(event.startDate)} Uhr`;
const detail = {
  title: event.title,
  breadcrumb: `Veranstaltungen${event.ortsteil ? ' · ' + event.ortsteil.replace(/^./, (c) => c.toUpperCase()) : ''}`,
  eyebrow: event.location || 'Termin',
  image: event.image,
  meta,
  backHref: '/veranstaltungen',
  backLabel: 'Alle Termine',
};
---
{event.categories?.includes(HIGHLIGHT_KATEGORIE) && event.descriptionHtml ? (
  <BaseLayout
    title={`${kurzTitel(event.title)} ${event.startDate.getFullYear()} · Grünhainichen`}
    description={event.teaser}
    header="compact"
  >
    <GrhHighlightSeite event={event} />
  </BaseLayout>
) : (
  <BaseLayout title={`${event.title} · Veranstaltungen · Grünhainichen`} header="compact">
    {event.descriptionHtml ? (
      <GrhCPTDetail {...detail}>
        <GrhTerminProgramm html={event.descriptionHtml} />
      </GrhCPTDetail>
    ) : (
      <GrhCPTDetail {...detail} contentHtml={`<p>${event.teaser}</p>`} />
    )}
  </BaseLayout>
)}
