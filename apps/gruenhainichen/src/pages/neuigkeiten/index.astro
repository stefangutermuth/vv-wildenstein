---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GrhPageHeader from '../../components/global/GrhPageHeader.astro';
import GrhCardGrid from '../../components/global/GrhCardGrid.astro';
import GrhPagination from '../../components/global/GrhPagination.astro';
import { getNews } from '../../lib/cms';

const PAGE_SIZE = 12;

const all = await getNews();
const fmt = new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: 'long', year: 'numeric' });

function toCard(n: typeof all[number]) {
  return {
    href: `/neuigkeiten/${n.slug}`,
    title: n.title,
    image: n.image,
    eyebrow: n.category === 'sperrung' ? 'Sperrung' :
             n.category === 'veranstaltung' ? 'Veranstaltung' :
             n.category === 'tourismus' ? 'Tourismus' : 'Aktuelles',
    meta: fmt.format(n.date),
    body: n.excerpt,
  };
}

const totalPages = Math.max(1, Math.ceil(all.length / PAGE_SIZE));
const items = all.slice(0, PAGE_SIZE).map(toCard);
const newestBuildDate = all[0]?.date?.toISOString() ?? new Date().toISOString();

const WP_API_BASE =
  (import.meta.env.PUBLIC_WP_API_BASE as string | undefined) ??
  (typeof process !== 'undefined' ? process.env.PUBLIC_WP_API_BASE : undefined) ??
  'https://vv-wildenstein.com/wp-json/wp/v2';
---
<BaseLayout title="Neuigkeiten · Grünhainichen" header="compact">
  <GrhPageHeader
    title="Neuigkeiten"
    breadcrumb="Startseite · Neuigkeiten"
    lead="Was unsere Gemeinde gerade beschäftigt — Mitteilungen, Sperrungen, Veranstaltungshinweise."
    count={all.length}
    countLabel="Beiträge"
  />
  <section>
    <div class="grh-container">
      {/* Live-Update-Slot: JS prepend hier ganz oben ins Grid, wenn WP neue Posts hat */}
      <div class="grh-news-live" data-grh-news-live hidden>
        <span class="grh-news-live__dot" aria-hidden="true"></span>
        <span data-grh-news-live-label>Neue Beiträge sind erschienen</span>
        <button type="button" class="grh-news-live__btn" data-grh-news-live-refresh>Seite neu laden →</button>
      </div>

      <GrhCardGrid items={items} empty="Aktuell sind keine Neuigkeiten verfügbar." />
      <GrhPagination
        currentPage={1}
        totalPages={totalPages}
        baseHref="/neuigkeiten"
        label="Beiträge"
        total={all.length}
      />
    </div>
  </section>

  <script is:inline define:vars={{ WP_API_BASE, newestBuildDate }}>
    (() => {
      const banner = document.querySelector('[data-grh-news-live]');
      const label = document.querySelector('[data-grh-news-live-label]');
      if (!banner || !label) return;

      const check = async () => {
        try {
          const r = await fetch(`${WP_API_BASE}/posts?after=${encodeURIComponent(newestBuildDate)}&per_page=10&_fields=id,slug,title,date`);
          if (!r.ok) return;
          const posts = await r.json();
          if (Array.isArray(posts) && posts.length > 0) {
            label.textContent = posts.length === 1
              ? '1 neuer Beitrag seit dem letzten Deploy'
              : `${posts.length} neue Beiträge seit dem letzten Deploy`;
            banner.hidden = false;
          }
        } catch {}
      };

      document.querySelector('[data-grh-news-live-refresh]')?.addEventListener('click', () => location.reload());

      // Erst kurz warten, dann prüfen — nicht direkt beim Page-Load
      setTimeout(check, 800);
    })();
  </script>

  <style>
    .grh-news-live {
      display: flex; align-items: center; gap: var(--grh-space-3);
      padding: var(--grh-space-3) var(--grh-space-4);
      margin-bottom: var(--grh-space-4);
      background: rgba(63,108,74,0.08);
      border: 1px solid var(--grh-moss-500);
      border-radius: var(--grh-radius-md);
      font-size: 14px; color: var(--grh-forest-900);
    }
    .grh-news-live[hidden] { display: none; }
    .grh-news-live__dot {
      width: 10px; height: 10px; border-radius: 50%;
      background: var(--grh-alert-600, #b02f2f);
      animation: grh-news-pulse 1.6s ease-in-out infinite;
    }
    @keyframes grh-news-pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(1.3); }
    }
    .grh-news-live__btn {
      margin-left: auto;
      background: transparent; border: 0; padding: 0;
      color: var(--grh-forest-800); font: inherit;
      cursor: pointer; text-decoration: none;
      border-bottom: 1px solid var(--grh-candle-500);
      font-weight: 600;
    }
    .grh-news-live__btn:hover { color: var(--grh-moss-600); }
  </style>
</BaseLayout>
