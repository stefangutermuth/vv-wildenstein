---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GrhPageHeader from '../../components/global/GrhPageHeader.astro';
import GrhCardGrid from '../../components/global/GrhCardGrid.astro';
import { getProfile } from '../../lib/cms-cpt';

const profile = await getProfile();

const items = profile
  .sort((a, b) => a.title.localeCompare(b.title, 'de'))
  .map((p) => ({
    href: `/gewerbe/${p.slug}`,
    title: p.title,
    image: p.image,
    eyebrow: p.kategorien[0]?.replace(/-/g, ' ').replace(/^./, c => c.toUpperCase()),
    meta: [p.kontakt?.plz_ort, p.ortsteil].filter(Boolean).join(' · '),
  }));
---
<BaseLayout title="Gewerbe · Grünhainichen" header="compact">
  <GrhPageHeader
    title="Gewerbe & Firmen"
    breadcrumb="Startseite · Gewerbe"
    lead="Vom Holzhandwerk bis zur Pension: Unternehmen aus Grünhainichen, Borstendorf und Waldkirchen."
    count={items.length}
    countLabel="Profile"
  />
  <section>
    <div class="grh-container">
      <GrhCardGrid items={items} empty="Es sind aktuell keine Firmen-Profile gepflegt." />
    </div>
  </section>
</BaseLayout>
