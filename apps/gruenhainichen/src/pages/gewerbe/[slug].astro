---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GrhCPTDetail from '../../components/global/GrhCPTDetail.astro';
import { getProfile } from '../../lib/cms-cpt';

export async function getStaticPaths() {
  const list = await getProfile();
  return list.map((p) => ({
    params: { slug: p.slug },
    props: { profil: p },
  }));
}

const { profil } = Astro.props as { profil: Awaited<ReturnType<typeof getProfile>>[number] };
const kategorie = profil.kategorien.find((k) => !k.startsWith('einkaufen-'))?.replace(/-/g, ' ').replace(/^./, c => c.toUpperCase());

/* Alle Profile aus WordPress haben ihre Detailseite hier, nicht nur Firmen.
   Brotkrume und Zurück-Link richten sich deshalb nach der Kategorie: eine
   Kirche gehört unter „Leben · Kirche“, nicht unter „Gewerbe“. */
const BEREICHE: Array<{ kat: string[]; crumb: string; href: string; label: string }> = [
  { kat: ['kirchen'], crumb: 'Leben · Kirche', href: '/leben/kirche/', label: 'Alle Kirchen' },
  { kat: ['schule'], crumb: 'Leben · Grundschule', href: '/leben/grundschule/', label: 'Zur Grundschule' },
  { kat: ['kindergarten', 'hort-waldis-kids'], crumb: 'Leben · Kita & Hort', href: '/leben/kita/', label: 'Alle Kitas' },
  { kat: ['allgemeine-medizin', 'zahnarzt', 'physiotherapie', 'apotheke'], crumb: 'Leben · Gesundheit', href: '/leben/gesundheit/', label: 'Gesundheit' },
  { kat: ['senioren'], crumb: 'Leben · Senioren', href: '/leben/', label: 'Leben in der Gemeinde' },
];
const bereich = BEREICHE.find((b) => b.kat.some((k) => profil.kategorien.includes(k)));
const ort = profil.ortsteil ? ' · ' + profil.ortsteil.replace(/^./, c => c.toUpperCase()) : '';
const crumb = (bereich?.crumb ?? 'Gewerbe') + ort;
const seitenBereich = bereich ? bereich.crumb.split(' · ').pop() : 'Gewerbe';
---
<BaseLayout title={`${profil.title} · ${seitenBereich} · Grünhainichen`} header="compact">
  <GrhCPTDetail
    title={profil.title}
    breadcrumb={crumb}
    eyebrow={kategorie ?? 'Firma'}
    image={profil.image}
    contentHtml={profil.contentHtml}
    kontakt={profil.kontakt}
    backHref={bereich?.href ?? '/gewerbe'}
    backLabel={bereich?.label ?? 'Alle Firmen'}
  />
</BaseLayout>
