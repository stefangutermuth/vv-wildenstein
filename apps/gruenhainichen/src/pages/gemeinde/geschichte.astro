---
import BaseLayout from '../../layouts/BaseLayout.astro';

interface TimelineEntry {
  year: string;
  title: string;
  body: string;
  era?: string;
}

const timeline: TimelineEntry[] = [
  { era: 'Mittelalter', year: '1349', title: 'Erste urkundliche Erwähnung', body: 'Grünhainichen taucht als „Heinchin" im Lehnbuch Friedrich III. des Strengen auf.' },
  { era: 'Reformation', year: '1539', title: 'Parochie Waldkirchen', body: 'Mit der Reformation wird der Ort zur Parochie Waldkirchen — Amtsdorf des Amtes Augustusburg.' },
  { year: '1579', title: 'Wiege der Holzkunst', body: 'Löffelmacher Hanse Oehmen wird dokumentiert — wahrscheinlich der älteste Nachweis von Holzwarenherstellung im gesamten Erzgebirge.' },
  { year: '1650', title: 'Handwerk wird Welt-Geschäft', body: 'Tischler, Kästel-, Geigen- und Trommelmacher fertigen in Grünhainichen. Eine Spanziehmühle entsteht. Die Waren gehen auf die Messen in Frankfurt, Leipzig und Dresden.' },
  { era: 'Aufbruch', year: '1750', title: 'Steinerne Brücke über die Flöha', body: 'Die alte Furt wird durch eine massive Brücke ersetzt — Lebensader für Handel und Verkehr ins Tal.' },
  { year: '1787', title: 'Erste Schule, erster Arzt', body: 'Das erste Schulgebäude wird errichtet, gleichzeitig nimmt der erste Arzt seine Tätigkeit auf.' },
  { year: '1848', title: 'Eigenständige Parochie', body: 'Grünhainichen wird selbstständige Kirchgemeinde, Borstendorf zur Filialkirche.' },
  { year: '1850', title: 'Kirche eingeweiht', body: 'Am 14. Oktober wird die Grünhainichener Kirche feierlich eingeweiht.' },
  { era: 'Industrielles Zeitalter', year: '1875', title: 'Anschluss an die Welt', body: 'Am 24. Mai erreicht die Eisenbahn Grünhainichen. Im selben Jahr wird die Freiwillige Feuerwehr gegründet.' },
  { year: '1879', title: 'Spielwaren- und Gewerbeschule', body: 'Die Staatliche Spielwaren- und Gewerbeschule entsteht — sie prägt Generationen erzgebirgischer Holzkünstler.' },
  { year: '1881', title: 'Papierfabrik Siegel & Haase', body: 'Beginn der industriellen Papierproduktion am Ort.' },
  { year: '1888', title: 'Wagner-Stiftung', body: 'Oswald Wagner gründet eine Stiftung für Menschen in Not — eine bis heute spürbare Geste des Bürgersinns.' },
  { year: '1900', title: 'Sieben Manufakturen, tausend Hände', body: 'Sieben Spielwarenbetriebe und über 1 000 Hausindustrielle leben in Grünhainichen vom Holz — das Dorf wird zur internationalen Adresse für erzgebirgisches Spielzeug.' },
  { year: '1907', title: 'Das Rathaus entsteht', body: 'Sichtbares Zeichen wachsender Bedeutung: das Rathaus an der Hauptstraße.' },
  { year: '1926', title: 'Freibad', body: 'In Borstendorf entsteht das Freibad — bis heute ein Sommer-Wahrzeichen.' },
  { year: '1937', title: 'Grete Wendt in Paris', body: 'Grete Wendt erhält für ihre Figuren auf der Weltausstellung Paris den Grand Prix und die Goldmedaille — der internationale Ritterschlag für das Grünhainichener Kunsthandwerk.' },
  { era: 'Nachkriegszeit & DDR', year: '1954', title: 'Schließung der Fachschule', body: 'Die Spielwarenfachschule wird geschlossen — eine Zäsur für die Ausbildung im Holzkunsthandwerk.' },
  { year: '1979', title: 'Die Spieldose wird aktiviert', body: 'Die Freilandspieldose mit den Weihnachtsfiguren nimmt ihren Betrieb auf — heute eines der Wahrzeichen des Ortes.' },
  { era: 'Drei Orte, eine Gemeinde', year: '1994', title: 'Verwaltungsverband „Wildenstein"', body: 'Grünhainichen wird Mitglied des Verwaltungsverbandes Wildenstein.' },
  { year: '2009', title: 'Fusion mit Waldkirchen', body: 'Am 1. März schließen sich Grünhainichen und Waldkirchen zu einer Gemeinde zusammen.' },
  { year: '2015', title: 'Borstendorf kommt dazu', body: 'Am 1. Januar wird auch Borstendorf eingegliedert — die heutige Gemeinde Grünhainichen mit drei Ortsteilen ist vollständig.' },
];

const highlights = [
  {
    eyebrow: 'Handwerk',
    title: 'Holz, Hände, Welt',
    body: 'Von einem einzelnen Löffelmacher 1579 bis zu 1 000 Hausindustriellen um 1900 — Grünhainichen ist die wahrscheinliche Wiege der erzgebirgischen Holzwarenherstellung. Tischler, Kästelmacher, Geigen- und Trommelmacher schickten ihre Waren nach Leipzig, Frankfurt und Dresden, später in die ganze Welt.',
  },
  {
    eyebrow: 'Eingemeindung',
    title: 'Drei Orte, ein Wappen',
    body: 'Was heute selbstverständlich wirkt, ist erst seit 2015 vollständig: 2009 schlossen sich Grünhainichen und Waldkirchen zusammen, 2015 kam Borstendorf dazu. Jeder Ortsteil bringt sein eigenes Wappen, seine eigene Kirche und seine eigene Geschichte mit.',
  },
  {
    eyebrow: 'Persönlichkeit',
    title: 'Grete Wendt',
    body: 'Holzbildhauerin, Gestalterin, Pionierin. Ihre Engel und Krippenfiguren machten Grünhainichen 1937 mit einem Grand Prix und einer Goldmedaille auf der Weltausstellung Paris international berühmt. Ihre Formensprache prägt das Erzgebirge bis heute.',
  },
];
---
<BaseLayout title="Geschichte · Gemeinde Grünhainichen" header="compact">

  <header class="grh-hist-head">
    <div class="grh-container">
      <p class="grh-hist-crumb">Gemeinde · Geschichte</p>
      <h1 class="grh-hist-title">
        <span class="grh-hist-eyebrow">Seit 1349 — eine Heimat im Wandel</span>
        Geschichte
      </h1>
      <p class="grh-hist-lead">
        Von der ersten urkundlichen Erwähnung als „Heinchin" über die Welt­ausstellung
        in Paris bis zur heutigen Gemeinde aus drei Orten — fast sieben Jahrhunderte
        erzgebirgisches Leben, Handwerk und Zusammenhalt.
      </p>
    </div>
  </header>

  <section class="grh-hist-block grh-hist-block--alt">
    <div class="grh-container">
      <div class="grh-hist-highlights">
        {highlights.map((h) => (
          <article class="grh-hist-highlight">
            <span class="grh-hist-highlight__eyebrow">{h.eyebrow}</span>
            <h2>{h.title}</h2>
            <p>{h.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="grh-hist-block">
    <div class="grh-container">
      <header class="grh-hist-section-head">
        <h2 class="grh-hist-section-title">Zeitstrahl</h2>
        <p class="grh-hist-section-sub">
          {timeline.length} Stationen aus fast 700 Jahren Gemeindegeschichte
        </p>
      </header>

      <ol class="grh-timeline">
        {timeline.map((t) => (
          <li class="grh-timeline__item">
            {t.era && <div class="grh-timeline__era">{t.era}</div>}
            <div class="grh-timeline__row">
              <div class="grh-timeline__year">{t.year}</div>
              <div class="grh-timeline__body">
                <h3>{t.title}</h3>
                <p>{t.body}</p>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <footer class="grh-hist-foot">
    <div class="grh-container">
      <p>
        Zusammenstellung nach den Chronik-Angaben der Gemeinde Grünhainichen.
        Ergänzungen, Korrekturen und Bildmaterial sind herzlich willkommen — bitte an
        <a href="mailto:info@wildenstein.ws">info@wildenstein.ws</a>.
      </p>
    </div>
  </footer>

</BaseLayout>

<style>
  .grh-hist-head {
    padding: clamp(var(--grh-space-7), 10vw, var(--grh-space-9)) 0 var(--grh-space-6);
    background:
      radial-gradient(circle at 100% 0%, rgba(212, 165, 92, 0.08), transparent 55%),
      var(--grh-cream-50);
    border-bottom: 1px solid var(--grh-line);
  }
  .grh-hist-crumb {
    font-family: var(--grh-font-body);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--grh-stone-400);
    margin: 0 0 var(--grh-space-5);
  }
  .grh-hist-eyebrow {
    display: block;
    font-family: var(--grh-font-body);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    color: var(--grh-candle-500);
    font-weight: 700;
    margin-bottom: var(--grh-space-3);
  }
  .grh-hist-title {
    font-family: var(--grh-font-display);
    font-size: clamp(3rem, 8vw, 5.6rem);
    line-height: 1;
    letter-spacing: -0.025em;
    color: var(--grh-forest-900);
    margin: 0 0 var(--grh-space-5);
  }
  .grh-hist-lead {
    font-family: var(--grh-font-display);
    font-style: italic;
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    line-height: 1.5;
    color: var(--grh-forest-800);
    max-width: 58ch;
    margin: 0;
  }

  .grh-hist-block { padding: var(--grh-space-8) 0; }
  .grh-hist-block--alt { background: var(--grh-paper-100); }

  .grh-hist-section-head {
    margin-bottom: var(--grh-space-6);
    text-align: center;
  }
  .grh-hist-section-title {
    font-family: var(--grh-font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--grh-forest-900);
    letter-spacing: -0.02em;
    margin: 0 0 8px;
  }
  .grh-hist-section-sub {
    font-family: var(--grh-font-body);
    font-size: var(--grh-fs-sm);
    color: var(--grh-stone-400);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }

  .grh-hist-highlights {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--grh-space-5);
  }
  @media (min-width: 800px) {
    .grh-hist-highlights { grid-template-columns: repeat(3, 1fr); gap: var(--grh-space-6); }
  }
  .grh-hist-highlight {
    background: var(--grh-cream-50);
    border-radius: var(--grh-radius-md);
    padding: var(--grh-space-5);
    border-left: 3px solid var(--grh-candle-500);
  }
  .grh-hist-highlight__eyebrow {
    font-family: var(--grh-font-body);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: var(--grh-moss-600);
    font-weight: 700;
    display: block;
    margin-bottom: 8px;
  }
  .grh-hist-highlight h2 {
    font-family: var(--grh-font-display);
    font-size: var(--grh-fs-xl);
    color: var(--grh-forest-900);
    margin: 0 0 var(--grh-space-3);
    letter-spacing: -0.015em;
    line-height: 1.2;
  }
  .grh-hist-highlight p {
    font-size: var(--grh-fs-sm);
    color: var(--grh-stone-700);
    line-height: 1.6;
    margin: 0;
  }

  .grh-timeline {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    max-width: 800px;
    position: relative;
  }
  .grh-timeline::before {
    content: '';
    position: absolute;
    left: 92px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--grh-line);
  }
  @media (max-width: 640px) {
    .grh-timeline::before { left: 60px; }
  }
  .grh-timeline__item {
    position: relative;
    padding-bottom: var(--grh-space-5);
  }
  .grh-timeline__era {
    font-family: var(--grh-font-body);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    color: var(--grh-candle-500);
    font-weight: 700;
    background: var(--grh-paper-100);
    display: inline-block;
    padding: 4px 10px;
    border-radius: var(--grh-radius-pill);
    margin-left: 110px;
    margin-bottom: var(--grh-space-3);
    margin-top: var(--grh-space-4);
  }
  @media (max-width: 640px) {
    .grh-timeline__era { margin-left: 78px; }
  }
  .grh-timeline__row {
    display: grid;
    grid-template-columns: 92px 1fr;
    gap: var(--grh-space-4);
    align-items: start;
  }
  @media (max-width: 640px) {
    .grh-timeline__row { grid-template-columns: 60px 1fr; gap: var(--grh-space-3); }
  }
  .grh-timeline__year {
    font-family: var(--grh-font-display);
    font-style: italic;
    font-size: var(--grh-fs-lg);
    color: var(--grh-forest-900);
    text-align: right;
    padding-right: var(--grh-space-3);
    line-height: 1.3;
    letter-spacing: -0.01em;
    position: relative;
  }
  .grh-timeline__year::after {
    content: '';
    position: absolute;
    right: -7px;
    top: 10px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--grh-candle-500);
    border: 3px solid var(--grh-cream-50);
    z-index: 1;
  }
  @media (max-width: 640px) {
    .grh-timeline__year { font-size: var(--grh-fs-md); }
    .grh-timeline__year::after { right: -7px; top: 6px; }
  }
  .grh-timeline__body {
    padding-left: var(--grh-space-3);
  }
  .grh-timeline__body h3 {
    font-family: var(--grh-font-display);
    font-size: var(--grh-fs-md);
    color: var(--grh-forest-900);
    margin: 0 0 6px;
    letter-spacing: -0.01em;
    font-weight: 500;
    line-height: 1.25;
  }
  .grh-timeline__body p {
    font-size: var(--grh-fs-sm);
    color: var(--grh-stone-700);
    line-height: 1.6;
    margin: 0;
    max-width: 60ch;
  }

  .grh-hist-foot {
    padding: var(--grh-space-6) 0 var(--grh-space-8);
    border-top: 1px solid var(--grh-line);
    background: var(--grh-cream-50);
  }
  .grh-hist-foot p {
    font-family: var(--grh-font-display);
    font-style: italic;
    font-size: var(--grh-fs-sm);
    color: var(--grh-stone-700);
    text-align: center;
    max-width: 56ch;
    margin: 0 auto;
    line-height: 1.6;
  }
  .grh-hist-foot a {
    color: var(--grh-forest-800);
    border-bottom: 1px solid var(--grh-candle-500);
    text-decoration: none;
  }
  .grh-hist-foot a:hover { color: var(--grh-moss-600); }
</style>
