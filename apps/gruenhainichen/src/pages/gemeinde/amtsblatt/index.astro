---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GrhPageHeader from '../../../components/global/GrhPageHeader.astro';
import { getAmtsblaetter } from '../../../lib/cms-cpt';

const all = await getAmtsblaetter();

// Gruppiert nach Jahr
const byYear = new Map<string, typeof all>();
for (const a of all) {
  const list = byYear.get(a.jahr) ?? [];
  list.push(a);
  byYear.set(a.jahr, list);
}
const years = Array.from(byYear.keys()).sort((a, b) => Number(b) - Number(a));

/* Monatsmarke aus der AUSGABE, nicht aus dem Erscheinungsdatum.
   Das Amtsblatt 08/2026 kam am 31. Juli heraus — nach dem Erscheinen
   beschriftet trug es die Marke „jul" und stand scheinbar im falschen Monat. */
const MONATE = ['Januar','Februar','März','April','Mai','Juni','Juli','August','September','Oktober','November','Dezember'];
const monatsName = (m: number) => MONATE[Math.min(Math.max(m, 1), 12) - 1];
const nummer = (m: number) => String(m).padStart(2, '0');
const mb = (b: number) => (b > 0 ? `${(b / 1048576).toFixed(1).replace('.', ',')} MB` : '');
const fmtFull  = new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: 'long', year: 'numeric' });
---
<BaseLayout title="Amtsblatt · Grünhainichen" header="compact">
  <GrhPageHeader
    title="Amtsblatt"
    breadcrumb="Gemeinde · Amtsblatt"
    lead="Alle Ausgaben des Amtsblatts zum Herunterladen — Beschlüsse, Bekanntmachungen, Termine."
    count={all.length}
    countLabel="Ausgaben"
  />

  <section class="grh-amtsblatt">
    <div class="grh-container grh-amtsblatt__grid">
      <div class="grh-amtsblatt__list">
        {years.map((year) => (
          <article class="grh-amtsblatt__year">
            <h2>{year}</h2>
            <ul>
              {byYear.get(year)!.map((a) => (
                <li>
                  {/* Die Ausgabennummer ist der Anker der Zeile — groß in der
                      Display-Schrift, der Monat ausgeschrieben darunter. Das ist
                      dasselbe Muster wie bei den Veranstaltungen (Tageszahl +
                      Monat), damit die Seite eine Sprache spricht. */}
                  <span class="grh-amtsblatt__nr" aria-hidden="true">
                    <strong>{nummer(a.monat)}</strong>
                    <em>{monatsName(a.monat)}</em>
                  </span>
                  <div class="grh-amtsblatt__meta">
                    <h3>{a.title}</h3>
                    <time datetime={a.date.toISOString().slice(0, 10)}>
                      Erschienen am {fmtFull.format(a.date)}
                    </time>
                  </div>
                  {/* Ohne PDF gar keinen Knopf: Der bisherige Rückfall zeigte
                      auf die WordPress-Seite der Ausgabe, die nur den Titel und
                      ein Suchfeld enthält — ein Knopf, der nichts öffnet, ist
                      schlechter als kein Knopf. Zur Zeit haben alle 71 Ausgaben
                      eine PDF; der Fall bleibt für den Notfall stehen. */}
                  {a.pdfUrl ? (
                    <a
                      class="grh-amtsblatt__dl"
                      href={a.pdfUrl}
                      target="_blank"
                      rel="noopener"
                      aria-label={`${a.title} als PDF öffnen${a.groesse ? `, ${mb(a.groesse)}` : ''}`}
                    >
                      <span class="grh-amtsblatt__dl-typ">PDF{a.groesse ? ` · ${mb(a.groesse)}` : ''}</span>
                      <span class="grh-amtsblatt__dl-cta">Öffnen <span aria-hidden="true">→</span></span>
                    </a>
                  ) : (
                    <span class="grh-amtsblatt__dl grh-amtsblatt__dl--fehlt">
                      folgt
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </article>
        ))}
        {all.length === 0 && (
          <p class="grh-amtsblatt__empty">Aktuell sind keine Amtsblätter verfügbar.</p>
        )}
      </div>

      {/* === Info-Sidebar === */}
      <aside class="grh-amtsblatt__info" aria-labelledby="info-title">
        <h2 id="info-title">Wissenswertes</h2>

        {/* Wichtige Downloads direkt oben */}
        <div class="grh-amtsblatt__pdfs">
          <a
            class="grh-amtsblatt__pdf"
            href="https://vv-wildenstein.com/wp-content/uploads/2022/12/Terminplan-2026_Redaktion_fuer-EXTERN_PDF.pdf"
            target="_blank"
            rel="noopener"
          >
            <span class="grh-amtsblatt__pdf-tag">PDF</span>
            <span class="grh-amtsblatt__pdf-name">Terminplan 2026</span>
            <span class="grh-amtsblatt__pdf-sub">Redaktionsschluss-Daten</span>
          </a>
          <a
            class="grh-amtsblatt__pdf"
            href="https://vv-wildenstein.com/wp-content/uploads/2025/01/Anzeigenpreise-ab-01.02.2025.pdf"
            target="_blank"
            rel="noopener"
          >
            <span class="grh-amtsblatt__pdf-tag">PDF</span>
            <span class="grh-amtsblatt__pdf-name">Anzeigenpreise</span>
            <span class="grh-amtsblatt__pdf-sub">gültig ab 01.02.2025</span>
          </a>
        </div>

        <dl>
          <dt>Erscheinungsweise</dt>
          <dd>Monatlich — Anfang jedes Monats.</dd>

          <dt>Auflage</dt>
          <dd>2.310 Exemplare</dd>

          <dt>Verteilung</dt>
          <dd>Kostenlose Zustellung an alle Haushalte der Verbandsgemeinden.</dd>

          <dt>Abgabetermin</dt>
          <dd>Texte, Berichte und Inserate i. d. R. Mitte des Vormonats. Genaue Daten siehe Terminplan.</dd>

          <dt>Herausgeber</dt>
          <dd>Verwaltungsverband „Wildenstein"<br />vertreten durch den Verbandsvorsitzenden und die Bürgermeister der Verbandsgemeinden</dd>
        </dl>

        <div class="grh-amtsblatt__contact">
          <strong>Ansprechpartnerin</strong>
          <p>Frau Schubert · Verwaltungsverband Wildenstein<br />Chemnitzer Straße 41, 09579 Grünhainichen</p>
          <a href="tel:+4937294170-32">037294 / 170-32</a>
          <a href="tel:+4937294170-0">037294 / 170-0</a>
          <a href="mailto:k.schubert@wildenstein.ws">k.schubert@wildenstein.ws</a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .grh-amtsblatt { padding: var(--grh-space-6) 0 var(--grh-space-9); }
  .grh-amtsblatt__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--grh-space-7);
    align-items: start;
  }
  @media (min-width: 880px) {
    .grh-amtsblatt__grid { grid-template-columns: minmax(0, 1fr) 300px; gap: var(--grh-space-7); }
  }

  /* === Liste — kompakter, mit Monatschip links =========================== */
  .grh-amtsblatt__year { margin-bottom: var(--grh-space-5); }
  .grh-amtsblatt__year h2 {
    font-family: var(--grh-font-display);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    color: var(--grh-forest-900);
    margin: 0 0 var(--grh-space-2);
    letter-spacing: -0.02em;
    border-bottom: 2px solid var(--grh-candle-500);
    display: inline-block;
    padding-bottom: 2px;
  }
  .grh-amtsblatt__year ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .grh-amtsblatt__year li {
    display: grid;
    grid-template-columns: 72px 1fr auto;
    align-items: center;
    gap: var(--grh-space-4);
    padding: 12px 8px;
    margin: 0 -8px;
    border-bottom: 1px solid var(--grh-line);
    border-radius: var(--grh-radius-sm);
    transition: background var(--grh-dur-fast);
  }
  .grh-amtsblatt__year li:hover { background: var(--grh-paper-100); }

  /* Ausgabennummer als Kalenderblatt: Nummer groß, Monat klein darunter. */
  .grh-amtsblatt__nr {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 72px;
    padding: 8px 4px 7px;
    background: var(--grh-sage-100);
    border-radius: var(--grh-radius-md);
    line-height: 1;
  }
  .grh-amtsblatt__nr strong {
    font-family: var(--grh-font-display);
    font-weight: 500;
    font-size: 1.55rem;
    letter-spacing: -0.03em;
    color: var(--grh-forest-900);
  }
  .grh-amtsblatt__nr em {
    font-family: var(--grh-font-body);
    font-style: normal;
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--grh-forest-700);
    margin-top: 5px;
    max-width: 68px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .grh-amtsblatt__meta {
    min-width: 0;
  }
  .grh-amtsblatt__meta h3 {
    font-family: var(--grh-font-display);
    font-size: var(--grh-fs-md);
    font-weight: 500;
    color: var(--grh-forest-900);
    margin: 0;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .grh-amtsblatt__meta time {
    font-family: var(--grh-font-body);
    font-size: 11px;
    color: var(--grh-stone-400);
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }
  .grh-amtsblatt__dl {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 3px;
    text-decoration: none;
    color: var(--grh-forest-800);
    white-space: nowrap;
  }
  .grh-amtsblatt__dl-typ {
    font-family: var(--grh-font-body);
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--grh-stone-400);
  }
  .grh-amtsblatt__dl-cta {
    font-family: var(--grh-font-body);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-weight: 700;
    padding: 6px 12px;
    border: 1px solid var(--grh-forest-800);
    border-radius: var(--grh-radius-pill);
    transition: background var(--grh-dur-fast), color var(--grh-dur-fast);
  }
  .grh-amtsblatt__dl:hover .grh-amtsblatt__dl-cta {
    background: var(--grh-forest-900);
    color: var(--grh-cream-50);
  }
  .grh-amtsblatt__dl--alt { color: var(--grh-stone-700); border-color: var(--grh-line); }

  /* Ausgabe ohne hinterlegte PDF — kein Knopf, nur ein Vermerk. */
  .grh-amtsblatt__dl--fehlt {
    border-style: dashed;
    color: var(--grh-stone-400);
    cursor: default;
    pointer-events: none;
  }
  .grh-amtsblatt__empty {
    text-align: center;
    color: var(--grh-stone-400);
    font-style: italic;
    font-family: var(--grh-font-display);
    padding: var(--grh-space-7) 0;
  }

  /* === Info-Sidebar ===================================================== */
  .grh-amtsblatt__info {
    background: var(--grh-paper-100);
    border-radius: var(--grh-radius-md);
    padding: var(--grh-space-5);
    position: sticky;
    top: var(--grh-space-6);
  }
  .grh-amtsblatt__info h2 {
    font-family: var(--grh-font-display);
    font-size: var(--grh-fs-lg);
    color: var(--grh-forest-900);
    margin: 0 0 var(--grh-space-4);
    letter-spacing: -0.01em;
  }

  .grh-amtsblatt__pdfs {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: var(--grh-space-5);
  }
  .grh-amtsblatt__pdf {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: var(--grh-space-3);
    row-gap: 2px;
    align-items: center;
    padding: var(--grh-space-3) var(--grh-space-3);
    background: var(--grh-cream-50);
    border: 1px solid var(--grh-line);
    border-radius: var(--grh-radius-sm);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--grh-dur-fast), transform var(--grh-dur-fast);
  }
  .grh-amtsblatt__pdf:hover {
    border-color: var(--grh-candle-500);
    transform: translateY(-1px);
  }
  .grh-amtsblatt__pdf-tag {
    grid-row: 1 / 3;
    align-self: center;
    font-family: var(--grh-font-body);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #b02f2f;
    background: rgba(176, 47, 47, 0.08);
    border: 1px solid rgba(176, 47, 47, 0.25);
    padding: 3px 7px;
    border-radius: var(--grh-radius-sm);
  }
  .grh-amtsblatt__pdf-name {
    font-family: var(--grh-font-display);
    font-size: var(--grh-fs-md);
    font-weight: 500;
    color: var(--grh-forest-900);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .grh-amtsblatt__pdf-sub {
    font-family: var(--grh-font-body);
    font-size: 11px;
    color: var(--grh-stone-400);
    letter-spacing: 0.04em;
  }
  .grh-amtsblatt__info dl {
    display: flex;
    flex-direction: column;
    gap: var(--grh-space-3);
    margin: 0;
  }
  .grh-amtsblatt__info dt {
    font-family: var(--grh-font-body);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--grh-stone-700);
    font-weight: 700;
    margin-bottom: 2px;
  }
  .grh-amtsblatt__info dd {
    font-size: var(--grh-fs-sm);
    color: var(--grh-forest-800);
    margin: 0;
    line-height: 1.5;
  }
  .grh-amtsblatt__contact {
    margin-top: var(--grh-space-5);
    padding-top: var(--grh-space-4);
    border-top: 1px solid var(--grh-line);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .grh-amtsblatt__contact strong {
    font-family: var(--grh-font-display);
    font-size: var(--grh-fs-md);
    font-weight: 500;
    color: var(--grh-forest-900);
    letter-spacing: -0.01em;
  }
  .grh-amtsblatt__contact p {
    font-size: var(--grh-fs-sm);
    color: var(--grh-stone-700);
    margin: 0 0 4px;
    line-height: 1.5;
  }
  .grh-amtsblatt__contact a {
    color: var(--grh-forest-800);
    text-decoration: none;
    font-size: var(--grh-fs-sm);
    border-bottom: 1px solid transparent;
    transition: border-color var(--grh-dur-fast);
    word-break: break-word;
  }
  .grh-amtsblatt__contact a:hover { border-color: var(--grh-candle-500); }
  @media (max-width: 560px) {
    .grh-amtsblatt__year li { grid-template-columns: 60px 1fr; }
    .grh-amtsblatt__nr { width: 60px; }
    .grh-amtsblatt__dl { grid-column: 2; align-items: flex-start; margin-top: 4px; }
  }
</style>
