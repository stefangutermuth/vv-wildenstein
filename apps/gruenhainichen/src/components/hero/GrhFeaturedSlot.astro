---
import GrhIcon from '../primitives/GrhIcon.astro';

interface CTA { label: string; href: string; variant?: 'primary' | 'secondary' | 'ghost' }
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  ctas?: CTA[];
  logo?: string;
  logoAlt?: string;
  /** Vorschaubild statt Logo (eckig, randlos beschnitten) */
  bild?: string;
  /** 'advent': große Karte mit Illustration, nur in der Adventszeit */
  variante?: 'standard' | 'advent';
  /** Kurzangabe über dem Titel der Adventskarte, z. B. „1. bis 24. Dezember" */
  datum?: string;
}
const { eyebrow, title, subtitle, ctas = [], logo, logoAlt = '', bild, variante = 'standard', datum } = Astro.props;

// Reduce auf einen Primary-CTA — der Slot soll kein Buffet sein
const primary = ctas[0];
---
{variante === 'advent' ? (
<a class="grh-advent grh-reveal" href={primary?.href ?? '#'}>
  {bild && (
    <span class="grh-advent__bild" aria-hidden="true">
      <img src={bild} alt="" width="900" height="412" loading="eager" decoding="async" />
      {[0, 1, 2, 3, 4, 5].map((i) => <span class="grh-advent__stern" style={`--i:${i}`}></span>)}
    </span>
  )}
  <span class="grh-advent__body">
    {(eyebrow || datum) && (
      <span class="grh-advent__eyebrow">
        {eyebrow}{eyebrow && datum && ' · '}{datum}
      </span>
    )}
    <span class="grh-advent__title">{title}</span>
    {subtitle && <span class="grh-advent__sub">{subtitle}</span>}
    {primary && (
      <span class="grh-advent__cta">
        {primary.label}
        <GrhIcon name="arrow-right" size={16} />
      </span>
    )}
  </span>
</a>
) : (
<a class="grh-pin grh-reveal" href={primary?.href ?? '#'} aria-label={`${eyebrow ?? ''} · ${title}`}>
  {bild ? (
    <span class="grh-pin__bild" aria-hidden="true">
      <img src={bild} alt="" width="64" height="64" loading="eager" decoding="async" />
    </span>
  ) : logo && (
    <span class="grh-pin__logo" aria-hidden="true">
      <img src={logo} alt={logoAlt} loading="eager" decoding="async" />
    </span>
  )}
  <span class="grh-pin__body">
    {eyebrow && <span class="grh-pin__eyebrow">{eyebrow}</span>}
    <span class="grh-pin__title">{title}</span>
    {subtitle && <span class="grh-pin__sub">{subtitle}</span>}
  </span>
  <span class="grh-pin__arrow" aria-hidden="true">
    <GrhIcon name="arrow-right" size={16} />
  </span>
</a>
)}

<style>
  /* === Adventskarte ====================================================
     Hintergrund im Grün des Plakats, damit die Zeichnung randlos übergeht. */
  .grh-advent {
    --advent-gruen: #21542e;
    display: flex;
    flex-direction: column;
    width: 100%;
    background: var(--advent-gruen);
    border: 1px solid rgba(232, 182, 88, 0.55);
    border-radius: 6px;
    overflow: hidden;
    color: var(--grh-cream-50);
    text-decoration: none;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.35), 0 0 0 4px rgba(232, 182, 88, 0.08);
    transition: transform var(--grh-dur-base), box-shadow var(--grh-dur-base);
  }
  .grh-advent:hover {
    transform: translateY(-3px);
    box-shadow: 0 24px 56px rgba(0, 0, 0, 0.4), 0 0 0 4px rgba(232, 182, 88, 0.18);
  }
  .grh-advent__bild {
    position: relative;
    display: block;
    padding: 12px 28px 0;
    background:
      radial-gradient(ellipse 60% 70% at 50% 40%, rgba(246, 221, 160, 0.22), transparent 70%),
      var(--advent-gruen);
  }
  .grh-advent__bild img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform var(--grh-dur-base);
  }
  .grh-advent:hover .grh-advent__bild img { transform: scale(1.03); }

  /* Kleine funkelnde Sterne über der Zeichnung */
  .grh-advent__stern {
    position: absolute;
    width: 6px; height: 6px;
    top: calc(8% + var(--i) * 3%);
    left: calc(6% + var(--i) * 17%);
    background: var(--grh-candle-300);
    clip-path: polygon(50% 0, 62% 38%, 100% 50%, 62% 62%, 50% 100%, 38% 62%, 0 50%, 38% 38%);
    transform: scale(1.6);
    opacity: 0.2;
    animation: grh-advent-funkeln 3.2s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.55s);
  }
  .grh-advent__stern:nth-child(odd) { top: calc(20% + var(--i) * 2%); }
  @keyframes grh-advent-funkeln {
    0%, 100% { opacity: 0.15; transform: scale(1.2); }
    50%      { opacity: 1;    transform: scale(2); }
  }
  @media (prefers-reduced-motion: reduce) {
    .grh-advent__stern { animation: none; opacity: 0.6; }
  }

  .grh-advent__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px 16px 16px;
    border-top: 1px solid rgba(232, 182, 88, 0.25);
  }
  .grh-advent__eyebrow {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--grh-candle-500);
    font-weight: 600;
  }
  .grh-advent__title {
    font-family: var(--grh-font-display);
    font-size: 1.3rem;
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--grh-candle-300);
  }
  .grh-advent__sub {
    font-size: 0.84rem;
    line-height: 1.4;
    color: rgba(250, 247, 241, 0.86);
  }
  .grh-advent__cta {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    padding: 7px 14px;
    border-radius: 999px;
    background: var(--grh-candle-500);
    color: var(--grh-forest-950);
    font-weight: 600;
    font-size: 0.84rem;
    transition: background var(--grh-dur-fast);
  }
  .grh-advent:hover .grh-advent__cta { background: var(--grh-candle-300); }

  .grh-pin {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--grh-space-3);
    align-items: center;
    padding: 12px 16px 12px 12px;
    background: rgba(250, 247, 241, 0.96);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(250, 247, 241, 0.6);
    border-left: 3px solid var(--grh-candle-500);
    border-radius: 2px;
    box-shadow: var(--grh-shadow-md);
    color: var(--grh-stone-700);
    text-decoration: none;
    transition: transform var(--grh-dur-base), box-shadow var(--grh-dur-base);
  }
  .grh-pin:hover {
    transform: translateY(-2px);
    box-shadow: var(--grh-shadow-lg);
  }

  .grh-pin__logo {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--grh-forest-900);
    display: grid; place-items: center;
    flex-shrink: 0;
  }
  .grh-pin__logo img {
    width: 85%; height: 85%;
    object-fit: contain;
  }

  .grh-pin__bild {
    width: 64px;
    height: 64px;
    border-radius: 2px;
    overflow: hidden;
    flex-shrink: 0;
    box-shadow: 0 0 0 1px rgba(26, 61, 39, 0.12);
  }
  .grh-pin__bild img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: 50% 72%; /* Plakate: eher das Foto als die Überschrift */
    transition: transform var(--grh-dur-base);
  }
  .grh-pin:hover .grh-pin__bild img { transform: scale(1.06); }

  .grh-pin__body {
    display: flex;
    flex-direction: column;
    gap: 0;
    min-width: 0;
  }
  .grh-pin__eyebrow {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--grh-moss-600);
    font-weight: 600;
    line-height: 1.4;
  }
  .grh-pin__title {
    font-family: var(--grh-font-display);
    font-size: var(--grh-fs-base);
    font-weight: 500;
    line-height: 1.2;
    color: var(--grh-forest-900);
    letter-spacing: -0.01em;
  }
  .grh-pin__sub {
    font-size: 11px;
    color: var(--grh-stone-400);
    line-height: 1.4;
    margin-top: 2px;
  }

  .grh-pin__arrow {
    color: var(--grh-forest-800);
    transition: transform var(--grh-dur-fast), color var(--grh-dur-fast);
    flex-shrink: 0;
    margin-left: 4px;
  }
  .grh-pin:hover .grh-pin__arrow {
    color: var(--grh-candle-500);
    transform: translateX(4px);
  }
</style>

