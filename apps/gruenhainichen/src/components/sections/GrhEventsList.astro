    align-items: center;
    gap: 8px;
    margin-top: var(--grh-space-3);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--grh-forest-800);
    font-weight: 700;
    border-bottom: 1.5px solid var(--grh-candle-500);
    padding-bottom: 4px;
    width: fit-content;
    transition: gap var(--grh-dur-base);
  }
  .grh-evs__multi-link:hover .grh-evs__multi-cta { gap: 14px; color: var(--grh-moss-600); }
</style>

<script>
  // Tagesveranstaltungen — Carousel + Live-Filter (Ort + Kategorie)
  document.querySelectorAll<HTMLElement>('[data-grh-evs-section]').forEach((section) => {
    const track = section.querySelector<HTMLElement>('[data-grh-carousel-track]');
    if (!track) return;

    const prev = section.querySelector<HTMLButtonElement>('[data-grh-carousel-prev]');
    const next = section.querySelector<HTMLButtonElement>('[data-grh-carousel-next]');
    const empty = section.querySelector<HTMLElement>('[data-grh-empty]');

    const step = () => {
      const card = track.querySelector<HTMLElement>('li:not([data-hidden])');
      if (!card) return 320;
      const gap = parseFloat(getComputedStyle(track).columnGap || '24');
      return card.offsetWidth + gap;
    };

    const updateButtons = () => {
      const max = track.scrollWidth - track.clientWidth - 1;
      if (prev) prev.disabled = track.scrollLeft <= 0;
      if (next) next.disabled = track.scrollLeft >= max;
    };

    prev?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next?.addEventListener('click', () => track.scrollBy({ left:  step(), behavior: 'smooth' }));
    track.addEventListener('scroll', updateButtons, { passive: true });
    window.addEventListener('resize', updateButtons);

    // Filter-Chips — pro Gruppe (ortsteil/category) gilt jeweils ein aktiver Wert
    const filterState: Record<string, string> = { ortsteil: '', category: '' };
    const applyFilters = () => {
      let visible = 0;
      track.querySelectorAll<HTMLElement>('li').forEach((item) => {
        const matchesOrt = !filterState.ortsteil || item.dataset.ortsteil === filterState.ortsteil;
        const matchesCat = !filterState.category || item.dataset.category === filterState.category;
        const show = matchesOrt && matchesCat;
        if (show) {
          item.removeAttribute('data-hidden');
          visible++;
        } else {
          item.setAttribute('data-hidden', '');
        }
      });
      if (empty) empty.hidden = visible > 0;
      track.scrollTo({ left: 0, behavior: 'smooth' });
      updateButtons();
    };

    section.querySelectorAll<HTMLElement>('[data-grh-filter-group]').forEach((group) => {
      const key = group.dataset.grhFilterGroup as 'ortsteil' | 'category';
      group.querySelectorAll<HTMLButtonElement>('button[data-grh-filter-value]').forEach((btn) => {
        btn.addEventListener('click', () => {
          group.querySelectorAll('button').forEach((b) => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          filterState[key] = btn.dataset.grhFilterValue || '';
          applyFilters();
        });
      });
    });

    updateButtons();

    /* === Drag-to-Scroll mit Inertia + Custom Cursor =================== */
    if (!window.matchMedia('(hover: hover)').matches) return;
    track.classList.add('is-grabbable');

    const THRESHOLD = 5;
    let pointerId: number | null = null;
    let startX = 0, startScroll = 0;
    let dragging = false;
    let lastX = 0, lastT = 0;
    let velocity = 0;
    let inertiaRaf = 0;

    const stopInertia = () => {
      if (inertiaRaf) { cancelAnimationFrame(inertiaRaf); inertiaRaf = 0; }
    };
    const startInertia = () => {
      stopInertia();
      let v = velocity;
      let last = performance.now();
      const FRICTION = 0.94;
      const STOP_AT = 0.02;
      const tick = () => {
        const now = performance.now();
        const dt = now - last;
        last = now;
        track.scrollLeft -= v * dt;
        v *= Math.pow(FRICTION, dt / 16);
        if (Math.abs(v) > STOP_AT) {
          inertiaRaf = requestAnimationFrame(tick);
        } else {
          inertiaRaf = 0;
        }
      };
      inertiaRaf = requestAnimationFrame(tick);
    };

    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') return;
      if (e.button !== 0) return;
      stopInertia();
      pointerId = e.pointerId;
      startX = e.clientX;
      startScroll = track.scrollLeft;
      lastX = e.clientX;
      lastT = performance.now();
      velocity = 0;
      dragging = false;
    });

    track.addEventListener('pointermove', (e) => {
      if (pointerId !== e.pointerId) return;
      const dx = e.clientX - startX;
      if (!dragging && Math.abs(dx) > THRESHOLD) {
        dragging = true;
        track.classList.add('is-grabbing');
        track.setPointerCapture(pointerId);
      }
      if (dragging) {
        track.scrollLeft = startScroll - dx;
        const now = performance.now();
        const dt = now - lastT;
        if (dt > 0) {
          const instant = (e.clientX - lastX) / dt;
          velocity = velocity * 0.6 + instant * 0.4;
        }
        lastX = e.clientX;
        lastT = now;
      }
    });

    const endDrag = (e: PointerEvent) => {
      if (pointerId !== e.pointerId) return;
      if (dragging) {
        track.classList.remove('is-grabbing');
        try { track.releasePointerCapture(pointerId); } catch {}
        const swallow = (ev: Event) => { ev.preventDefault(); ev.stopPropagation(); };
        track.addEventListener('click', swallow, { capture: true, once: true });
        startInertia();
      }
      pointerId = null;
      dragging = false;
    };
    track.addEventListener('pointerup', endDrag);
    track.addEventListener('pointercancel', endDrag);
    track.addEventListener('wheel', stopInertia, { passive: true });
    prev?.addEventListener('click', stopInertia);
    next?.addEventListener('click', stopInertia);

    /* Custom Drag-Cursor (visuell) */
    const cursorPos = section.querySelector<HTMLElement>('[data-grh-evs-cursor-pos]');
    const cursorEl  = section.querySelector<HTMLElement>('[data-grh-evs-cursor]');
    if (!cursorPos || !cursorEl) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let mx = 0, my = 0, cx = 0, cy = 0, cursorRaf = 0;
    const EASE = 0.18;
    const animateCursor = () => {
      cx += (mx - cx) * EASE;
      cy += (my - cy) * EASE;
      cursorPos.style.transform = `translate3d(${cx}px, ${cy}px, 0)`;
      cursorRaf = requestAnimationFrame(animateCursor);
    };
    document.addEventListener('mousemove', (e) => {
      mx = e.clientX; my = e.clientY;
      if (!cursorRaf) { cx = mx; cy = my; animateCursor(); }
    });
    track.addEventListener('mouseenter', () => {
      cursorEl.classList.add('is-active');
      track.classList.add('is-cursor-active');
    });
    track.addEventListener('mouseleave', () => {
      cursorEl.classList.remove('is-active');
      cursorEl.classList.remove('is-grabbing');
      track.classList.remove('is-cursor-active');
    });
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse') cursorEl.classList.add('is-grabbing');
    });
    const releaseCursor = () => cursorEl.classList.remove('is-grabbing');
    track.addEventListener('pointerup', releaseCursor);
    track.addEventListener('pointercancel', releaseCursor);
  });
</script>
