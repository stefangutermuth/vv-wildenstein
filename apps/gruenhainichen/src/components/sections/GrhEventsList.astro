---
import GrhIcon from '../primitives/GrhIcon.astro';

interface Event {
  title: string;
  startDate: Date;
  endDate?: Date;
  location: string;
  ortsteil?: 'borstendorf' | 'gruenhainichen' | 'waldkirchen';
  teaser: string;
  featured?: boolean;
  href?: string;
  image?: string;
  category?: string;
}
interface Props {
  events: Event[];
}
const { events } = Astro.props;

const ortsteilLabel = {
  borstendorf:    'Borstendorf',
  gruenhainichen: 'Grünhainichen',
  waldkirchen:    'Waldkirchen',
} as const;

const fmtDay   = new Intl.DateTimeFormat('de-DE', { day: '2-digit' });
const fmtMon   = new Intl.DateTimeFormat('de-DE', { month: 'short' });
const fmtFull  = new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' });
const fmtRange = new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: 'long' });
const fmtYear  = new Intl.DateTimeFormat('de-DE', { year: 'numeric' });

// Kategorie aus Titel-Keywords ableiten (bis das eigene WP-Plugin
// strukturierte Kategorien liefert).
function deriveCategory(e: Event): string {
  if (e.category) return e.category;
  const t = (e.title + ' ' + (e.teaser ?? '')).toLowerCase();
  if (/hexenfeuer|maifest|pyramide|advent|schautag|tradition|handwerk|spieldose/.test(t)) return 'brauchtum';
  if (/konzert|festival|mozart|gospel|chor|open\s*air|sommerkonzert|tanz|musik|harfe/.test(t))    return 'musik';
  if (/wander|natur|kraeuter|kraeuter|kräut|forst|pilz|labyrinth|eurorando/.test(t))               return 'natur';
  if (/markt|laden/.test(t))                                                                       return 'markt';
  if (/feuerwehr|verein|sport|schach|jugend|sportler|ball/.test(t))                                return 'gemeinschaft';
  if (/kirche|gottes|gospel|andach|schulanfang|familien|senior|kita|kinder/.test(t))               return 'leben';
  return 'sonstige';
}
const categoryLabel: Record<string, string> = {
  brauchtum:    'Brauchtum',
  musik:        'Musik',
  natur:        'Natur',
  markt:        'Markt',
  gemeinschaft: 'Vereine & Sport',
  leben:        'Leben & Familie',
  sonstige:     'Sonstige',
};

const enriched = events.map((e) => ({ ...e, category: deriveCategory(e) }));
const single = enriched.filter((e) => !e.endDate);
const multi  = enriched.filter((e) => !!e.endDate);

// Filter-Optionen aus dem tatsächlichen Datensatz
const ortsteileInUse = Array.from(new Set(enriched.map((e) => e.ortsteil).filter(Boolean) as string[]));
const categoriesInUse = Array.from(new Set(enriched.map((e) => e.category).filter(Boolean) as string[]))
  .sort((a, b) => (categoryLabel[a] ?? a).localeCompare(categoryLabel[b] ?? b));

const monShort = (d: Date) => fmtMon.format(d).replace('.', '');
---
<div class="grh-evs">

  {single.length > 0 && (
    <section class="grh-evs__group" data-grh-evs-section>
      <header class="grh-evs__group-head">
        <div class="grh-evs__group-head-text">
          <span class="grh-eyebrow">Tagesveranstaltungen</span>
          <h3>Termine zum Vormerken.</h3>
        </div>
        <div class="grh-evs__nav" aria-hidden="false">
          <button type="button" class="grh-evs__nav-btn" data-grh-carousel-prev aria-label="Vorherige Termine">
            <GrhIcon name="arrow-right" size={16} />
          </button>
          <button type="button" class="grh-evs__nav-btn" data-grh-carousel-next aria-label="Weitere Termine">
            <GrhIcon name="arrow-right" size={16} />
          </button>
        </div>
      </header>

      {/* Filter-Leiste — Live nach Ort + Kategorie */}
      <div class="grh-evs__filters" role="toolbar" aria-label="Termine filtern">
        <div class="grh-evs__filter-group" data-grh-filter-group="ortsteil">
          <span class="grh-evs__filter-label">Ort</span>
          <button type="button" class="grh-evs__chip is-active" data-grh-filter-value="">Alle</button>
          {ortsteileInUse.map((slug) => (
            <button type="button" class="grh-evs__chip" data-grh-filter-value={slug}>
              {ortsteilLabel[slug as keyof typeof ortsteilLabel]}
            </button>
          ))}
        </div>
        <div class="grh-evs__filter-group" data-grh-filter-group="category">
          <span class="grh-evs__filter-label">Kategorie</span>
          <button type="button" class="grh-evs__chip is-active" data-grh-filter-value="">Alle</button>
          {categoriesInUse.map((cat) => (
            <button type="button" class="grh-evs__chip" data-grh-filter-value={cat}>
              {categoryLabel[cat] ?? cat}
            </button>
          ))}
        </div>
      </div>

      <div class="grh-evs__carousel" data-grh-carousel>
        <ol class="grh-evs__day-track" data-grh-carousel-track>
          {single.map((e) => (
            <li class="grh-evs__day" data-ortsteil={e.ortsteil ?? ''} data-category={e.category}>
              <a href={e.href ?? '#'} class="grh-evs__day-link">
                <div class="grh-evs__poster" style={e.image ? `--evs-img: url('${e.image}')` : undefined}>
                  {e.image ? (
                    <img src={e.image} alt={`Plakat ${e.title}`} loading="lazy" decoding="async" />
                  ) : (
                    <div class="grh-evs__poster-fallback" aria-hidden="true"></div>
                  )}
                  <div class="grh-evs__poster-overlay"></div>
                  <div class="grh-evs__poster-date">
                    <span class="grh-evs__poster-day">{fmtDay.format(e.startDate)}</span>
                    <span class="grh-evs__poster-mon">{monShort(e.startDate)}</span>
                  </div>
                  {e.featured && <span class="grh-evs__poster-badge">Empfehlung</span>}
                </div>

                <div class="grh-evs__day-body">
                  <h4>{e.title}</h4>
                  <p class="grh-evs__day-loc">
                    <GrhIcon name="map-pin" size={12} />
                    {e.ortsteil && <span>{ortsteilLabel[e.ortsteil]} ·</span>}
                    <span>{e.location}</span>
                  </p>
                  <p class="grh-evs__day-teaser">{e.teaser}</p>
                </div>
              </a>
            </li>
          ))}
        </ol>
        <p class="grh-evs__empty" data-grh-empty hidden>
          Keine Veranstaltungen mit diesen Filtern.
        </p>
      </div>

      {/* Custom Drag-Cursor — folgt der Maus über dem Track */}
      <div class="grh-evs__cursor-pos" data-grh-evs-cursor-pos aria-hidden="true">
        <div class="grh-evs__cursor" data-grh-evs-cursor>
          <svg class="grh-evs__cursor-arrow grh-evs__cursor-arrow--prev" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12" /><polyline points="13 6 19 12 13 18" />
          </svg>
          <span class="grh-evs__cursor-label">Ziehen</span>
          <svg class="grh-evs__cursor-arrow" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12" /><polyline points="13 6 19 12 13 18" />
          </svg>
        </div>
      </div>
    </section>
  )}

  {multi.length > 0 && (
    <section class="grh-evs__group grh-evs__group--multi">
      <header class="grh-evs__group-head">
        <div class="grh-evs__group-head-text">
          <span class="grh-eyebrow">Mehrtägig &amp; Dauer</span>
          <h3>Längere Highlights.</h3>
        </div>
      </header>

      {/* Stack — kompakte Streifen, Klick auf den Streifen klappt Details auf */}
      <ul class="grh-evs__stack">
        {multi.map((e) => (
          <li class="grh-evs__stack-item">
            <details class="grh-evs__stack-details">
              <summary class="grh-evs__stack-summary">
                <span class="grh-evs__stack-thumb" style={e.image ? `--evs-img: url('${e.image}')` : undefined}>
                  {e.image
                    ? <img src={e.image} alt="" loading="lazy" decoding="async" />
                    : <span class="grh-evs__poster-fallback" aria-hidden="true"></span>}
                </span>
                <span class="grh-evs__stack-range">
                  <span class="grh-evs__stack-range-row">
                    <strong>{fmtDay.format(e.startDate)}.</strong>
                    <span>–</span>
                    <strong>{e.endDate ? `${fmtDay.format(e.endDate)}.` : ''}</strong>
                  </span>
                  <em>{fmtMon.format(e.endDate ?? e.startDate).replace('.', '')}</em>
                </span>
                <span class="grh-evs__stack-title">
                  <h4>{e.title}</h4>
                  <span class="grh-evs__stack-meta">
                    {e.ortsteil && <span>{ortsteilLabel[e.ortsteil]} · </span>}
                    <span>{e.location}</span>
                  </span>
                </span>
                <span class="grh-evs__stack-toggle" aria-hidden="true">
                  <GrhIcon name="arrow-right" size={14} />
                </span>
              </summary>
              <div class="grh-evs__stack-expanded">
                <div class="grh-evs__stack-poster" style={e.image ? `--evs-img: url('${e.image}')` : undefined}>
                  {e.image
                    ? <img src={e.image} alt={`Plakat ${e.title}`} loading="lazy" decoding="async" />
                    : <span class="grh-evs__poster-fallback" aria-hidden="true"></span>}
                  {e.featured && <span class="grh-evs__poster-badge grh-evs__poster-badge--lg">Empfehlung</span>}
                </div>
                <div class="grh-evs__stack-body">
                  <span class="grh-evs__multi-range">
                    <GrhIcon name="calendar" size={12} />
                    {e.endDate
                      ? `${fmtRange.format(e.startDate)} – ${fmtRange.format(e.endDate)} ${fmtYear.format(e.endDate)}`
                      : fmtFull.format(e.startDate)}
                  </span>
                  <p class="grh-evs__multi-teaser">{e.teaser}</p>
                  <a class="grh-evs__multi-cta" href={e.href ?? '#'}>
                    Programm &amp; Details <GrhIcon name="arrow-right" size={14} />
                  </a>
                </div>
              </div>
            </details>
          </li>
        ))}
      </ul>
    </section>
  )}

  {/* Zwei gleichwertige CTAs — Kalender + Eigenes Event einreichen */}
  <div class="grh-evs__ctas">
    <a class="grh-evs__cta" href="/veranstaltungen">
      <GrhIcon name="calendar" size={14} />
      Vollständiger Kalender
    </a>
    <a class="grh-evs__cta" href="/veranstaltungen/einreichen">
      <GrhIcon name="arrow-right" size={14} />
      Termin einreichen
    </a>
  </div>

</div>

<style>
  .grh-evs {
    display: flex;
    flex-direction: column;
    gap: var(--grh-space-9);
  }

  .grh-evs__group-head {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--grh-space-4);
    margin-bottom: var(--grh-space-6);
    padding-bottom: var(--grh-space-3);
    border-bottom: 1px solid var(--grh-line);
  }
  .grh-evs__group-head-text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* Carousel-Pfeile rechts oben */
  .grh-evs__nav {
    display: flex;
    gap: 8px;
  }
  .grh-evs__nav-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--grh-line);
    background: var(--grh-cream-50);
    color: var(--grh-forest-800);
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: background var(--grh-dur-fast),
                border-color var(--grh-dur-fast),
                color var(--grh-dur-fast),
                transform var(--grh-dur-fast),
                opacity var(--grh-dur-fast);
  }
  .grh-evs__nav-btn:hover:not(:disabled) {
    background: var(--grh-forest-800);
    color: var(--grh-candle-500);
    border-color: var(--grh-forest-800);
  }
  .grh-evs__nav-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .grh-evs__nav-btn[data-grh-carousel-prev] :global(svg) {
    transform: rotate(180deg);
  }
  .grh-evs__group-head h3 {
    font-family: var(--grh-font-display);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    line-height: 1.1;
    color: var(--grh-forest-900);
    letter-spacing: -0.02em;
    margin: 0;
  }

  /* === Plakat-Grundbaustein (Hochkant 3:4) ================== */
  .grh-evs__poster {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: var(--grh-radius-md);
    background: var(--grh-paper-100);
    isolation: isolate;
  }
  /* Smart-Cover: ganzes Plakat immer sichtbar, Rest ist eine
     unscharfe Version desselben Bildes als Hintergrund */
  .grh-evs__poster::before {
    content: '';
    position: absolute;
    inset: -16px;
    background-image: var(--evs-img);
    background-size: cover;
    background-position: center;
    filter: blur(18px) brightness(0.78) saturate(1.1);
    transform: scale(1.05);
    z-index: 0;
  }
  .grh-evs__poster img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 1s var(--grh-ease-out);
  }
  .grh-evs__poster-fallback {
    position: absolute; inset: 0;
    background: linear-gradient(160deg, #2A6B43, #13301F);
  }
  .grh-evs__poster-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(14,31,24,0.05) 0%, rgba(14,31,24,0.55) 80%, rgba(14,31,24,0.85) 100%);
    pointer-events: none;
    z-index: 2;
  }
  /* Datum + Badge müssen über dem Overlay liegen */
  .grh-evs__poster-date,
  .grh-evs__poster-badge,
  .grh-evs__poster-tag { z-index: 3; }
  .grh-evs__poster-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    background: var(--grh-candle-500);
    color: var(--grh-forest-900);
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: var(--grh-radius-pill);
  }
  .grh-evs__poster-badge--lg { font-size: 10px; padding: 5px 10px; }

  /* === Tagesveranstaltungen — horizontales Carousel ========= */
  .grh-evs__carousel {
    position: relative;
    margin-inline: 0;
  }
  @media (min-width: 720px) {
    .grh-evs__carousel { margin-inline: calc(var(--grh-space-5) * -1); }
  }
  .grh-evs__day-track {
    display: flex;
    gap: var(--grh-space-4);
    list-style: none;
    margin: 0;
    padding: var(--grh-space-2) 0;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    /* Kein Snap — Inertia kümmert sich ums weiche Austrudeln */
    scroll-behavior: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
  }
  @media (min-width: 720px) {
    .grh-evs__day-track {
      gap: var(--grh-space-5);
      padding: var(--grh-space-2) var(--grh-space-5);
    }
  }
  .grh-evs__day-track::-webkit-scrollbar { display: none; }
  .grh-evs__day-track.is-grabbable { cursor: grab; }
  .grh-evs__day-track.is-grabbing  { cursor: grabbing; }
  .grh-evs__day-track.is-grabbing a { pointer-events: none; }
  .grh-evs__day-track.is-cursor-active,
  .grh-evs__day-track.is-cursor-active * { cursor: none !important; }

  /* Custom Drag-Cursor — derselbe Look wie im Tourismus-Strip */
  .grh-evs__cursor-pos {
    position: fixed;
    top: 0; left: 0;
    pointer-events: none;
    z-index: 9000;
    transform: translate3d(-9999px, -9999px, 0);
    will-change: transform;
  }
  .grh-evs__cursor {
    width: 96px; height: 96px;
    border-radius: 50%;
    background: var(--grh-candle-500);
    color: var(--grh-forest-900);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    transform: translate(-50%, -50%) scale(0.3);
    opacity: 0;
    transition:
      opacity 500ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
    box-shadow:
      0 14px 36px -12px rgba(232, 182, 88, 0.55),
      0 0 32px 4px    rgba(232, 182, 88, 0.32),
      0 0 60px 12px   rgba(232, 182, 88, 0.18);
    will-change: transform, opacity;
  }
  .grh-evs__cursor.is-active   { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  .grh-evs__cursor.is-grabbing { transform: translate(-50%, -50%) scale(0.85); }
  .grh-evs__cursor-label {
    font-size: 11px; text-transform: uppercase;
    letter-spacing: 0.22em; font-weight: 700;
  }
  .grh-evs__cursor-arrow { color: var(--grh-forest-900); }
  .grh-evs__cursor-arrow--prev { transform: scaleX(-1); }
  @media (prefers-reduced-motion: reduce), (hover: none) {
    .grh-evs__cursor-pos { display: none; }
  }
  .grh-evs__day[data-hidden] { display: none; }
  .grh-evs__empty {
    text-align: center;
    color: var(--grh-stone-400);
    font-style: italic;
    padding: var(--grh-space-7) var(--grh-space-5);
    margin: 0;
  }

  /* === Filter-Leiste (Live-Filter) ========================== */
  .grh-evs__filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--grh-space-5);
    margin-bottom: var(--grh-space-5);
    padding-bottom: var(--grh-space-4);
    border-bottom: 1px solid var(--grh-line);
  }
  .grh-evs__filter-group {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }
  .grh-evs__filter-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--grh-stone-400);
    font-weight: 700;
    margin-right: 4px;
  }
  .grh-evs__chip {
    border: 1px solid var(--grh-line);
    background: transparent;
    color: var(--grh-stone-700);
    border-radius: var(--grh-radius-pill);
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: background var(--grh-dur-fast), color var(--grh-dur-fast), border-color var(--grh-dur-fast);
  }
  .grh-evs__chip:hover { border-color: var(--grh-forest-700); color: var(--grh-forest-900); }
  .grh-evs__chip.is-active {
    background: var(--grh-forest-900);
    color: var(--grh-cream-50);
    border-color: var(--grh-forest-900);
  }

  /* === Stack der mehrtägigen Events — kompakt, klickbar zum Aufklappen ====== */
  .grh-evs__stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--grh-space-3);
  }
  .grh-evs__stack-details {
    background: var(--grh-cream-50);
    border: 1px solid var(--grh-line);
    border-radius: var(--grh-radius-md);
    overflow: hidden;
    transition: border-color var(--grh-dur-base);
  }
  .grh-evs__stack-details[open],
  .grh-evs__stack-details:hover { border-color: var(--grh-candle-500); }
  /* Native Marker-Pfeil ausblenden */
  .grh-evs__stack-summary::-webkit-details-marker { display: none; }
  .grh-evs__stack-summary { list-style: none; }
  .grh-evs__stack-summary {
    display: grid;
    grid-template-columns: 100px 96px 1fr auto;
    gap: var(--grh-space-4);
    align-items: center;
    padding: var(--grh-space-4) var(--grh-space-4);
    cursor: pointer;
    transition: background var(--grh-dur-fast);
  }
  .grh-evs__stack-summary:hover { background: var(--grh-paper-100); }
  /* Smart-Cover: Bild komplett sichtbar (contain) + unscharfer eigener Hintergrund */
  .grh-evs__stack-thumb {
    position: relative;
    width: 100px; height: 100px;
    overflow: hidden;
    border-radius: var(--grh-radius-sm, 6px);
    background: var(--grh-paper-100);
    isolation: isolate;
    flex-shrink: 0;
  }
  .grh-evs__stack-thumb::before {
    content: '';
    position: absolute;
    inset: -10px;
    background-image: var(--evs-img);
    background-size: cover;
    background-position: center;
    filter: blur(12px) brightness(0.85) saturate(1.1);
    transform: scale(1.05);
    z-index: 0;
  }
  .grh-evs__stack-thumb img {
    position: relative;
    z-index: 1;
    width: 100%; height: 100%;
    object-fit: contain;
  }

  .grh-evs__stack-range {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    font-family: var(--grh-font-display);
    color: var(--grh-forest-900);
    line-height: 1;
    text-align: center;
  }
  .grh-evs__stack-range-row {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
  }
  .grh-evs__stack-range-row strong {
    font-size: clamp(1.4rem, 2.4vw, 1.8rem);
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .grh-evs__stack-range-row span { color: var(--grh-stone-400); }
  .grh-evs__stack-range em {
    font-style: italic;
    font-weight: 400;
    color: var(--grh-moss-600);
    font-size: var(--grh-fs-sm);
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }

