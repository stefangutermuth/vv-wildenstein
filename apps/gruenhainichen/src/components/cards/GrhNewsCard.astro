---
import GrhBadge from '../primitives/GrhBadge.astro';
import GrhIcon from '../primitives/GrhIcon.astro';

type Category = 'verwaltung' | 'veranstaltung' | 'sperrung' | 'tourismus';
interface Props {
  title: string;
  date: Date;
  category: Category;
  excerpt: string;
  image?: string;
  href: string;
  variant?: 'default' | 'compact';
}
const { title, date, category, excerpt, image, href, variant = 'default' } = Astro.props;

const categoryLabel: Record<Category, string> = {
  verwaltung:    'Verwaltung',
  veranstaltung: 'Veranstaltung',
  sperrung:      'Sperrung',
  tourismus:     'Tourismus',
};
const categoryTone = {
  verwaltung:    'forest',
  veranstaltung: 'moss',
  sperrung:      'alert',
  tourismus:     'wood',
} as const;

const formattedDate = new Intl.DateTimeFormat('de-DE', {
  day: '2-digit', month: '2-digit', year: 'numeric',
}).format(date);

// Pseudozufällige Hintergrundvariante für Bild-Platzhalter (Build ohne Fotos)
const bgVariants = ['a', 'b', 'c', 'd'];
const bgKey = bgVariants[Math.abs(title.length + category.length) % bgVariants.length];
---
{variant === 'compact' ? (
  <a class="grh-news-compact" href={href}>
    <div class="grh-news-compact__meta">
      <GrhBadge tone={categoryTone[category]} size="sm">{categoryLabel[category]}</GrhBadge>
      <time datetime={date.toISOString()}>{formattedDate}</time>
    </div>
    <h3 class="grh-news-compact__title">{title}</h3>
    <span class="grh-news-compact__arrow" aria-hidden="true"><GrhIcon name="arrow-right" size={20} /></span>
  </a>
) : (
  <a class="grh-news-card" href={href}>
    <div class={`grh-news-card__media grh-news-card__media--${bgKey}`} aria-hidden="true">
      {image && (
        <>
          <img class="grh-news-card__media-bg" src={image} alt="" loading="lazy" aria-hidden="true" />
          <img class="grh-news-card__media-fg" src={image} alt="" loading="lazy" />
        </>
      )}
      <span class="grh-news-card__date" aria-hidden="true">{formattedDate}</span>
      <span class="grh-news-card__tag">
        <GrhBadge tone={categoryTone[category]}>{categoryLabel[category]}</GrhBadge>
      </span>
    </div>
    <div class="grh-news-card__body">
      <h3 class="grh-news-card__title">{title}</h3>
      <p class="grh-news-card__excerpt">{excerpt}</p>
      <span class="grh-news-card__cta">
        Weiterlesen <GrhIcon name="arrow-right" size={16} />
      </span>
    </div>
  </a>
)}

<style>
  .grh-news-card {
    display: flex;
    flex-direction: column;
    background: var(--grh-cream-50);
    border-radius: var(--grh-radius-lg);
    overflow: hidden;
    box-shadow: var(--grh-shadow-sm);
    border: 1px solid var(--grh-line);
    text-decoration: none;
    color: inherit;
    transition: transform var(--grh-dur-base) var(--grh-ease-out), box-shadow var(--grh-dur-base) var(--grh-ease-out);
    height: 100%;
  }
  .grh-news-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--grh-shadow-md);
  }
  .grh-news-card__media {
    aspect-ratio: 16 / 10;
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  /* Hintergrund: dasselbe Bild aufgeblasen + stark geblurrt füllt die Ränder
     (atmosphärisch statt ungewollter Crop). */
  .grh-news-card__media-bg {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    filter: blur(28px) saturate(1.15) brightness(0.92);
    transform: scale(1.18);
    z-index: 0;
  }
  /* Vordergrund: Bild komplett sichtbar (contain), nichts wird abgeschnitten. */
  .grh-news-card__media-fg {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: contain;
    z-index: 1;
    transition: transform 600ms var(--grh-ease-out);
  }
  .grh-news-card:hover .grh-news-card__media-fg { transform: scale(1.04); }

  /* Bildlose Platzhalter-Varianten – wirken wie warme, atmosphärische Hintergründe */
  .grh-news-card__media--a { background: linear-gradient(135deg, #2A6B43, #5BAE78); }
  .grh-news-card__media--b { background: linear-gradient(135deg, #6B4A2A, #A6794E); }
  .grh-news-card__media--c { background: linear-gradient(135deg, #13301F, #2A6B43); }
  .grh-news-card__media--d { background: linear-gradient(135deg, #A8401E, #6B4A2A); }

  .grh-news-card__date {
    position: absolute;
    top: var(--grh-space-3);
    left: var(--grh-space-3);
    background: var(--grh-cream-50);
    color: var(--grh-forest-800);
    font-size: var(--grh-fs-xs);
    font-weight: 600;
    padding: 4px 10px;
    border-radius: var(--grh-radius-pill);
    letter-spacing: var(--grh-tracking-label);
    z-index: 2;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }
  .grh-news-card__tag {
    position: absolute;
    top: var(--grh-space-3);
    right: var(--grh-space-3);
    z-index: 2;
  }
  .grh-news-card__body {
    padding: var(--grh-space-5);
    display: flex;
    flex-direction: column;
    gap: var(--grh-space-3);
    flex: 1;
  }
  .grh-news-card__title {
    font-family: var(--grh-font-display);
    font-size: var(--grh-fs-lg);
    line-height: 1.25;
    color: var(--grh-forest-900);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-wrap: balance;
  }
  .grh-news-card__excerpt {
    font-size: var(--grh-fs-sm);
    color: var(--grh-stone-700);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }
  .grh-news-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--grh-moss-600);
    font-weight: 600;
    font-size: var(--grh-fs-sm);
    letter-spacing: var(--grh-tracking-label);
    margin-top: auto;
  }

  /* Compact-Variante (Sperrungs-Liste) */
  .grh-news-compact {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--grh-space-4);
    align-items: center;
    padding: var(--grh-space-4);
    background: var(--grh-cream-50);
    border: 1px solid var(--grh-line);
    border-radius: var(--grh-radius-md);
    text-decoration: none;
    color: inherit;
    transition: background var(--grh-dur-fast), transform var(--grh-dur-fast);
  }
  .grh-news-compact + .grh-news-compact { margin-top: var(--grh-space-2); }
  .grh-news-compact:hover {
    background: var(--grh-paper-100);
    transform: translateX(4px);
  }
  .grh-news-compact__meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 110px;
  }
  .grh-news-compact__meta time { font-size: var(--grh-fs-xs); color: var(--grh-stone-400); }
  .grh-news-compact__title {
    font-family: var(--grh-font-display);
    font-size: var(--grh-fs-base);
    color: var(--grh-forest-900);
    line-height: 1.3;
  }
  .grh-news-compact__arrow { color: var(--grh-moss-600); }
</style>
