---
import GrhWappen from './GrhWappen.astro';
import GrhIcon from '../primitives/GrhIcon.astro';
---
<header class="grh-header grh-header--compact" data-grh-header>
  <div class="grh-container grh-headerc__inner">
    <div class="grh-headerc__brand">
      <a href="/" class="grh-headerc__brandhome" aria-label="Gemeinde Grünhainichen · Startseite">
        <GrhWappen size={72} eager asBackground />
      </a>
      <span class="grh-headerc__brandtext">
        <a href="/" class="grh-headerc__name">Grünhainichen</a>
        <span class="grh-headerc__sub">
          <a href="/gemeinde/ortsteile/borstendorf">Borstendorf</a>
          <span aria-hidden="true"> · </span>
          <a href="/gemeinde/ortsteile/gruenhainichen">Grünhainichen</a>
          <span aria-hidden="true"> · </span>
          <a href="/gemeinde/ortsteile/waldkirchen">Waldkirchen</a>
        </span>
      </span>
    </div>

    <div class="grh-headerc__tools">
      <div class="grh-headerc__weather" data-grh-weather aria-label="Aktuelles Wetter in Grünhainichen" role="status" hidden>
        <span class="grh-headerc__weather-icon" data-grh-weather-icon aria-hidden="true">
          {/* Default-Icon Sonne/Wolke — wird per JS gegen Wettercode getauscht */}
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="9" cy="10" r="3.2" />
            <line x1="9" y1="3.5" x2="9" y2="5" />
            <line x1="9" y1="15"  x2="9" y2="16.5" />
            <line x1="2.5" y1="10" x2="4" y2="10" />
            <line x1="14"  y1="10" x2="15.5" y2="10" />
            <line x1="4.5" y1="5.5"   x2="5.5" y2="6.5" />
            <line x1="12.5" y1="13.5" x2="13.5" y2="14.5" />
            <line x1="4.5" y1="14.5"  x2="5.5" y2="13.5" />
            <line x1="12.5" y1="6.5"  x2="13.5" y2="5.5" />
            <path d="M11 18a3 3 0 0 1 5.5-1.6 3 3 0 0 1 4 4.6H13a3 3 0 0 1-2-3z" fill="currentColor" stroke="none" opacity="0.85" />
          </svg>
        </span>
        <span class="grh-headerc__weather-text">
          <span class="grh-headerc__weather-temp" data-grh-weather-temp>—°</span>
          <span class="grh-headerc__weather-loc">Grünhainichen</span>
        </span>
      </div>

      {/* Freibad Borstendorf — steht neben dem Wetter, weil beides dieselbe
          Frage beantwortet: Lohnt sich der Weg heute?
          Wie das Wetter erst versteckt und per Abruf gefüllt; so ist die
          Angabe auf allen Seiten aktuell, ohne dass jede Seite neu gebaut
          werden muss. Ohne laufende oder kommende Öffnung bleibt sie weg. */}
      <a
        class="grh-headerc__fb"
        href="/tourismus/baden/"
        data-grh-fb-pill
        hidden
      >
        {/* Wellen-Symbol statt eines bloßen Punktes: Auf dem Handy bleibt nur
            dieses Zeichen übrig, und ein farbiger Punkt allein sagt niemandem,
            worum es geht. Die Färbung trägt den Status. */}
        <span class="grh-headerc__fb-icon" data-grh-fb-icon aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor"
               stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 16.5c1.8 0 1.8-1.6 3.7-1.6s1.8 1.6 3.7 1.6 1.8-1.6 3.7-1.6 1.8 1.6 3.6 1.6 1.8-1.6 3.7-1.6" />
            <path d="M2 20.5c1.8 0 1.8-1.6 3.7-1.6s1.8 1.6 3.7 1.6 1.8-1.6 3.7-1.6 1.8 1.6 3.6 1.6 1.8-1.6 3.7-1.6" />
            <circle cx="16" cy="5.5" r="1.9" fill="currentColor" stroke="none" />
            <path d="M6.5 12.5l3-2.6 3.2 2.2" />
          </svg>
        </span>
        <span class="grh-headerc__fb-text">
          <span class="grh-headerc__fb-lage" data-grh-fb-lage></span>
          <span class="grh-headerc__fb-ort">Freibad</span>
        </span>
      </a>

      <a class="grh-headerc__social" href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer" aria-label="Gemeinde Grünhainichen auf Instagram">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" stroke="none" />
        </svg>
      </a>
      <a class="grh-headerc__social" href="https://www.facebook.com/" target="_blank" rel="noopener noreferrer" aria-label="Gemeinde Grünhainichen auf Facebook">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 4h-2c-2 0-3 1-3 3v2H7v3h2v8h3v-8h2.5l.5-3H12V7c0-.5.4-1 1-1h1V4z" />
        </svg>
      </a>

      {/* Suche: Die Lupe ist ein Feld, das nach links aufklappt. Wetter und
          Social-Symbole rücken dabei beiseite; die Treffer hängen darunter. */}
      <div class="grh-headerc__suche" data-grh-header-suche>
        <button type="button" class="grh-headerc__suche-knopf" aria-label="Suche öffnen" aria-expanded="false" aria-controls="grh-header-suche-liste" data-grh-suche-open>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.5" y2="16.5" />
          </svg>
        </button>
        <input type="search" class="grh-headerc__suche-input" placeholder="Suchen…" autocomplete="off" aria-label="Suchbegriff" aria-controls="grh-header-suche-liste" tabindex="-1" data-grh-header-suche-input />
        <button type="button" class="grh-headerc__suche-zu" aria-label="Suche schließen" tabindex="-1" data-grh-header-suche-close>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <line x1="6" y1="6" x2="18" y2="18" /><line x1="18" y1="6" x2="6" y2="18" />
          </svg>
        </button>
        <ul class="grh-suche__liste grh-headerc__suche-liste" id="grh-header-suche-liste" role="listbox" aria-label="Suchergebnisse" data-grh-header-suche-liste hidden></ul>
      </div>

      <button
        type="button"
        class="grh-headerc__burger"
        aria-label="Menü öffnen"
        aria-haspopup="dialog"
        aria-expanded="false"
        data-grh-megamenu-toggle
      >
        <span class="grh-headerc__burger-bars" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
        <span class="grh-headerc__burger-label">Menü</span>
      </button>
    </div>
  </div>

</header>

<style>
  .grh-header--compact {
    position: sticky;
    top: 0;
    z-index: var(--grh-z-sticky);
    background: var(--grh-cream-50);
    border-bottom: 1px solid var(--grh-line);
    transition: box-shadow var(--grh-dur-base);
  }
  /* Beim Scrollen bekommt der Kopf nur einen leichten Schatten. Vorher lag
     er halbtransparent mit backdrop-filter über der Seite; in Edge flackerte
     das, weil die Weichzeichnung bei jeder Bewegung darunter (Hero-Bilder,
     Animationen) neu gerechnet wird. Ein deckender Kopf ist ruhig. */
  .grh-header--compact.is-scrolled {
    box-shadow: 0 10px 30px -18px rgba(20, 43, 31, 0.35);
  }
  .grh-headerc__inner {
    position: relative; /* Bezug für das aufgeklappte Suchfeld auf dem Telefon */
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--grh-space-5);
    min-height: 130px;
    transition: min-height var(--grh-dur-base);
  }
  .grh-header--compact.is-scrolled .grh-headerc__inner { min-height: 88px; }

  .grh-headerc__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--grh-space-4);
    text-decoration: none;
    color: inherit;
  }
  /* Der Schriftzug wurde beim Scrollen auf 78 % skaliert. Ein skaliertes
     Bild rastert der Browser bei jedem Umbau der Zeile neu (etwa wenn die
     Suche schließt und Wetter und Symbole zurückkommen), und genau dabei
     blitzte das Wappen in Edge. Deshalb keine Skalierung mehr: Der Kopf
     wird beim Scrollen nur noch niedriger, Wappen und Name bleiben gleich. */
  .grh-headerc__brand {
    /* Dauerhaft eigene Ebene, damit die Überblendungen rechts (Wetter,
       Symbole) den Schriftzug samt Wappen nicht neu zeichnen lassen. */
    transform: translateZ(0);
    will-change: transform;
  }
  .grh-headerc__weather, .grh-headerc__fb, .grh-headerc__social, .grh-headerc__suche {
    will-change: opacity, max-width, width;
  }

  .grh-headerc__brandtext {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    line-height: 1;
    /* Subline definiert die Bezugsbreite — der Name skaliert darauf hin */
    --grh-brand-width: 30ch;
  }
  .grh-headerc__brandhome { display: inline-flex; text-decoration: none; color: inherit; }
  .grh-headerc__name {
    font-family: var(--grh-font-display);
    font-size: clamp(2.7rem, 5vw, 3.6rem);
    font-weight: 500;
    color: var(--grh-forest-900);
    letter-spacing: -0.03em;
    line-height: 0.92;
    text-decoration: none;
    /* Leichter Stretch — Wort bleibt mit der Subline bündig, ohne zu dominieren */
    font-stretch: 115%;
  }
  .grh-headerc__sub {
    font-family: var(--grh-font-body);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    color: var(--grh-moss-600);
    font-weight: 600;
    margin-top: 4px;
  }
  .grh-headerc__sub a {
    color: inherit;
    text-decoration: none;
    transition: color var(--grh-dur-fast);
  }
  .grh-headerc__sub a:hover { color: var(--grh-forest-900); }
  /* 899 statt 720 px: Schriftzug (383 px) + Werkzeuge (381 px) + Abstand und
     Innenränder brauchen 852 px. Zwischen 721 und 851 px passte die Kopfzeile
     also nicht in das Fenster — die Seite ließ sich dort um bis zu 51 px
     waagerecht schieben, der Menüknopf ragte rechts hinaus. Das traf jedes
     Tablet im Hochformat (768, 810, 820, 834 px). */
  @media (max-width: 899px) {
    /* Nur das Wappen — Schriftzug + Subline ausblenden */
    .grh-headerc__brandtext { display: none; }
    .grh-headerc__inner { min-height: 88px; }
    .grh-header--compact.is-scrolled .grh-headerc__inner { min-height: 72px; }
  }

  /* === Tools (Wetter + Social + Burger) ===================== */
  .grh-headerc__tools {
    display: inline-flex;
    align-items: center;
    gap: var(--grh-space-2);
  }

  /* === Suche in der Kopfzeile ================================ */
  .grh-headerc__suche {
    position: relative;
    display: flex;
    align-items: center;
    height: 40px;
    width: 40px;
    box-sizing: border-box;
    border: 1px solid var(--grh-line);
    border-radius: var(--grh-radius-pill);
    background: var(--grh-cream-50);
    overflow: visible;
    transition: width 260ms var(--grh-ease-out), border-color var(--grh-dur-fast), background var(--grh-dur-fast);
  }
  .grh-headerc__suche.is-open {
    width: min(480px, 46vw);
    border-color: var(--grh-forest-900);
    transition-delay: 140ms; /* erst verschwinden Wetter und Symbole, dann geht die Pille auf */
  }

  /* Solange gesucht wird, blenden Wetter, Freibad und Social-Symbole weich
     aus und geben ihren Platz frei; Wappen und Name bleiben stehen. */
  .grh-headerc__weather,
  .grh-headerc__fb,
  .grh-headerc__social {
    max-width: 260px;
    transition: opacity 180ms ease, max-width 260ms var(--grh-ease-out), margin 260ms var(--grh-ease-out), padding 260ms var(--grh-ease-out);
  }
  .grh-headerc__tools.is-searching .grh-headerc__weather,
  .grh-headerc__tools.is-searching .grh-headerc__fb,
  .grh-headerc__tools.is-searching .grh-headerc__social {
    opacity: 0;
    max-width: 0;
    margin: 0;
    padding-inline: 0;
    border-width: 0;
    overflow: hidden;
    pointer-events: none;
    visibility: hidden;
    transition: opacity 160ms ease, max-width 260ms var(--grh-ease-out) 120ms, margin 260ms var(--grh-ease-out) 120ms, padding 260ms var(--grh-ease-out) 120ms, border-width 0s 120ms, visibility 0s 380ms;
  }
  @media (prefers-reduced-motion: reduce) {
    .grh-headerc__suche, .grh-headerc__weather, .grh-headerc__fb, .grh-headerc__social,
    .grh-headerc__tools.is-searching .grh-headerc__weather,
    .grh-headerc__tools.is-searching .grh-headerc__fb,
    .grh-headerc__tools.is-searching .grh-headerc__social { transition: none; }
  }
  .grh-headerc__suche:not(.is-open):hover {
    background: var(--grh-forest-900);
    border-color: var(--grh-forest-900);
    color: var(--grh-cream-50);
  }
  .grh-headerc__suche-knopf {
    flex: 0 0 38px;
    width: 38px; height: 38px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    display: grid; place-items: center;
    cursor: pointer;
  }
  .grh-headerc__suche:not(.is-open) .grh-headerc__suche-knopf { color: var(--grh-forest-900); }
  .grh-headerc__suche:not(.is-open):hover .grh-headerc__suche-knopf { color: var(--grh-cream-50); }
  .grh-headerc__suche.is-open .grh-headerc__suche-knopf { color: var(--grh-moss-600); cursor: default; }
  .grh-headerc__suche-input {
    flex: 1 1 auto;
    min-width: 0;
    width: 0;
    opacity: 0;
    border: 0;
    background: transparent;
    font: inherit;
    font-size: 15px;
    color: var(--grh-forest-900);
    outline: none;
    padding: 0;
    transition: opacity 160ms ease 120ms;
  }
  .grh-headerc__suche-input::-webkit-search-cancel-button { display: none; }
  .grh-headerc__suche.is-open .grh-headerc__suche-input { opacity: 1; }
  /* Der Fokusring liegt nicht auf dem Eingabefeld (das zeichnete zwei
     Rahmen mitten in die Pille), sondern als weicher Schein um die Pille.
     Das !important ist nötig, weil reset.css den Ring für alle Eingabefelder
     mit !important erzwingt; die Pille übernimmt die Aufgabe sichtbar. */
  .grh-headerc__suche-input:focus,
  .grh-headerc__suche-input:focus-visible { outline: none !important; box-shadow: none; }
  .grh-headerc__suche.is-open:has(.grh-headerc__suche-input:focus-visible) {
    box-shadow: 0 0 0 3px rgba(232, 182, 88, 0.45);
  }
  .grh-headerc__suche-zu {
    flex: 0 0 32px;
    width: 32px; height: 32px;
    margin-right: 3px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--grh-stone-400);
    display: none;
    place-items: center;
    cursor: pointer;
  }
  .grh-headerc__suche.is-open .grh-headerc__suche-zu { display: grid; }
  .grh-headerc__suche-zu:hover { color: var(--grh-forest-900); }

  /* Trefferliste: schlicht, ohne Rahmen und Trennlinien, nur ein Schatten */
  .grh-headerc__suche-liste {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: min(440px, calc(100vw - 2 * var(--grh-gutter)));
    padding: 6px;
    background: var(--grh-cream-50);
    border-radius: var(--grh-radius-md);
    box-shadow: 0 24px 60px -24px rgba(20, 43, 31, 0.45), 0 2px 10px rgba(20, 43, 31, 0.06);
    z-index: var(--grh-z-overlay);
  }
  /* Treffer entstehen per innerHTML ohne Astro-Scope, daher :global */
  .grh-headerc__suche-liste :global(.grh-suche__result) { border-bottom: 0; padding: 10px 12px; }

  /* Telefon: das offene Feld legt sich über die ganze Kopfzeile */
  @media (max-width: 720px) {
    .grh-headerc__suche.is-open {
      position: absolute;
      left: var(--grh-gutter);
      right: var(--grh-gutter);
      top: 50%;
      transform: translateY(-50%);
      width: auto;
      z-index: 2;
    }
    .grh-headerc__suche-liste { right: 0; left: 0; width: auto; }
  }
  .grh-headerc__social {
    width: 40px; height: 40px;
    border-radius: 50%;
    display: grid; place-items: center;
    color: var(--grh-forest-900);
    border: 1px solid var(--grh-line);
    text-decoration: none;
    transition: background var(--grh-dur-fast), color var(--grh-dur-fast), border-color var(--grh-dur-fast), transform var(--grh-dur-fast);
  }
  .grh-headerc__social:hover {
    background: var(--grh-forest-900);
    color: var(--grh-cream-50);
    border-color: var(--grh-forest-900);
    transform: translateY(-1px);
  }
  /* Mobile: Wetter und Social aus — nur Burger bleibt */
  @media (max-width: 720px) {
    .grh-headerc__social,
    .grh-headerc__weather { display: none; }
    /* Die Suche bleibt auch auf dem Telefon in der Kopfzeile erreichbar */
    .grh-headerc__suche { display: flex; }
  }

  /* === Wetter-Pille ========================================= */
  .grh-headerc__weather {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px 6px 8px;
    border-radius: var(--grh-radius-pill);
    border: 1px solid var(--grh-line);
    color: var(--grh-forest-900);
    cursor: default;
    margin-right: var(--grh-space-2);
  }
  .grh-headerc__weather-icon {
    width: 32px; height: 32px;
    border-radius: 50%;
    background: var(--grh-sage-100);
    color: var(--grh-candle-500);
    display: grid; place-items: center;
    flex-shrink: 0;
  }
  .grh-headerc__weather-text {
    display: inline-flex;
    flex-direction: column;
    gap: 0;
    line-height: 1;
  }
  .grh-headerc__weather-temp {
    font-family: var(--grh-font-display);
    font-size: var(--grh-fs-md);
    font-weight: 500;
    color: var(--grh-forest-900);
    letter-spacing: -0.01em;
  }
  .grh-headerc__weather-loc {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--grh-stone-400);
    margin-top: 2px;
  }
  @media (max-width: 720px) {
    .grh-headerc__weather { padding-right: 8px; }
    .grh-headerc__weather-text { display: none; }
    .grh-headerc__weather-icon { width: 32px; height: 32px; }
  }

  /* --- Freibad-Plakette ------------------------------------------------ */
  .grh-headerc__fb {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: var(--grh-radius-pill);
    border: 1px solid var(--grh-line);
    color: var(--grh-forest-900);
    text-decoration: none;
    margin-right: var(--grh-space-2);
    transition: border-color var(--grh-dur-fast, 160ms) ease,
                background-color var(--grh-dur-fast, 160ms) ease;
  }
  .grh-headerc__fb[hidden] { display: none; }
  .grh-headerc__fb:hover {
    border-color: var(--grh-forest-700);
    background: var(--grh-sage-100);
  }
  .grh-headerc__fb:focus-visible {
    outline: 3px solid var(--grh-candle-500);
    outline-offset: 2px;
  }

  .grh-headerc__fb-icon {
    width: 32px; height: 32px;
    border-radius: 50%;
    display: grid; place-items: center;
    flex-shrink: 0;
    background: var(--grh-paper-100);
    color: var(--grh-stone-400);
  }
  /* Grün ausschließlich bei „geöffnet" — „voraussichtlich" bekommt Gelb,
     damit niemand bei zweifelhafter Lage umsonst hinfährt. */
  .grh-headerc__fb-icon--geoeffnet {
    background: var(--grh-sage-100);
    color: #2F7046;
  }
  .grh-headerc__fb-icon--voraussichtlich {
    background: #FBF0D8;
    color: #8A6410;
  }
  .grh-headerc__fb-icon--geschlossen,
  .grh-headerc__fb-icon--abgesagt {
    background: #FAE7E1;
    color: #A8401E;
  }

  .grh-headerc__fb-text {
    display: inline-flex;
    flex-direction: column;
    line-height: 1;
  }
  .grh-headerc__fb-lage {
    font-family: var(--grh-font-display);
    font-size: var(--grh-fs-md);
    font-weight: 500;
    color: var(--grh-forest-900);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .grh-headerc__fb-ort {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--grh-stone-400);
    margin-top: 2px;
  }

  /* Anders als das Wetter bleibt die Plakette auf dem Handy sichtbar —
     nur auf den farbigen Punkt reduziert. „Hat das Bad offen?" ist genau
     die Frage, die unterwegs gestellt wird. */
  @media (max-width: 720px) {
    .grh-headerc__fb { padding: 6px; margin-right: 4px; }
    .grh-headerc__fb-text { display: none; }
  }

  .grh-headerc__burger {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--grh-space-3);
    padding: 10px 16px 10px 14px;
    /* 33 px waren zu wenig für DIE Bedienung des Menüs auf dem Telefon. */
    min-height: 44px;
    border-radius: var(--grh-radius-pill);
    background: var(--grh-forest-900);
    color: var(--grh-cream-50);
    cursor: pointer;
    transition: background var(--grh-dur-fast), transform var(--grh-dur-fast);
    justify-self: end;
    position: relative;
    isolation: isolate;
  }
  /* Sehr sanftes „Atmen“: diffuser Goldschein um den Button. Der Schein
     liegt auf einem eigenen Element und wird nur in seiner Deckkraft
     animiert. Vorher wurde der box-shadow des Buttons selbst animiert;
     das zwingt den Browser in jedem Bild zum Neuzeichnen, und unter dem
     halbtransparenten, weichgezeichneten Kopf (backdrop-filter) flackerte
     das in Edge sichtbar. Deckkraft läuft dagegen auf dem Compositor. */
  .grh-headerc__burger::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow:
      0 0 24px 6px  rgba(232, 182, 88, 0.16),
      0 0 50px 18px rgba(232, 182, 88, 0.08);
    /* Fester, leiser Schein ohne Animation. Das frühere „Atmen“ war die
       zweite Flackerquelle in Edge; der Effekt war ohnehin kaum sichtbar. */
    opacity: 0.6;
    z-index: -1;
    pointer-events: none;
  }
  .grh-headerc__burger:hover {
    background: var(--grh-forest-800);
    transform: translateY(-1px);
  }
  .grh-headerc__burger-bars {
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
    width: 18px;
  }
  .grh-headerc__burger-bars span {
    height: 1.5px;
    background: var(--grh-cream-50);
    border-radius: 1px;
    transition: transform var(--grh-dur-fast), opacity var(--grh-dur-fast);
  }
  .grh-headerc__burger-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-weight: 600;
  }
  @media (max-width: 480px) {
    .grh-headerc__burger-label { display: none; }
  }
</style>

<script>
  import { initSuche, ladeIndex } from '../../lib/suche-client';

  /* === Suchfeld in der Kopfzeile ============================ */
  (() => {
    const wrap  = document.querySelector<HTMLElement>('[data-grh-header-suche]');
    const knopf = wrap?.querySelector<HTMLButtonElement>('[data-grh-suche-open]');
    const input = wrap?.querySelector<HTMLInputElement>('[data-grh-header-suche-input]');
    const liste = wrap?.querySelector<HTMLElement>('[data-grh-header-suche-liste]');
    const zu    = wrap?.querySelector<HTMLButtonElement>('[data-grh-header-suche-close]');
    if (!wrap || !knopf || !input || !liste) return;

    initSuche({ input, liste, prefix: 'grh-header-treffer' });

    const tools = wrap.closest<HTMLElement>('.grh-headerc__tools');
    const oeffnen = () => {
      tools?.classList.add('is-searching');
      wrap.classList.add('is-open');
      knopf.setAttribute('aria-expanded', 'true');
      input.removeAttribute('tabindex');
      zu?.removeAttribute('tabindex');
      ladeIndex();
      window.setTimeout(() => input.focus({ preventScroll: true }), 260);
    };
    const schliessen = () => {
      tools?.classList.remove('is-searching');
      wrap.classList.remove('is-open');
      knopf.setAttribute('aria-expanded', 'false');
      input.setAttribute('tabindex', '-1');
      zu?.setAttribute('tabindex', '-1');
      input.value = '';
      liste.setAttribute('hidden', '');
      liste.innerHTML = '';
    };
    knopf.addEventListener('click', () => {
      if (wrap.classList.contains('is-open')) input.focus();
      else oeffnen();
    });
    zu?.addEventListener('click', () => { schliessen(); knopf.focus({ preventScroll: true }); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && wrap.classList.contains('is-open')) { schliessen(); knopf.focus({ preventScroll: true }); }
    });
    document.addEventListener('pointerdown', (e) => {
      if (wrap.classList.contains('is-open') && !wrap.contains(e.target as Node)) schliessen();
    });
  })();

  const compactHeader = document.querySelector<HTMLElement>('.grh-header--compact[data-grh-header]');
  if (compactHeader) {
    let ticking = false;
    const update = () => {
      /* Mit Hysterese: Der Kopf wird beim Schrumpfen 42 px niedriger.
         Auf kurzen Seiten rutschte dadurch die Scrollposition wieder
         unter die Schwelle, der Kopf wuchs, die Position sprang zurück,
         und so weiter: ein sichtbares Flackern. Deshalb zwei Schwellen
         mit Abstand, und gar kein Schrumpfen, wenn die Seite nicht weit
         genug scrollen kann. */
      const y = window.scrollY;
      const spielraum = document.documentElement.scrollHeight - window.innerHeight;
      const istKlein = compactHeader.classList.contains('is-scrolled');
      let klein = istKlein;
      if (spielraum < 120) klein = false;
      else if (!istKlein && y > 48) klein = true;
      else if (istKlein && y < 4) klein = false;
      if (klein !== istKlein) compactHeader.classList.toggle('is-scrolled', klein);
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) { requestAnimationFrame(update); ticking = true; }
    }, { passive: true });
  }

  /* === Live-Wetter via Open-Meteo (kein API-Key, kein Tracking) ===========
     Grünhainichen-Koordinaten 50.7718 / 13.1578.
     Browser-Cache (sessionStorage) hält die Daten 30 Min vor.            */
  (() => {
    const widget = document.querySelector<HTMLElement>('[data-grh-weather]');
    const tempEl = document.querySelector<HTMLElement>('[data-grh-weather-temp]');
    const iconEl = document.querySelector<HTMLElement>('[data-grh-weather-icon]');
    if (!widget || !tempEl || !iconEl) return;

    const CACHE_KEY = 'grh-weather-v1';
    const CACHE_MAX_AGE = 30 * 60 * 1000;

    /* WMO-Code → SVG-Icon. Linien sind monochrom currentColor.            */
    const ICONS: Record<string, string> = {
      sun:    `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><line x1="12" y1="3"   x2="12" y2="5"/><line x1="12" y1="19"  x2="12" y2="21"/><line x1="3"  y1="12"  x2="5"  y2="12"/><line x1="19" y1="12"  x2="21" y2="12"/><line x1="5.6" y1="5.6" x2="7" y2="7"/><line x1="17" y1="17" x2="18.4" y2="18.4"/><line x1="5.6" y1="18.4" x2="7" y2="17"/><line x1="17" y1="7" x2="18.4" y2="5.6"/></svg>`,
      cloud:  `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 18a4 4 0 0 1-1-7.9 6 6 0 0 1 11.5 1.4A4.5 4.5 0 0 1 17.5 18z"/></svg>`,
      partly: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="10" r="3.2"/><line x1="9" y1="3.5" x2="9" y2="5"/><line x1="2.5" y1="10" x2="4" y2="10"/><line x1="4.5" y1="5.5" x2="5.5" y2="6.5"/><line x1="4.5" y1="14.5" x2="5.5" y2="13.5"/><line x1="12.5" y1="6.5" x2="13.5" y2="5.5"/><path d="M11 18a3 3 0 0 1 5.5-1.6 3 3 0 0 1 4 4.6H13a3 3 0 0 1-2-3z" fill="currentColor" stroke="none" opacity="0.85"/></svg>`,
      fog:    `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><line x1="3" y1="8"  x2="21" y2="8"/><line x1="5" y1="12" x2="19" y2="12"/><line x1="3" y1="16" x2="21" y2="16"/></svg>`,
      rain:   `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 14a4 4 0 0 1-1-7.9 6 6 0 0 1 11.5 1.4A4.5 4.5 0 0 1 17.5 14z"/><line x1="9" y1="17" x2="8" y2="20"/><line x1="13" y1="17" x2="12" y2="20"/><line x1="17" y1="17" x2="16" y2="20"/></svg>`,
      snow:   `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 14a4 4 0 0 1-1-7.9 6 6 0 0 1 11.5 1.4A4.5 4.5 0 0 1 17.5 14z"/><circle cx="9"  cy="19" r="0.8" fill="currentColor"/><circle cx="13" cy="19" r="0.8" fill="currentColor"/><circle cx="17" cy="19" r="0.8" fill="currentColor"/></svg>`,
      storm:  `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 14a4 4 0 0 1-1-7.9 6 6 0 0 1 11.5 1.4A4.5 4.5 0 0 1 17.5 14z"/><polyline points="12 16 10 19 13 19 11 22"/></svg>`,
    };

    const codeToIcon = (code: number): string => {
      if (code === 0)                          return 'sun';
      if (code === 1 || code === 2)            return 'partly';
      if (code === 3)                          return 'cloud';
      if (code === 45 || code === 48)          return 'fog';
      if ((code >= 51 && code <= 67) || (code >= 80 && code <= 82)) return 'rain';
      if ((code >= 71 && code <= 77) || code === 85 || code === 86) return 'snow';
      if (code >= 95)                          return 'storm';
      return 'partly';
    };

    const render = (tempC: number, code: number) => {
      tempEl.textContent = `${Math.round(tempC)}°`;
      iconEl.innerHTML = ICONS[codeToIcon(code)] ?? ICONS.partly;
      widget.removeAttribute('hidden');
    };

    /* Cache zuerst, dann frisch holen */
    try {
      const cached = sessionStorage.getItem(CACHE_KEY);
      if (cached) {
        const { temp, code, ts } = JSON.parse(cached);
        if (Date.now() - ts < CACHE_MAX_AGE) render(temp, code);
      }
    } catch {}

    fetch('https://api.open-meteo.com/v1/forecast?latitude=50.7718&longitude=13.1578&current=temperature_2m,weather_code&timezone=Europe%2FBerlin')
      .then((r) => r.ok ? r.json() : Promise.reject(r.status))
      .then((d) => {
        const temp = d?.current?.temperature_2m;
        const code = d?.current?.weather_code;
        if (typeof temp !== 'number' || typeof code !== 'number') return;
        render(temp, code);
        try { sessionStorage.setItem(CACHE_KEY, JSON.stringify({ temp, code, ts: Date.now() })); } catch {}
      })
      .catch(() => { /* Bei Fehler bleibt das Widget einfach hidden — niemand sieht 8° Lüge */ });
  })();

  /* ---------------------------------------------------------------------
     Freibad Borstendorf
     Gepflegt im WordPress des Verbands, geliefert von vv-rest-freibad.php.
     Bewusst clientseitig wie das Wetter: Die Seiten liegen fertig gebaut
     auf dem Server, teils tagelang. Würde der Status mitgebaut, stünde
     nach einer Schließung womöglich noch „offen" da — und jemand führe
     bei 30 Grad vor ein verschlossenes Tor.
  --------------------------------------------------------------------- */
  (() => {
    const pill = document.querySelector<HTMLElement>('[data-grh-fb-pill]');
    const icon = document.querySelector<HTMLElement>('[data-grh-fb-icon]');
    const lage = document.querySelector<HTMLElement>('[data-grh-fb-lage]');
    if (!pill || !icon || !lage) return;

    const API = 'https://vv-wildenstein.com/wp-json/vvw/v1/freibad';
    const KEY = 'grh-freibad-v1';
    const MAX_AGE = 10 * 60 * 1000; // 10 Minuten — häufiger ändert sich nichts

    const zeit = (t: string) => (t || '').replace(/:00$/, '');

    const kurz = (iso: string) => {
      const [y, m, d] = (iso || '').split('-').map(Number);
      if (!y) return '';
      return new Date(y, m - 1, d).toLocaleDateString('de-DE', { day: 'numeric', month: 'short' });
    };

    interface Zeitraum {
      von: string; bis: string; zeitVon: string; zeitBis: string;
      status: string; label: string; hinweis: string; offen: boolean;
    }

    const render = (d: { aktuell: Zeitraum | null; kommend: Zeitraum[] }) => {
      const jetzt = d.aktuell;
      const z = jetzt ?? d.kommend?.[0];
      if (!z) { pill.setAttribute('hidden', ''); return; }

      icon.className = 'grh-headerc__fb-icon grh-headerc__fb-icon--' + z.status;

      if (jetzt) {
        // Läuft heute: Die Uhrzeit ist die eigentliche Information.
        const bis = zeit(z.zeitBis);
        lage.textContent = z.offen
          ? (bis ? 'bis ' + bis + ' Uhr' : 'geöffnet')
          : z.label;
      } else {
        lage.textContent = 'ab ' + kurz(z.von);
      }

      pill.setAttribute(
        'aria-label',
        'Freibad Borstendorf: ' + (jetzt ? z.label : 'ab ' + kurz(z.von)) +
        (z.hinweis ? ', ' + z.hinweis : '') + '. Zur Seite Baden.'
      );
      if (z.hinweis) pill.title = z.hinweis;

      pill.removeAttribute('hidden');
    };

    try {
      const c = sessionStorage.getItem(KEY);
      if (c) {
        const { data, ts } = JSON.parse(c);
        if (Date.now() - ts < MAX_AGE) render(data);
      }
    } catch {}

    fetch(API, { headers: { Accept: 'application/json' } })
      .then((r) => r.ok ? r.json() : Promise.reject(r.status))
      .then((d) => {
        if (!d?.verfuegbar) { pill.setAttribute('hidden', ''); return; }
        render(d);
        try { sessionStorage.setItem(KEY, JSON.stringify({ data: d, ts: Date.now() })); } catch {}
      })
      .catch(() => { /* Nicht erreichbar: lieber gar keine Angabe als eine falsche. */ });
  })();
</script>
