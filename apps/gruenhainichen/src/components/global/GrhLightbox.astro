---
/**
 * Lightbox für die ganze Website (im BaseLayout eingebunden).
 *
 * Öffnet in der Großansicht:
 *  - Links auf Bilddateien (z. B. das Plakat auf einer Terminseite), statt die
 *    Datei in einem neuen Tab zu zeigen,
 *  - Inhaltsbilder ohne Link in WordPress-Texten (.grh-prose, .grh-programm),
 *    in <figure> und in allem mit data-grh-lb.
 * Nicht: Bilder in Links, Knöpfen, Karten, Titelbild-Slider, außerhalb von <main>, SVG-Logos,
 * Bilder unter 120 × 90 px und alles in [data-grh-lb-aus]. Galerien mit eigener
 * Lightbox (Heimatfest-Rückblick) bleiben unberührt.
 *
 * ←/→ und Wischen blättern, ESC oder Klick daneben schließt.
 */
---
<div class="grh-lbx" data-grh-lbx hidden role="dialog" aria-modal="true" aria-label="Bild in Großansicht">
  <button type="button" class="grh-lbx__zu" data-grh-lbx-zu aria-label="Großansicht schließen">×</button>
  <button type="button" class="grh-lbx__nav grh-lbx__nav--zurueck" data-grh-lbx-zurueck aria-label="Voriges Bild">‹</button>
  <figure class="grh-lbx__buehne">
    <img data-grh-lbx-bild src="" alt="" />
    <figcaption class="grh-lbx__text" data-grh-lbx-text></figcaption>
  </figure>
  <button type="button" class="grh-lbx__nav grh-lbx__nav--weiter" data-grh-lbx-weiter aria-label="Nächstes Bild">›</button>
  <span class="grh-lbx__zahl" data-grh-lbx-zahl></span>
</div>

<style>
  .grh-lbx {
    position: fixed;
    inset: 0;
    z-index: 9000; /* über dem schwebenden Kontaktknopf (8500), unter dem Cookie-Hinweis */
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 56px 72px;
    background: rgba(20, 43, 31, 0.94);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    animation: grh-lbx-auf 180ms ease-out;
  }
  .grh-lbx[hidden] { display: none; }
  @keyframes grh-lbx-auf { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .grh-lbx { animation: none; } }

  .grh-lbx__buehne {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    max-width: 100%;
    max-height: 100%;
  }
  .grh-lbx__buehne img {
    display: block;
    max-width: min(92vw, 1600px);
    max-height: calc(100vh - 150px);
    width: auto;
    height: auto;
    border-radius: 3px;
    box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.7);
    background: var(--grh-cream-50);
  }
  .grh-lbx__text {
    max-width: 70ch;
    color: rgba(250, 247, 241, 0.88);
    font-size: var(--grh-fs-sm);
    line-height: 1.5;
    text-align: center;
  }
  .grh-lbx__text:empty { display: none; }

  .grh-lbx__zu,
  .grh-lbx__nav {
    position: absolute;
    display: grid;
    place-items: center;
    color: var(--grh-cream-50);
    background: rgba(250, 247, 241, 0.1);
    border: 1px solid rgba(250, 247, 241, 0.25);
    border-radius: 50%;
    cursor: pointer;
    font-family: var(--grh-font-body);
    line-height: 1;
    transition: background var(--grh-dur-fast), transform var(--grh-dur-fast);
  }
  .grh-lbx__zu:hover,
  .grh-lbx__nav:hover,
  .grh-lbx__zu:focus-visible,
  .grh-lbx__nav:focus-visible { background: rgba(250, 247, 241, 0.24); }
  .grh-lbx__zu { top: 16px; right: 16px; width: 44px; height: 44px; font-size: 28px; }
  .grh-lbx__nav { top: 50%; translate: 0 -50%; width: 52px; height: 52px; font-size: 34px; padding-bottom: 4px; }
  .grh-lbx__nav--zurueck { left: 14px; }
  .grh-lbx__nav--weiter { right: 14px; }
  .grh-lbx__nav[hidden] { display: none; }
  .grh-lbx__zahl {
    position: absolute;
    top: 26px;
    left: 50%;
    translate: -50% 0;
    color: rgba(250, 247, 241, 0.75);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  @media (max-width: 640px) {
    .grh-lbx { padding: 64px 12px 24px; }
    .grh-lbx__nav { top: auto; bottom: 16px; translate: none; width: 46px; height: 46px; }
    .grh-lbx__buehne img { max-height: calc(100vh - 190px); }
  }

  /* Hinweis am Bild selbst */
  :global([data-grh-lb-bild]) { cursor: zoom-in; }
</style>

<script>
  const lb = document.querySelector<HTMLElement>('[data-grh-lbx]');
  if (lb) {
    const bild = lb.querySelector<HTMLImageElement>('[data-grh-lbx-bild]')!;
    const text = lb.querySelector<HTMLElement>('[data-grh-lbx-text]')!;
    const zahl = lb.querySelector<HTMLElement>('[data-grh-lbx-zahl]')!;
    const zu = lb.querySelector<HTMLButtonElement>('[data-grh-lbx-zu]')!;
    const zurueck = lb.querySelector<HTMLButtonElement>('[data-grh-lbx-zurueck]')!;
    const weiter = lb.querySelector<HTMLButtonElement>('[data-grh-lbx-weiter]')!;

    const BILDDATEI = /\.(jpe?g|png|webp|gif|avif)(\?.*)?$/i;
    // Nur Bilder in <main>; Kopf, Fuß und Menü der Website liegen außerhalb.
    const AUSSER = 'a, button, .leaflet-container, .grh-hero, [aria-hidden="true"], [data-grh-lb-aus], [data-grh-lightbox-gallery], .grh-gallery, [data-grh-lbx]';
    const BEREICH = '.grh-prose, .grh-programm, figure, [data-grh-lb]';

    // Bildlinks und Inhaltsbilder markieren
    const EIGENE_GALERIE = '[data-grh-lb-aus], [data-grh-lightbox-gallery], .grh-gallery';
    document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((a) => {
      if (a.closest(EIGENE_GALERIE)) return;
      try {
        if (BILDDATEI.test(new URL(a.href).pathname)) a.dataset.grhLbLink = '';
      } catch { /* ungültige Adresse */ }
    });
    const markiere = (img: HTMLImageElement) => {
      if (img.dataset.grhLbBild !== undefined) return;
      if (!img.closest(BEREICH) || img.closest(AUSSER)) return;
      if (/\.svg(\?.*)?$/i.test(img.currentSrc || img.src)) return;
      if (img.clientWidth < 120 || img.clientHeight < 90) return;
      img.dataset.grhLbBild = '';
      img.tabIndex = 0;
      img.setAttribute('role', 'button');
      img.setAttribute('aria-label', `Bild vergrößern${img.alt ? `: ${img.alt}` : ''}`);
    };
    const pruefeBilder = () => document.querySelectorAll<HTMLImageElement>('main img').forEach((img) => {
      if (img.complete) markiere(img);
      else img.addEventListener('load', () => markiere(img), { once: true });
    });
    pruefeBilder();

    /** Größte sinnvolle Fassung: aus srcset, sonst WordPress-Größenzusatz (-300x200) weg. */
    const gross = (img: HTMLImageElement): string => {
      const kandidaten = (img.getAttribute('srcset') || '')
        .split(',')
        .map((s) => s.trim().split(/\s+/))
        .map(([url, w]) => ({ url, w: parseInt(w, 10) || 0 }))
        .filter((k) => k.url && k.w && k.w <= 2400)
        .sort((a, b) => b.w - a.w);
      if (kandidaten[0]) return kandidaten[0].url;
      const src = img.currentSrc || img.src;
      return /\/wp-content\/uploads\//.test(src) ? src.replace(/-\d+x\d+(\.\w+)(\?.*)?$/, '$1$2') : src;
    };

    interface Eintrag { el: HTMLElement; src: string; ersatz: string; text: string }
    const sammeln = (): Eintrag[] =>
      [...document.querySelectorAll<HTMLElement>('[data-grh-lb-bild], a[data-grh-lb-link]')].map((el) => {
        if (el instanceof HTMLAnchorElement) {
          const img = el.querySelector('img');
          return { el, src: el.href, ersatz: img?.currentSrc || el.href, text: img?.alt || el.title || '' };
        }
        const img = el as HTMLImageElement;
        const fig = img.closest('figure')?.querySelector('figcaption')?.textContent?.trim();
        return { el, src: gross(img), ersatz: img.currentSrc || img.src, text: fig || img.alt || '' };
      });

    let liste: Eintrag[] = [];
    let pos = 0;
    let ausloeser: HTMLElement | null = null;

    const zeige = (i: number) => {
      pos = (i + liste.length) % liste.length;
      const e = liste[pos];
      bild.onerror = () => { bild.onerror = null; bild.src = e.ersatz; };
      bild.src = e.src;
      bild.alt = e.text;
      text.textContent = e.text;
      const mehrere = liste.length > 1;
      zahl.textContent = mehrere ? `${pos + 1} / ${liste.length}` : '';
      zurueck.hidden = weiter.hidden = !mehrere;
    };
    const oeffne = (el: HTMLElement) => {
      liste = sammeln();
      const i = liste.findIndex((e) => e.el === el);
      if (i < 0) return;
      ausloeser = el;
      zeige(i);
      lb.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      zu.focus();
    };
    const schliesse = () => {
      lb.hidden = true;
      bild.removeAttribute('src');
      document.documentElement.style.overflow = '';
      ausloeser?.focus();
      ausloeser = null;
    };

    document.addEventListener('click', (ev) => {
      if (ev.defaultPrevented || ev.button !== 0 || ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey) return;
      const el = (ev.target as HTMLElement).closest<HTMLElement>('[data-grh-lb-bild], a[data-grh-lb-link]');
      if (!el) return;
      ev.preventDefault();
      oeffne(el);
    });
    document.addEventListener('keydown', (ev) => {
      const el = ev.target as HTMLElement;
      if (lb.hidden && el?.dataset?.grhLbBild !== undefined && (ev.key === 'Enter' || ev.key === ' ')) {
        ev.preventDefault();
        oeffne(el);
        return;
      }
      if (lb.hidden) return;
      if (ev.key === 'Escape') schliesse();
      else if (ev.key === 'ArrowLeft') zeige(pos - 1);
      else if (ev.key === 'ArrowRight') zeige(pos + 1);
      else if (ev.key === 'Tab') {
        // Fokus im Fenster halten
        const knoepfe = [...lb.querySelectorAll<HTMLElement>('button')].filter((b) => !b.hidden);
        const erster = knoepfe[0];
        const letzter = knoepfe[knoepfe.length - 1];
        if (ev.shiftKey && document.activeElement === erster) { ev.preventDefault(); letzter.focus(); }
        else if (!ev.shiftKey && document.activeElement === letzter) { ev.preventDefault(); erster.focus(); }
      }
    });
    zu.addEventListener('click', schliesse);
    zurueck.addEventListener('click', () => zeige(pos - 1));
    weiter.addEventListener('click', () => zeige(pos + 1));
    lb.addEventListener('click', (ev) => {
      if (ev.target === lb || ev.target === lb.querySelector('.grh-lbx__buehne')) schliesse();
    });
    // Wischen auf dem Handy
    let startX = 0;
    lb.addEventListener('touchstart', (ev) => { startX = ev.touches[0].clientX; }, { passive: true });
    lb.addEventListener('touchend', (ev) => {
      const dx = ev.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50 && liste.length > 1) zeige(pos + (dx < 0 ? 1 : -1));
    }, { passive: true });
  }
</script>
