---
import { getCollection } from 'astro:content';
import GrhIcon from '../primitives/GrhIcon.astro';
import GrhWappen from './GrhWappen.astro';
import { navigation as nav } from '../../lib/navigation';
import { getNews } from '../../lib/cms';

// Inhalte für die linke dunkle Spalte
const newsAll = await getNews();
const latestNews  = newsAll.filter((n) => n.category !== 'sperrung').slice(0, 3);
const sperrungen  = newsAll.filter((n) => n.category === 'sperrung').slice(0, 2);

const upcomingEvents = (await getCollection('events'))
  .filter((e) => e.data.startDate.valueOf() >= Date.now() - 86400000)
  .sort((a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf())
  .slice(0, 3);

const fmtShortDate = new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: '2-digit' });
const fmtDay   = new Intl.DateTimeFormat('de-DE', { day: '2-digit' });
const fmtMonth = new Intl.DateTimeFormat('de-DE', { month: 'short' });
---
<div class="grh-mega" data-grh-megamenu data-grh-mega-variant="default" hidden role="dialog" aria-modal="true" aria-label="Hauptnavigation">
  <div class="grh-mega__backdrop" data-grh-megamenu-close></div>

  <div class="grh-mega__panel" role="document">
    {/* === DEMO B/A: Live-Ticker (Position via CSS oben/unten gesteuert) === */}
    <div class="grh-mega__ticker" data-grh-mega-block="ticker">
      <div class="grh-container grh-mega__ticker-inner">
        <span class="grh-mega__ticker-pill grh-mega__ticker-pill--news">
          <strong>{latestNews.length}</strong> News
        </span>
        {sperrungen.length > 0 && (
          <span class="grh-mega__ticker-pill grh-mega__ticker-pill--alert">
            <strong>{sperrungen.length}</strong> Sperrung{sperrungen.length === 1 ? '' : 'en'}
          </span>
        )}
        {upcomingEvents.length > 0 && (
          <span class="grh-mega__ticker-pill">
            Nächster Termin: <strong>{fmtShortDate.format(upcomingEvents[0].data.startDate)}</strong> · {upcomingEvents[0].data.title}
          </span>
        )}
        <a class="grh-mega__ticker-more" href="/neuigkeiten">Alle Live-Infos →</a>
      </div>
    </div>

    {/* === DEMO C: Floating Live-Card === */}
    <aside class="grh-mega__floating" data-grh-mega-block="floating" aria-label="Live-Infos">
      <h3>Live</h3>
      {latestNews[0] && (
        <a class="grh-mega__floating-item" href={latestNews[0].href}>
          <span class="grh-mega__floating-cat">Aktuelles</span>
          <span class="grh-mega__floating-title">{latestNews[0].title}</span>
        </a>
      )}
      {sperrungen[0] && (
        <a class="grh-mega__floating-item grh-mega__floating-item--alert" href={sperrungen[0].href}>
          <span class="grh-mega__floating-cat">Sperrung</span>
          <span class="grh-mega__floating-title">{sperrungen[0].title}</span>
        </a>
      )}
      {upcomingEvents[0] && (
        <a class="grh-mega__floating-item" href={`/veranstaltungen/${upcomingEvents[0].slug}`}>
          <span class="grh-mega__floating-cat">{fmtShortDate.format(upcomingEvents[0].data.startDate)}</span>
          <span class="grh-mega__floating-title">{upcomingEvents[0].data.title}</span>
        </a>
      )}
      <a class="grh-mega__floating-more" href="/neuigkeiten">Mehr →</a>
    </aside>
    {/* === Linke Spalte: dunkler Wichtig-Block ============================= */}
    <aside class="grh-mega__brief">
      <div class="grh-mega__brief-top">
        <a href="/" class="grh-mega__brief-brand" aria-label="Startseite">
          <GrhWappen size={64} class="grh-mega__brief-wappen" />
          <span class="grh-mega__brief-brandtext">
            <span class="grh-mega__brief-sub">Gemeinde</span>
            <span class="grh-mega__brief-name">Grünhainichen</span>
          </span>
        </a>
      </div>

      <div class="grh-mega__brief-content">
        {/* Aktuelle News */}
        <section class="grh-mega__brief-section">
          <h3>Aktuelles</h3>
          <ul>
            {latestNews.map((n) => (
              <li>
                <a href={n.href}>
                  <time>{fmtShortDate.format(n.date)}</time>
                  <span>{n.title}</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="grh-mega__brief-more" href="/neuigkeiten">
            Alle Neuigkeiten <GrhIcon name="arrow-right" size={12} />
          </a>
        </section>

        {/* Sperrungen — falls aktuell */}
        {sperrungen.length > 0 && (
          <section class="grh-mega__brief-section grh-mega__brief-section--alert">
            <h3>
              <GrhIcon name="map-pin" size={12} />
              Sperrungen
            </h3>
            <ul>
              {sperrungen.map((s) => (
                <li>
                  <a href={s.href}>
                    <time>{fmtShortDate.format(s.date)}</time>
                    <span>{s.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {/* Demnächst */}
        {upcomingEvents.length > 0 && (
          <section class="grh-mega__brief-section">
            <h3>Demnächst</h3>
            <ul class="grh-mega__brief-events">
              {upcomingEvents.map((e) => (
                <li>
                  <a href={`/veranstaltungen/${e.slug}`}>
                    <span class="grh-mega__brief-date">
                      <strong>{fmtDay.format(e.data.startDate)}</strong>
                      <em>{fmtMonth.format(e.data.startDate).replace('.', '')}</em>
                    </span>
                    <span class="grh-mega__brief-event-title">{e.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
            <a class="grh-mega__brief-more" href="/veranstaltungen">
              Vollständiger Kalender <GrhIcon name="arrow-right" size={12} />
            </a>
          </section>
        )}
      </div>

      <div class="grh-mega__brief-foot">
        <a href="tel:+4937294170-0"><GrhIcon name="phone" size={12} /> 037294 / 170-0</a>
        <a href="mailto:info@wildenstein.ws"><GrhIcon name="mail" size={12} /> info@wildenstein.ws</a>
      </div>
    </aside>

    {/* === Rechte Spalte: kompakte Navigation ============================= */}
    <div class="grh-mega__main">
      <header class="grh-mega__top">
        <span class="grh-mega__top-label">Navigation</span>
        <button class="grh-mega__close" type="button" aria-label="Menü schließen" data-grh-megamenu-close>
          <GrhIcon name="close" size={20} />
          <span>Schließen</span>
        </button>
      </header>

      <nav class="grh-mega__columns" aria-label="Vollständige Navigation">
        {nav.map((item) => (
          <section class="grh-mega__col">
            <a href={item.href} class="grh-mega__col-head">
              {item.label}
              {item.wip && <span class="grh-mega__wip" title="Inhalt noch in Klärung" aria-label="Inhalt noch nicht final">!</span>}
            </a>

            {item.children && (
              <ul class="grh-mega__sublist">
                {item.children.map((sub) => (
                  <li>
                    <a href={sub.href} class="grh-mega__sublink">
                      {sub.label}
                      {sub.wip && <span class="grh-mega__wip" title="Inhalt noch in Klärung" aria-label="Inhalt noch nicht final">!</span>}
                    </a>
                    {sub.children && (
                      <ul class="grh-mega__sublist3">
                        {sub.children.map((sub3) => (
                          <li>
                            <a href={sub3.href}>
                              {sub3.label}
                              {sub3.wip && <span class="grh-mega__wip" title="Inhalt noch in Klärung" aria-label="Inhalt noch nicht final">!</span>}
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}
      </nav>

      {/* === DEMO A: Inline-Ticker zwischen Navigation und „Drei Orte"-Card === */}
      <div class="grh-mega__ticker grh-mega__ticker--inline" data-grh-mega-block="ticker-inline">
        <div class="grh-mega__ticker-inner">
          <span class="grh-mega__ticker-pill grh-mega__ticker-pill--news">
            <strong>{latestNews.length}</strong> News
          </span>
          {sperrungen.length > 0 && (
            <span class="grh-mega__ticker-pill grh-mega__ticker-pill--alert">
              <strong>{sperrungen.length}</strong> Sperrung{sperrungen.length === 1 ? '' : 'en'}
            </span>
          )}
          {upcomingEvents.length > 0 && (
            <span class="grh-mega__ticker-pill">
              Nächster Termin: <strong>{fmtShortDate.format(upcomingEvents[0].data.startDate)}</strong> · {upcomingEvents[0].data.title}
            </span>
          )}
          <a class="grh-mega__ticker-more" href="/neuigkeiten">Alle Live-Infos →</a>
        </div>
      </div>

      <aside class="grh-mega__feature">
        <div class="grh-mega__feature-quote">
          <span class="grh-mega__feature-eyebrow">Drei Orte, eine Heimat</span>
          <p>
            <em>Wo Holz noch riecht, der Schach­wanderweg ruft</em>
            und im Advent jedes Fenster leuchtet.
          </p>
        </div>
        <a class="grh-mega__feature-card" href="/veranstaltungen/eurorando-2026">
          <span class="grh-mega__feature-img" aria-hidden="true">
            <img src="/images/tourism/wandern.jpg" alt="" loading="lazy" decoding="async" />
          </span>
          <span class="grh-mega__feature-body">
            <span class="grh-mega__feature-tag">Empfehlung — EURORANDO 2026</span>
            <span class="grh-mega__feature-title">Zwei Touren auf dem Zschopautalweg</span>
            <span class="grh-mega__feature-cta">
              23. & 27. September · Anmelden <GrhIcon name="arrow-right" size={12} />
            </span>
          </span>
        </a>
      </aside>

      <footer class="grh-mega__foot">
        <ul>
          <li><a href="/impressum">Impressum</a></li>
          <li><a href="/datenschutz">Datenschutz</a></li>
          <li><a href="/barrierefreiheit">Barrierefreiheit</a></li>
        </ul>
      </footer>
    </div>
  </div>
</div>

<style>
  .grh-mega {
    position: fixed;
    inset: 0;
    z-index: 9000;
  }
  .grh-mega[hidden] { display: block !important; visibility: hidden; pointer-events: none; }
  .grh-mega[data-open] { visibility: visible; pointer-events: auto; }

  .grh-mega__backdrop {
    position: absolute; inset: 0;
    background: rgba(20, 43, 31, 0.55);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity var(--grh-dur-base) var(--grh-ease-out);
    cursor: pointer;
  }
  .grh-mega[data-open] .grh-mega__backdrop { opacity: 1; }

  .grh-mega__panel {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1fr;
    transform: translateY(-12px);
    opacity: 0;
    transition:
      transform var(--grh-dur-base) var(--grh-ease-out),
      opacity   var(--grh-dur-base) var(--grh-ease-out);
    overflow: hidden;
  }
  @media (min-width: 980px) {
    .grh-mega__panel { grid-template-columns: 5fr 7fr; }
  }
  .grh-mega[data-open] .grh-mega__panel {
    transform: translateY(0);
    opacity: 1;
  }

  /* === Linke dunkle Spalte ================================== */
  .grh-mega__brief {
    background:
      radial-gradient(circle at 0% 0%, rgba(91, 174, 120, 0.18), transparent 55%),
      var(--grh-forest-950);
    color: var(--grh-cream-50);
    padding: var(--grh-space-7) var(--grh-space-6);
    display: flex;
    flex-direction: column;
    gap: var(--grh-space-6);
    overflow-y: auto;
  }

  .grh-mega__brief-top {
    border-bottom: 1px solid rgba(250, 247, 241, 0.12);
    padding-bottom: var(--grh-space-5);
  }
  .grh-mega__brief-brand {
    display: flex;
    align-items: center;
    gap: var(--grh-space-3);
    text-decoration: none;
    color: inherit;
    width: 100%;
  }
  .grh-mega__brief-wappen {
    filter: drop-shadow(0 2px 12px rgba(0, 0, 0, 0.4));
  }
  .grh-mega__brief-brandtext {
    display: flex;
    flex-direction: column;
    gap: 4px;
    line-height: 1;
    flex: 1;
    min-width: 0;
  }
  .grh-mega__brief-name {
    font-family: var(--grh-font-display);
    font-size: var(--grh-fs-2xl);
    font-weight: 500;
    color: var(--grh-cream-50);
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .grh-mega__brief-sub {
    font-family: var(--grh-font-body);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--grh-candle-500);
    font-weight: 600;
  }
  /* Mobile: Schriftzug fliegt bis fast an den rechten Rand —
     gleicher Abstand zum Rand wie das Wappen links (Brief-Padding). */
  @media (max-width: 980px) {
    .grh-mega__brief-name {
      font-size: clamp(2.23rem, 10.24vw, 4.1rem);
      letter-spacing: -0.03em;
      font-stretch: 105%;
    }
    .grh-mega__brief-sub  { font-size: 11px; letter-spacing: 0.22em; }
  }
  @media (max-width: 480px) {
    .grh-mega__brief-sub { font-size: 10px; letter-spacing: 0.2em; }
  }

  .grh-mega__brief-content {
    display: flex;
    flex-direction: column;
    gap: var(--grh-space-6);
    flex: 1;
  }

  .grh-mega__brief-section h3 {
    font-family: var(--grh-font-body);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-weight: 600;
    color: var(--grh-candle-500);
    margin-bottom: var(--grh-space-3);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .grh-mega__brief-section--alert h3 { color: #F2A07F; } /* helleres Rotbraun für dunkle BG */
  .grh-mega__brief-section ul {
    display: flex;
    flex-direction: column;
    gap: 0;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .grh-mega__brief-section li {
    border-top: 1px solid rgba(250, 247, 241, 0.1);
  }
  .grh-mega__brief-section li:first-child { border-top: none; }
  .grh-mega__brief-section li a {
    display: grid;
    grid-template-columns: 50px 1fr;
    gap: var(--grh-space-3);
    align-items: baseline;
    padding: 10px 0;
    text-decoration: none;
    color: var(--grh-cream-50);
    transition: color var(--grh-dur-fast), padding-left var(--grh-dur-fast);
  }
  .grh-mega__brief-section li a:hover {
    color: var(--grh-candle-300);
    padding-left: 4px;
  }
  .grh-mega__brief-section time {
    font-family: var(--grh-font-display);
    font-style: italic;
    font-size: var(--grh-fs-sm);
    color: var(--grh-candle-300);
    opacity: 0.8;
  }
  .grh-mega__brief-section li a span:not(time):not(.grh-mega__brief-date):not(.grh-mega__brief-event-title) {
    font-size: var(--grh-fs-sm);
    line-height: 1.4;
  }
  .grh-mega__brief-section li a > span {
    font-size: var(--grh-fs-sm);
    line-height: 1.4;
  }

  /* Events: Datum-Block + Titel */
  .grh-mega__brief-events li a {
    grid-template-columns: 44px 1fr;
    align-items: center;
  }
  .grh-mega__brief-date {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
    color: var(--grh-candle-500);
    border-right: 1px solid rgba(250, 247, 241, 0.15);
    padding-right: 8px;
    margin-right: 2px;
  }
  .grh-mega__brief-date strong {
    font-family: var(--grh-font-display);
    font-style: italic;
    font-size: var(--grh-fs-xl);
    font-weight: 400;
    color: var(--grh-candle-300);
    letter-spacing: -0.02em;
  }
  .grh-mega__brief-date em {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--grh-candle-500);
    font-style: normal;
    margin-top: 2px;
  }
  .grh-mega__brief-event-title {
    font-size: var(--grh-fs-sm);
    line-height: 1.35;
  }

  .grh-mega__brief-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: var(--grh-space-2);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--grh-candle-500);
    text-decoration: none;
    font-weight: 600;
  }
  .grh-mega__brief-more:hover { color: var(--grh-candle-300); }

  .grh-mega__brief-foot {
    border-top: 1px solid rgba(250, 247, 241, 0.12);
    padding-top: var(--grh-space-4);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .grh-mega__brief-foot a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--grh-cream-50);
    opacity: 0.78;
    text-decoration: none;
    font-size: 12px;
  }
  .grh-mega__brief-foot a:hover { color: var(--grh-candle-300); opacity: 1; }

  /* === Rechte Spalte (Navigation) =========================== */
  .grh-mega__main {
    background: var(--grh-cream-50);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }

  .grh-mega__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--grh-space-5) var(--grh-space-6);
    border-bottom: 1px solid var(--grh-line);
    position: sticky;
    top: 0;
    background: var(--grh-cream-50);
    z-index: 2;
  }
  .grh-mega__top-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    color: var(--grh-stone-400);
    font-weight: 600;
  }
  .grh-mega__close {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: var(--grh-radius-pill);
    background: transparent;
    border: 1px solid var(--grh-line);
    color: var(--grh-stone-700);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-weight: 600;
    cursor: pointer;
    transition: background var(--grh-dur-fast), color var(--grh-dur-fast), border-color var(--grh-dur-fast);
  }
  .grh-mega__close:hover {
    background: var(--grh-forest-900);
    color: var(--grh-cream-50);
    border-color: var(--grh-forest-900);
  }
  @media (max-width: 480px) {
    .grh-mega__close span { display: none; }
    .grh-mega__close { padding: 8px; }
  }

  /* Kompakte Navigation — Multi-Column-Flow füllt Lücken automatisch */
  .grh-mega__columns {
    flex: 1;
    padding: var(--grh-space-6) var(--grh-space-6) var(--grh-space-5);
    /* min. Spaltenbreite ~18em; Browser ermittelt die optimale Spaltenanzahl */
    columns: 18em;
    column-gap: var(--grh-space-6);
  }

  .grh-mega__col {
    display: block;
    break-inside: avoid;
    page-break-inside: avoid; /* Safari/legacy */
    margin-bottom: var(--grh-space-5);
  }
  .grh-mega__col-head {
    display: block;
    font-family: var(--grh-font-display);
    font-size: var(--grh-fs-md);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--grh-forest-900);
    text-decoration: none;
    padding-bottom: 6px;
    margin-bottom: 6px;
    border-bottom: 1px solid var(--grh-line);
    transition: color var(--grh-dur-fast), border-color var(--grh-dur-fast);
  }
  .grh-mega__col-head:hover {
    color: var(--grh-moss-600);
    border-color: var(--grh-moss-500);
  }

  .grh-mega__sublist {
    display: flex;
    flex-direction: column;
    gap: 0;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .grh-mega__sublink {
    display: inline-block;
    padding: 3px 0;
    color: var(--grh-stone-700);
    font-size: 13px;
    line-height: 1.4;
    text-decoration: none;
    transition: color var(--grh-dur-fast), padding-left var(--grh-dur-fast);
  }
  .grh-mega__sublink:hover {
    color: var(--grh-forest-900);
    padding-left: 6px;
  }

  .grh-mega__sublist3 {
    display: flex;
    flex-direction: column;
    margin: 0 0 4px var(--grh-space-3);
    list-style: none;
    padding: 0;
  }
  .grh-mega__sublist3 a {
    display: inline-block;
    padding: 1px 0;
    font-size: 11px;
    color: var(--grh-stone-400);
    text-decoration: none;
  }
  .grh-mega__sublist3 a:hover { color: var(--grh-forest-900); }

  /* === Rotes Ausrufezeichen für WIP-Seiten ============================= */
  .grh-mega__wip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
    margin-left: 6px;
    border-radius: 50%;
    background: #b02f2f;
    color: #fff;
    font-family: var(--grh-font-body);
    font-size: 10px;
    font-weight: 700;
    line-height: 1;
    font-style: normal;
    vertical-align: 0.05em;
    letter-spacing: 0;
    flex-shrink: 0;
  }
  .grh-mega__col-head .grh-mega__wip { width: 16px; height: 16px; font-size: 11px; }

  /* === Feature-Band: Quote + Card =========================== */
  .grh-mega__feature {
    border-top: 1px solid var(--grh-line);
    padding: var(--grh-space-6);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--grh-space-5);
    align-items: center;
  }
  @media (min-width: 800px) {
