</style>

<script>
  const mega   = document.querySelector<HTMLElement>('[data-grh-megamenu]');
  const opens  = document.querySelectorAll<HTMLElement>('[data-grh-megamenu-toggle]');
  const closes = document.querySelectorAll<HTMLElement>('[data-grh-megamenu-close]');

  let lastFocus: HTMLElement | null = null;

  const open = () => {
    if (!mega) return;
    lastFocus = document.activeElement as HTMLElement;
    mega.removeAttribute('hidden');
    requestAnimationFrame(() => mega.setAttribute('data-open', ''));
    document.body.style.overflow = 'hidden';
    opens.forEach((b) => b.setAttribute('aria-expanded', 'true'));
    const closeBtn = mega.querySelector<HTMLElement>('.grh-mega__close');
    setTimeout(() => closeBtn?.focus(), 100);
  };
  const close = () => {
    if (!mega) return;
    mega.removeAttribute('data-open');
    document.body.style.overflow = '';
    opens.forEach((b) => b.setAttribute('aria-expanded', 'false'));
    setTimeout(() => mega.setAttribute('hidden', ''), 320);
    lastFocus?.focus();
  };

  opens.forEach((btn) => btn.addEventListener('click', open));
  closes.forEach((btn) => btn.addEventListener('click', close));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mega?.hasAttribute('data-open')) close();
  });

  /* === Demo-Schalter: setzt eine Variante + öffnet das Menü ============ */
  document.querySelectorAll<HTMLElement>('[data-grh-mega-demo]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const variant = btn.dataset.grhMegaDemo || 'default';
      if (!mega) return;
      mega.setAttribute('data-grh-mega-variant', variant);
      open();
    });
  });
</script>
