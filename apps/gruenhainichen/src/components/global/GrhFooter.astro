---
import GrhIcon from '../primitives/GrhIcon.astro';
import GrhWappen from './GrhWappen.astro';

const sitemap = {
  Gemeinde: [
    ['Bürgermeister',     '/gemeinde/buergermeister'],
    ['Gemeinderat',       '/gemeinde/gemeinderat'],
    ['Amtsblatt',         '/gemeinde/amtsblatt'],
    ['Geschichte',        '/gemeinde/geschichte'],
    ['Bauleitplanung',    '/gemeinde/bauleitplanung'],
  ],
  'Tourismus & Leben': [
    ['Sehenswürdigkeiten', '/tourismus/sehenswuerdigkeiten'],
    ['Wandern',            '/tourismus/wandern'],
    ['Unterkünfte',        '/tourismus/unterkuenfte'],
    ['Vereine',            '/vereine'],
    ['Gewerbe',            '/gewerbe'],
  ],
};
const year = new Date().getFullYear();
---
<footer class="grh-footer">
  <div class="grh-container grh-footer__inner">
    {/* Linker Block: Wappen + Adresse */}
    <div class="grh-footer__brand">
      <GrhWappen size={96} />

      <address class="grh-footer__addr">
        Gemeindeverwaltung Grünhainichen<br />
        Chemnitzer Straße 41<br />
        09579 Grünhainichen
      </address>

      <div class="grh-footer__contact">
        <a href="tel:+4937294170-0"><GrhIcon name="phone" size={14} /> 037294 / 170-0</a>
        <a href="mailto:gemeinde@gruenhainichen.com"><GrhIcon name="mail" size={14} /> gemeinde@gruenhainichen.com</a>
      </div>
    </div>

    {/* Rechter Block: zwei Sitemap-Spalten */}
    <div class="grh-footer__map">
      {Object.entries(sitemap).map(([heading, items]) => (
        <div class="grh-footer__col">
          <h3>{heading}</h3>
          <ul>
            {items.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
          </ul>
        </div>
      ))}

      <div class="grh-footer__col">
        <h3>Sprechzeiten</h3>
        <p>
          Di 9–12 &amp; 13–18<br />
          Do 9–12 &amp; 13–16<br />
          Fr 9–12
        </p>
        <p class="grh-footer__col-aux">
          Bürgermeister: nach Vereinbarung<br />
          <a class="grh-footer__col-cta" href="/gemeinde/buergermeister">
            Termin vereinbaren <GrhIcon name="arrow-right" size={11} />
          </a>
        </p>
      </div>
    </div>
  </div>

  {/* === DEMO-BLOCK: Mega-Menü-Varianten zum Aussuchen (temporär) ======== */}
  <div class="grh-footer__demos">
    <div class="grh-container">
      <span class="grh-footer__demos-label">Mega-Menü-Demos · zum Vergleichen</span>
      <div class="grh-footer__demos-grid">
        <button class="grh-footer__demo" data-grh-mega-demo="default" type="button">
          <strong>Original</strong>
          <em>Wie aktuell: volle Live-Spalte links, gleichwertig zur Navigation</em>
        </button>
        <button class="grh-footer__demo" data-grh-mega-demo="ticker-bottom" type="button">
          <strong>A · Live-Zeile unten</strong>
          <em>Wie B, aber die Live-Pillen liegen als Streifen <strong>unter</strong> der Navigation statt darüber</em>
        </button>
        <button class="grh-footer__demo" data-grh-mega-demo="ticker" type="button">
          <strong>B · Ticker oben</strong>
          <em>Live-Pille-Streifen quer über die Navigation, kein eigener Block</em>
        </button>
        <button class="grh-footer__demo" data-grh-mega-demo="floating" type="button">
          <strong>C · Floating Card</strong>
          <em>Kleine Live-Karte schwebt unten rechts, Navigation volle Breite</em>
        </button>
      </div>
    </div>
  </div>

  <div class="grh-footer__bottom">
    <div class="grh-container grh-footer__bottom-inner">
      <span>© {year} Gemeinde Grünhainichen · Verwaltungsverband Wildenstein</span>
      <ul>
        <li><a href="/impressum">Impressum</a></li>
        <li><a href="/datenschutz">Datenschutz</a></li>
        <li><a href="/cookie-einstellungen">Cookies</a></li>
        <li><a href="/barrierefreiheit">Barrierefreiheit</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .grh-footer {
    background: var(--grh-forest-900);
    color: var(--grh-cream-50);
  }

  .grh-footer__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--grh-space-8);
    padding-block: var(--grh-space-9) var(--grh-space-7);
  }
  @media (min-width: 900px) {
    .grh-footer__inner { grid-template-columns: 5fr 7fr; gap: var(--grh-space-9); }
  }

  /* === Brand (Wappen + Adresse) ============================ */
  .grh-footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--grh-space-5);
  }
  /* Wappen in Originalfarben — weicher Schein hebt es vom dunklen Untergrund ab */
  .grh-footer__brand :global(.grh-wappen) {
    filter: drop-shadow(0 4px 18px rgba(0, 0, 0, 0.35));
  }
  .grh-footer__addr {
    font-style: normal;
    font-size: var(--grh-fs-sm);
    line-height: 1.7;
    color: var(--grh-cream-50);
    opacity: 0.85;
  }
  .grh-footer__contact {
    margin-top: var(--grh-space-3);
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: var(--grh-fs-sm);
  }
  .grh-footer__contact a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--grh-cream-50);
    opacity: 0.85;
    text-decoration: none;
    transition: color var(--grh-dur-fast), opacity var(--grh-dur-fast);
  }
  .grh-footer__contact a:hover {
    color: var(--grh-candle-300);
    opacity: 1;
  }

  /* === Sitemap-Block ======================================== */
  .grh-footer__map {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--grh-space-6);
  }
  @media (min-width: 600px) {
    .grh-footer__map { grid-template-columns: repeat(3, 1fr); gap: var(--grh-space-7); }
  }

  .grh-footer__col h3 {
    font-family: var(--grh-font-body);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--grh-candle-500);
    font-weight: 600;
    margin-bottom: var(--grh-space-3);
    padding-bottom: var(--grh-space-2);
    border-bottom: 1px solid rgba(250, 247, 241, 0.18);
  }
  .grh-footer__col ul {
    display: flex;
    flex-direction: column;
    gap: 6px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .grh-footer__col a {
    color: var(--grh-cream-50);
    opacity: 0.78;
    font-size: var(--grh-fs-sm);
    text-decoration: none;
    transition: opacity var(--grh-dur-fast), color var(--grh-dur-fast), padding-left var(--grh-dur-fast);
  }
  .grh-footer__col a:hover {
    opacity: 1;
    color: var(--grh-candle-300);
    padding-left: 4px;
  }
  .grh-footer__col p {
    font-size: var(--grh-fs-sm);
    line-height: 1.65;
    color: var(--grh-cream-50);
    opacity: 0.85;
  }
  .grh-footer__col-aux {
    margin-top: var(--grh-space-3);
    padding-top: var(--grh-space-3);
    border-top: 1px solid rgba(250, 247, 241, 0.12);
    font-size: 12px !important;
    opacity: 0.7 !important;
  }
  .grh-footer__col-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
    color: var(--grh-candle-500) !important;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-weight: 600;
    opacity: 1 !important;
    transition: gap var(--grh-dur-base);
  }
  .grh-footer__col-cta:hover { gap: 12px; }

  /* === Bottom-Bar =========================================== */
  .grh-footer__bottom {
    border-top: 1px solid rgba(250, 247, 241, 0.12);
    padding-block: var(--grh-space-4);
    font-size: 11px;
    letter-spacing: 0.04em;
  }
  .grh-footer__bottom-inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--grh-space-4);
    justify-content: space-between;
    align-items: center;
  }
  .grh-footer__bottom span { opacity: 0.55; }
  .grh-footer__bottom ul {
    display: flex;
    gap: var(--grh-space-4);
    list-style: none;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
  }
  .grh-footer__bottom a {
    color: var(--grh-cream-50);
    opacity: 0.7;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 10px;
    transition: opacity var(--grh-dur-fast);
  }
  .grh-footer__bottom a:hover { opacity: 1; }

  /* === Demo-Block (temporär, für Variant-Auswahl) ============== */
  .grh-footer__demos {
    border-top: 1px solid rgba(250, 247, 241, 0.12);
    padding-block: var(--grh-space-6);
  }
  .grh-footer__demos-label {
    display: block;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: var(--grh-candle-500);
    margin-bottom: var(--grh-space-3);
    font-weight: 700;
  }
  .grh-footer__demos-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--grh-space-3);
  }
  @media (min-width: 720px) {
    .grh-footer__demos-grid { grid-template-columns: repeat(4, 1fr); }
  }
  .grh-footer__demo {
    text-align: left;
    background: rgba(250, 247, 241, 0.06);
    border: 1px solid rgba(250, 247, 241, 0.18);
    border-radius: var(--grh-radius-md);
    padding: var(--grh-space-4);
    color: var(--grh-cream-50);
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: background var(--grh-dur-fast), border-color var(--grh-dur-fast), transform var(--grh-dur-fast);
  }
  .grh-footer__demo:hover {
    background: rgba(250, 247, 241, 0.12);
    border-color: var(--grh-candle-500);
    transform: translateY(-2px);
  }
  .grh-footer__demo strong {
    font-family: var(--grh-font-display);
    font-size: var(--grh-fs-md);
    font-weight: 500;
    color: var(--grh-candle-300);
    letter-spacing: -0.01em;
  }
  .grh-footer__demo em {
    font-style: normal;
    font-size: 12px;
    line-height: 1.45;
    color: var(--grh-cream-50);
    opacity: 0.75;
  }
</style>
