---
/**
 * Wappen-Komposit der drei Ortsteile (Grünhainichen · Waldkirchen · Borstendorf).
 * Quelle: bestehendes Bild der Gemeinde Grünhainichen (152.png).
 *
 * variant="color"      → Farb-Original
 * variant="mono-light" → invertiert hellgefiltert für dunkle Hintergründe (Footer)
 * variant="mono-dark"  → für sehr helle Hintergründe
 */
interface Props {
  size?: number;
  class?: string;
  variant?: 'color' | 'mono-light' | 'mono-dark';
  /** Sofort und synchron laden: für das Wappen in der Kopfzeile. Mit
      verzögertem, asynchronem Laden blitzte es in Edge bei jedem Umbau
      der Kopfzeile (z. B. beim Schließen der Suche) kurz weg. */
  eager?: boolean;
  /** Als Hintergrundbild statt <img>: Edge bearbeitet <img>-Elemente mit
      seiner „Bildverbesserung“ nach und zeichnet sie bei jedem Neuaufbau
      der Zeile kurz roh, was in der Kopfzeile als Blitzen sichtbar war.
      Hintergrundbilder lässt es in Ruhe. */
  asBackground?: boolean;
}
const { size = 56, class: extra = '', variant = 'color', eager = false, asBackground = false } = Astro.props;
const alt = 'Wappen der Gemeinde Grünhainichen, zusammengesetzt aus den Wappen der drei Ortsteile';
---
{asBackground ? (
  <span
    role="img"
    aria-label={alt}
    class={`grh-wappen grh-wappen--bg grh-wappen--${variant} ${extra}`}
    style={`width:${size}px;height:${size}px;`}
  ></span>
) : (
  <img
    src="/images/logos/wappen-grh.png"
    alt={alt}
    width={size}
    height={size}
    loading={eager ? 'eager' : 'lazy'}
    decoding={eager ? 'sync' : 'async'}
    fetchpriority={eager ? 'high' : undefined}
    class={`grh-wappen grh-wappen--${variant} ${extra}`}
    style={`width:${size}px;height:auto;`}
  />
)}

<style>
  .grh-wappen {
    display: inline-block;
    flex-shrink: 0;
    object-fit: contain;
  }
  .grh-wappen--bg {
    background: url('/images/logos/wappen-grh.png') center / contain no-repeat;
  }
  .grh-wappen--mono-light {
    filter: brightness(0) invert(1) opacity(0.92);
  }
  .grh-wappen--mono-dark {
    filter: brightness(0) opacity(0.85);
  }
</style>
