---
/**
 * Karte der Teilnehmer eines Termins (z. B. Tag des traditionellen Handwerks).
 * Punkte und Nummern kommen aus buildTeilnehmerProgramm() (lib/teilnehmer.ts),
 * ebenso die weiteren Punkte: Parkplätze, Shuttle-Haltestellen, Essen und WC.
 * Gibt es solche Punkte, lassen sie sich über der Karte ein- und ausblenden.
 *
 * Datenschutz: Die Kartenbilder liegen bei OpenStreetMap. Deshalb lädt die Karte
 * erst nach einem Klick (Zwei-Klick-Lösung). Die Zustimmung gilt für diesen
 * Besuch, danach öffnen sich weitere Karten sofort.
 */
import 'leaflet/dist/leaflet.css';
import type { TeilnehmerMarker } from '../../lib/teilnehmer';
import { zeichenHtml, type KartenPunkt } from '../../lib/kartenzeichen';

interface Props {
  markers: TeilnehmerMarker[];
  punkte?: KartenPunkt[];
  titel?: string;
}
const { markers, punkte = [], titel = 'Karte der Teilnehmer' } = Astro.props;
const hat = (...arten: KartenPunkt['art'][]) => punkte.some((p) => arten.includes(p.art));
const zeichen = (art: KartenPunkt['art'], text = '', shuttle = false) => zeichenHtml({ art, zeichen: text, shuttle });
---
{markers.length > 0 && (
  <figure id="karte" class="grh-tk" data-grh-teilnehmerkarte data-markers={JSON.stringify(markers)} data-punkte={JSON.stringify(punkte)}>
    {punkte.length > 0 && (
      <div class="grh-tk__filter" role="group" aria-label="Auf der Karte zeigen">
        <button type="button" class="grh-tk__chip" data-grh-tk-ebene="teilnehmer" aria-pressed="true">
          <span class="grh-tk__chip-nr" aria-hidden="true">1</span> Teilnehmer
        </button>
        {hat('parken', 'haltestelle') && (
          <button type="button" class="grh-tk__chip" data-grh-tk-ebene="parken" aria-pressed="true">
            <Fragment set:html={zeichen('parken', 'P')} /> Parken und Shuttle
          </button>
        )}
        {hat('essen', 'wc') && (
          <button type="button" class="grh-tk__chip" data-grh-tk-ebene="essen" aria-pressed="true">
            <Fragment set:html={zeichen('essen')} /> Essen und WC
          </button>
        )}
      </div>
    )}
    <div class="grh-tk__map" data-grh-tk-map>
      <div class="grh-tk__gate" data-grh-tk-gate>
        <p class="grh-tk__gate-title">{titel}</p>
        <p class="grh-tk__gate-text">
          Die Kartenbilder kommen von OpenStreetMap. Beim Laden erhält die
          OpenStreetMap Foundation Ihre IP-Adresse.
        </p>
        <button type="button" class="grh-tk__gate-btn" data-grh-tk-load>Karte laden</button>
      </div>
    </div>
    <figcaption class="grh-tk__caption">
      Die Nummern auf der Karte gehören zu den Nummern in der Liste. Gelbe Sammelpunkte
      fassen nahe Standorte zusammen: anklicken zum Vergrößern.
      {punkte.length > 0 && (
        <span class="grh-tk__legende">
          {hat('parken') && <span><Fragment set:html={zeichen('parken', 'P')} /> Parkplatz</span>}
          {punkte.some((p) => p.shuttle) && <span><Fragment set:html={zeichen('parken', 'P', true)} /> Parkplatz mit Shuttle-Haltestelle</span>}
          {hat('haltestelle') && <span><Fragment set:html={zeichen('haltestelle', 'H')} /> Shuttle-Haltestelle</span>}
          {hat('essen') && <span><Fragment set:html={zeichen('essen')} /> Essen und Trinken</span>}
          {hat('wc') && <span><Fragment set:html={zeichen('wc', 'WC')} /> WC</span>}
          <span>Wo es eng wird, erscheinen diese Zeichen erst beim Vergrößern.</span>
        </span>
      )}
      Karte © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap-Mitwirkende</a>
    </figcaption>
  </figure>
)}

<style>
  .grh-tk {
    margin: var(--grh-space-5) 0;
    scroll-margin-top: 110px; /* feste Kopfzeile */
  }
  .grh-tk__map {
    position: relative;
    height: clamp(320px, 58vh, 520px);
    border-radius: var(--grh-radius-md, 6px);
    overflow: hidden;
    background:
      radial-gradient(circle at 30% 40%, rgba(26, 61, 39, 0.10), transparent 55%),
      var(--grh-paper-100);
    border: 1px solid rgba(26, 61, 39, 0.12);
  }
  .grh-tk__gate {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: var(--grh-space-3);
    padding: var(--grh-space-5);
    text-align: center;
  }
  .grh-tk__gate-title {
    font-family: var(--grh-font-display);
    font-size: var(--grh-fs-xl);
    color: var(--grh-forest-900);
    margin: 0;
  }
  .grh-tk__gate-text {
    max-width: 38ch;
    font-size: var(--grh-fs-sm);
    color: var(--grh-stone-700);
    margin: 0;
  }
  .grh-tk__gate-btn {
    appearance: none;
    border: 0;
    border-radius: 999px;
    padding: 12px 22px;
    background: var(--grh-forest-900);
    color: var(--grh-paper-50, #fff);
    font: 600 var(--grh-fs-sm) / 1 var(--grh-font-body);
    cursor: pointer;
    transition: background var(--grh-dur-fast);
  }
  .grh-tk__gate-btn:hover,
  .grh-tk__gate-btn:focus-visible { background: var(--grh-forest-800); }
  .grh-tk__caption {
    margin-top: var(--grh-space-2);
    font-size: 12px;
    color: var(--grh-stone-400);
  }
  .grh-tk__caption a { color: inherit; }
  .grh-tk__legende {
    display: flex; flex-wrap: wrap; align-items: center; gap: 6px 16px;
    margin: 8px 0;
  }
  .grh-tk__legende > span { display: inline-flex; align-items: center; gap: 6px; }
  .grh-tk__legende :global(.grh-kz) { transform: scale(0.85); transform-origin: left center; margin-right: -3px; }

  .grh-tk__filter {
    display: flex; flex-wrap: wrap; gap: 8px;
    margin-bottom: var(--grh-space-3);
  }
  .grh-tk__chip {
    appearance: none;
    display: inline-flex; align-items: center; gap: 8px;
    padding: 6px 14px 6px 8px;
    border: 1px solid rgba(26, 61, 39, 0.25);
    border-radius: 999px;
    background: #fff;
    color: var(--grh-forest-900);
    font: 600 var(--grh-fs-sm) / 1 var(--grh-font-body);
    cursor: pointer;
    transition: background var(--grh-dur-fast), opacity var(--grh-dur-fast);
  }
  .grh-tk__chip:hover,
  .grh-tk__chip:focus-visible { background: var(--grh-paper-100); }
  .grh-tk__chip[aria-pressed="false"] { opacity: 0.55; text-decoration: line-through; }
  .grh-tk__chip[aria-pressed="false"] :global(.grh-kz),
  .grh-tk__chip[aria-pressed="false"] .grh-tk__chip-nr { filter: grayscale(1); }
  .grh-tk__chip-nr {
    display: grid; place-items: center;
    width: 24px; height: 24px;
    border-radius: 50%;
    background: var(--grh-forest-900);
    border: 2px solid var(--grh-candle-500);
    box-sizing: border-box;
    color: #fff;
    font: 700 12px / 1 var(--grh-font-body);
  }
  .grh-tk__caption :global(.grh-tk__alle) {
    display: block;
    margin: 0 0 6px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--grh-forest-900);
    font: 600 var(--grh-fs-sm) / 1.4 var(--grh-font-body);
    text-decoration: underline;
    text-decoration-color: var(--grh-candle-500);
    text-underline-offset: 3px;
    cursor: pointer;
  }

  :global(.grh-tk-pin) {
    display: flex; align-items: center; justify-content: center;
    width: max-content; /* das Leaflet-Symbol selbst ist 0 px breit */
    min-width: 26px; height: 26px; padding: 0 7px;
    border-radius: 999px;
    background: var(--grh-forest-900);
    color: #fff;
    border: 2px solid var(--grh-candle-500);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);
    font: 700 12px / 1 var(--grh-font-body);
    white-space: nowrap;
    transform: translate(-50%, -50%);
  }
  :global(.grh-tk-pin--gruppe) {
    height: 30px;
    padding: 0 11px;
    background: var(--grh-candle-500);
    color: var(--grh-forest-950);
    border-color: var(--grh-forest-900);
    font-size: 13px;
    cursor: zoom-in;
  }
  /* Zeichen für Parkplatz, Haltestelle, Essen und WC auf der Karte */
  :global(.grh-tk-sym) {
    display: block;
    width: max-content; /* das Leaflet-Symbol selbst ist 0 px breit */
    transform: translate(-50%, -50%);
  }
  :global(.grh-tk-sym .grh-kz) { box-shadow: 0 0 0 2px #fff, 0 3px 8px rgba(0, 0, 0, 0.3); }
  :global(.grh-tk .leaflet-popup-content) {
    font-family: var(--grh-font-body);
    font-size: 14px;
    line-height: 1.45;
    margin: 12px 14px;
  }
  :global(.grh-tk .leaflet-popup-content strong) { display: block; color: var(--grh-forest-900); }
  :global(.grh-tk .leaflet-popup-content span) { color: var(--grh-stone-400); font-size: 13px; }
</style>

<script>
  import L from 'leaflet';
  import { PUNKT_ARTEN, zeichenHtml, type KartenPunkt } from '../../lib/kartenzeichen';

  interface Marker { lat: number; lon: number; zeichen: string[]; namen: string[]; adresse: string }

  /** Zu welchem Schalter über der Karte eine Punktart gehört. */
  const EBENE: Record<KartenPunkt['art'], string> = { parken: 'parken', haltestelle: 'parken', essen: 'essen', wc: 'essen' };
  const ART_TEXT: Record<KartenPunkt['art'], string> = {
    parken: 'Parkplatz', haltestelle: 'Shuttle-Haltestelle', essen: 'Essen und Trinken', wc: 'WC',
  };

  const KEY = 'grh-osm-karte';
  const erlaubt = () => { try { return sessionStorage.getItem(KEY) === '1'; } catch { return false; } };
  const merken = () => { try { sessionStorage.setItem(KEY, '1'); } catch { /* privater Modus */ } };

  /** ['1','2','3','4','6','8','9','10','A'] → „1 bis 4, 6, 8 bis 10, A“ */
  function bereiche(zeichen: string[]): string {
    const n = zeichen.filter((z) => /^\d+$/.test(z)).map(Number).sort((a, b) => a - b);
    const teile: string[] = [];
    for (let i = 0; i < n.length; ) {
      let j = i;
      while (j + 1 < n.length && n[j + 1] === n[j] + 1) j++;
      teile.push(j - i >= 2 ? `${n[i]} bis ${n[j]}` : n.slice(i, j + 1).join(', '));
      i = j + 1;
    }
    return teile.concat(zeichen.filter((z) => !/^\d+$/.test(z)).sort()).join(', ');
  }

  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

  function zeichne(fig: HTMLElement) {
    if (fig.dataset.geladen) return;
    fig.dataset.geladen = '1';
    const el = fig.querySelector<HTMLElement>('[data-grh-tk-map]')!;
    el.querySelector('[data-grh-tk-gate]')?.remove();
    const markers: Marker[] = JSON.parse(fig.dataset.markers || '[]');
    const punkte: KartenPunkt[] = JSON.parse(fig.dataset.punkte || '[]');
    // Reihenfolge = Vorrang, wenn sich Zeichen in der Übersicht den Platz streitig machen.
    punkte.sort((a, b) => PUNKT_ARTEN.indexOf(a.art) - PUNKT_ARTEN.indexOf(b.art));
    const aktiv = (ebene: string) =>
      fig.querySelector(`[data-grh-tk-ebene="${ebene}"]`)?.getAttribute('aria-pressed') !== 'false';
    const sichtbarePunkte = () => punkte.filter((p) => aktiv(EBENE[p.art]));

    const map = L.map(el, { scrollWheelZoom: false, attributionControl: false, zoomSnap: 0.25 });
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(map);
    // Alles, was gerade eingeschaltet ist. Ist nichts eingeschaltet, bleiben es die Teilnehmer.
    const grenzen = () => {
      const orte = [...(aktiv('teilnehmer') ? markers : []), ...sichtbarePunkte()];
      return L.latLngBounds((orte.length ? orte : markers).map((m) => [m.lat, m.lon] as [number, number]));
    };
    // Beim Laden ohne Animation: Eine Zoom-Animation, die im Hintergrund-Tab anläuft,
    // bleibt sonst auf der Startstufe hängen.
    const alleZeigen = (animate = true) => map.fitBounds(grenzen(), { padding: [34, 34], maxZoom: 17, animate });

    // Die Karte zeigt immer alle Standorte. Punkte, deren Beschriftungen sich bei der
    // aktuellen Zoomstufe überdecken würden (die Chemnitzer Straße in der
    // Gesamtansicht), werden zu einem Sammelpunkt „1 bis 10“; ein Klick zoomt hinein.
    const ebene = L.layerGroup().addTo(map);
    interface Gruppe { px: L.Point; ms: Marker[]; anzahl: number; label: string }
    const gruppe = (ms: Marker[]): Gruppe => {
      const zeichen = ms.flatMap((m) => m.zeichen);
      const pts = ms.map((m) => map.latLngToLayerPoint([m.lat, m.lon]));
      const px = pts.reduce((sum, p) => sum.add(p), L.point(0, 0)).divideBy(pts.length);
      return { px, ms, anzahl: zeichen.length, label: ms.length === 1 ? ms[0].zeichen.join(' · ') : bereiche(zeichen) };
    };
    const breite = (g: Gruppe) => 24 + g.label.length * 7.5;
    const decken = (a: Gruppe, b: Gruppe) =>
      Math.abs(a.px.x - b.px.x) < (breite(a) + breite(b)) / 2 + 4 && Math.abs(a.px.y - b.px.y) < 34;
    const zeichnePunkte = () => {
      ebene.clearLayers();
      let gruppen = (aktiv('teilnehmer') ? markers : []).map((m) => gruppe([m]));
      for (let neu = true; neu; ) {
        neu = false;
        suche: for (let i = 0; i < gruppen.length; i++) {
          for (let j = i + 1; j < gruppen.length; j++) {
            if (decken(gruppen[i], gruppen[j])) {
              const zusammen = gruppe([...gruppen[i].ms, ...gruppen[j].ms]);
              gruppen = gruppen.filter((_, k) => k !== i && k !== j).concat(zusammen);
              neu = true;
              break suche;
            }
          }
        }
      }
      for (const g of gruppen) {
        const namen = g.ms.flatMap((m) => m.namen.map((n, i) => `<strong>${esc(m.zeichen[i])}. ${esc(n)}</strong>`));
        if (g.ms.length === 1) {
          const m = g.ms[0];
          const icon = L.divIcon({ className: '', html: `<span class="grh-tk-pin">${esc(g.label)}</span>`, iconSize: [0, 0] });
          L.marker([m.lat, m.lon], { icon, title: m.namen.join(', ') })
            .bindPopup(`${namen.join('')}<span>${esc(m.adresse)}</span>`)
            .addTo(ebene);
          continue;
        }
        const icon = L.divIcon({
          className: '',
          html: `<span class="grh-tk-pin grh-tk-pin--gruppe">${esc(g.label)}</span>`,
          iconSize: [0, 0],
        });
        const gb = L.latLngBounds(g.ms.map((m) => [m.lat, m.lon] as [number, number]));
        const punkt = L.marker(map.layerPointToLatLng(g.px), { icon, title: `${g.anzahl} Standorte, zum Vergrößern klicken` })
          .addTo(ebene);
        punkt.on('click', () => {
          // Liegen die Punkte selbst in der größten Zoomstufe noch zu dicht, zeigt
          // der Sammelpunkt die Namen statt weiter zu zoomen.
          if (map.getBoundsZoom(gb, false, L.point(80, 80)) <= map.getZoom() + 0.25) {
            punkt.bindPopup(namen.join('')).openPopup();
          } else {
            map.fitBounds(gb, { padding: [60, 60] });
          }
        });
      }

      // Parkplätze, Haltestellen, Essen und WC: kleine Zeichen ohne Sammelpunkte. Ein
      // Zeichen entfällt, solange es einen Teilnehmer oder ein anderes Zeichen
      // überdecken würde. Beim Vergrößern rücken die Orte auseinander und es erscheint.
      const belegt = gruppen.map((g) => ({ x: g.px.x, y: g.px.y, b: breite(g), h: 30 }));
      for (const p of sichtbarePunkte()) {
        const px = map.latLngToLayerPoint([p.lat, p.lon]);
        const b = 28 + Math.max(0, p.zeichen.length - 1) * 7 + (p.shuttle ? 19 : 0);
        if (belegt.some((f) => Math.abs(f.x - px.x) < (f.b + b) / 2 + 2 && Math.abs(f.y - px.y) < (f.h + 28) / 2 + 2)) continue;
        belegt.push({ x: px.x, y: px.y, b, h: 28 });
        const name = p.art === 'parken' && p.zeichen.length > 1 ? `${p.zeichen} ${p.name}` : p.name;
        const icon = L.divIcon({ className: '', html: `<span class="grh-tk-sym">${zeichenHtml(p)}</span>`, iconSize: [0, 0] });
        L.marker([p.lat, p.lon], { icon, title: name, zIndexOffset: -500 })
          .bindPopup(`<strong>${esc(name)}</strong><span>${esc([ART_TEXT[p.art], p.zusatz].filter(Boolean).join(' · '))}</span>`)
          .addTo(ebene);
      }
    };
    map.on('zoomend', zeichnePunkte);
    fig.addEventListener('grh-tk-filter', zeichnePunkte);

    const knopf = document.createElement('button');
    knopf.type = 'button';
    knopf.className = 'grh-tk__alle';
    knopf.textContent = 'Alle Standorte zeigen';
    knopf.addEventListener('click', () => alleZeigen());
    fig.querySelector('.grh-tk__caption')?.prepend(knopf);

    // Eine versteckt geladene Karte hat noch keine Größe: dann erst einpassen,
    // sobald sie sichtbar wird.
    let eingepasst = el.clientWidth > 0;
    map.setView(grenzen().getCenter(), 14);
    if (eingepasst) alleZeigen(false);
    zeichnePunkte();
    new ResizeObserver(() => {
      map.invalidateSize();
      if (!eingepasst && el.clientWidth > 0) { eingepasst = true; alleZeigen(false); }
    }).observe(el);
    fig.dispatchEvent(new CustomEvent('grh-tk-geladen', { bubbles: true }));
  }

  function ladeAlle() {
    merken();
    document.querySelectorAll<HTMLElement>('[data-grh-teilnehmerkarte]').forEach(zeichne);
  }

  document.querySelectorAll<HTMLElement>('[data-grh-teilnehmerkarte]').forEach((fig) => {
    fig.querySelector('[data-grh-tk-load]')?.addEventListener('click', ladeAlle);
    // Schalter über der Karte: gelten auch schon, bevor die Karte geladen ist.
    fig.querySelectorAll<HTMLElement>('[data-grh-tk-ebene]').forEach((knopf) => {
      knopf.addEventListener('click', () => {
        knopf.setAttribute('aria-pressed', knopf.getAttribute('aria-pressed') === 'false' ? 'true' : 'false');
        fig.dispatchEvent(new CustomEvent('grh-tk-filter'));
      });
    });
  });
  if (erlaubt()) ladeAlle();
</script>
